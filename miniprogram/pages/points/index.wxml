<wxs module="i18n" src="../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} points-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="page-header"><view class="eyebrow">{{i18n.f('邀请好友，一起训练', [], language)}}</view><view class="page-title">{{i18n.f('我的积分', [], language)}}</view></view>
  <view wx:if="{{!pageBusy && !runtime.isAuthenticated}}" class="card">
    <view class="section-title">{{i18n.f('登录后查看积分', [], language)}}</view>
    <button size="mini" class="primary-button points-button" bindtap="goLogin">{{i18n.f('去登录', [], language)}}</button>
  </view>
  <block wx:if="{{runtime.isAuthenticated && pageData}}">
    <view class="points-balance"><view class="points-kicker">{{i18n.f('当前积分', [], language)}}</view><view class="points-number">{{pageData.balance}}<text>{{i18n.f('分', [], language)}}</text></view><view class="points-note">{{i18n.f('每次成功邀请，双方各得100积分', [], language)}}</view></view>
    <view class="card">
      <view class="section-title">{{i18n.f('我的邀请码', [], language)}}</view><view class="card-desc">{{i18n.f('分享给好友，让好友在“我的”页面填写。', [], language)}}</view>
      <view class="points-code" selectable="true">{{pageData.inviteCode}}</view>
      <button size="mini" class="primary-button points-button" bindtap="onCopyInviteCode">{{i18n.f('复制邀请码', [], language)}}</button>
      <view class="points-rule">{{i18n.f('每人仅可绑定一次，不能填写自己的邀请码，绑定后不可更换。积分不抵扣训练课时。', [], language)}}</view>
    </view>
    <view class="card"><view class="headline-row"><view class="section-title">{{i18n.f('积分明细', [], language)}}</view><view class="card-desc">{{i18n.f('最近50条', [], language)}}</view></view>
      <view wx:if="{{!pageData.records.length}}" class="points-empty"><view>{{i18n.f('还没有积分记录', [], language)}}</view><view>{{i18n.f('邀请好友，获得第一笔积分', [], language)}}</view></view>
      <view wx:for="{{pageData.records}}" wx:key="id" class="points-record"><view><view class="points-record-title">{{i18n.t(item.title, language)}}</view><view class="card-desc">{{i18n.t(item.dateLabel, language)}}</view></view><view class="points-amount">+{{item.amount}}</view></view>
    </view>
  </block>
</view>
