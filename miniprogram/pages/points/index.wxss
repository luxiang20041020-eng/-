.points-page { padding-bottom: 48rpx; }
.points-balance { padding: 40rpx; margin-bottom: 24rpx; border-radius: 24rpx; background: #252d24; color: #fff; }
.points-kicker { font-size: 26rpx; opacity: .75; }
.points-number { font-size: 88rpx; font-weight: 700; line-height: 1.4; }
.points-number text { font-size: 26rpx; font-weight: 400; margin-left: 14rpx; }
.points-note { font-size: 24rpx; color: #d3d9cb; }
.points-code { margin: 30rpx 0; padding: 24rpx 12rpx; background: #f3f4ed; border-radius: 16rpx; text-align: center; font-size: 36rpx; font-weight: 600; letter-spacing: 3rpx; overflow-wrap: anywhere; }
.points-page button.points-button { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 100%; margin: 20rpx 0 0; box-sizing: border-box; padding: 20rpx; font-size: 28rpx; line-height: 1.4; }
.points-rule { margin-top: 24rpx; font-size: 23rpx; color: #818678; line-height: 1.7; }
.points-empty { padding: 40rpx 0; text-align: center; color: #818678; font-size: 26rpx; line-height: 1.8; }
.points-record { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 0; border-top: 1rpx solid #eeeee6; }
.points-record-title { font-size: 28rpx; margin-bottom: 8rpx; }
.points-amount { color: #c7452d; font-size: 34rpx; font-weight: 600; margin-left: 20rpx; }

.points-page { background: linear-gradient(155deg,#efede4,#f5f4ef 600rpx); }
.points-balance { position: relative; overflow: hidden; border: 1rpx solid #45523f; border-radius: 28rpx; box-shadow: 0 16rpx 36rpx rgba(24,35,27,.12); }
.points-balance-photo,.points-balance-shade { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.points-balance-shade { background: linear-gradient(100deg,rgba(20,30,23,.97),rgba(20,30,23,.91) 50%,rgba(20,30,23,.66)); }
.points-kicker,.points-number,.points-note { position: relative; z-index: 1; overflow-wrap: anywhere; }
.points-kicker { opacity: 1; color: #d6c5a1; }
.points-number { color: #f5ddb0; }
.points-note { color: #e3e8da; line-height: 1.6; }
.points-code { border: 1rpx dashed #cbb991; background: linear-gradient(135deg,#fbf4e8,#f5f6ef); color: #33452e; }
.points-page .card { border-radius: 24rpx; }
