.records-page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.record-filters { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx; }
.locale-page button.record-filter { width: auto; max-width: 100%; min-height: 64rpx; height: auto; margin: 0; padding: 14rpx 22rpx; border: 1rpx solid #dde2d5; border-radius: 32rpx; font-size: 24rpx; line-height: 1.5; background: #fff; color: #6b7562; }
.locale-page button.record-filter.active { background: #29362d; border-color: #29362d; color: #fff; }
.record-card { border-radius: 24rpx; }
.record-date { font-size: 24rpx; color: #718064; }
.record-title { margin: 22rpx 0 10rpx; font-size: 32rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.record-reason { margin-top: 14rpx; font-size: 24rpx; line-height: 1.7; color: #747c6d; overflow-wrap: anywhere; }
.locale-page button.record-cancel,.locale-page button.record-more { width: 100%; margin: 24rpx 0 0; height: auto; min-height: 72rpx; padding: 16rpx; line-height: 1.5; white-space: normal; }
.record-end,.record-error { padding: 24rpx; text-align: center; color: #828978; font-size: 24rpx; line-height: 1.7; }
.record-error { color: #b3442a; }
