<wxs module="i18n" src="../../../utils/i18n.wxs" />
<media-privacy id="mediaPrivacy" language="{{language}}"></media-privacy>
<view class="page-shell locale-page locale-{{language}} coach-edit-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="edit-page-heading"><view class="edit-page-title">{{i18n.f('我的教练资料', [], language)}}</view><view class="edit-page-subtitle">{{i18n.f('让客户了解你', [], language)}}</view></view>
  <view wx:if="{{!canEdit && !pageBusy}}" class="card card-desc">{{i18n.f('只有教练或管理员可以编辑教练介绍', [], language)}}</view>
  <block wx:if="{{ready && canEdit}}">
    <view class="edit-identity"><image class="edit-identity-photo" src="/images/backgrounds/training-private.jpg" mode="aspectFill" aria-hidden="true"></image><view class="edit-identity-shade"></view><image wx:if="{{coach.avatarUrl}}" class="edit-avatar" src="{{coach.avatarUrl}}" mode="aspectFill"></image><view wx:else class="edit-avatar avatar-fallback">{{avatarText}}</view><view class="edit-identity-main"><view class="edit-coach-name">{{coach.name}}</view><button class="edit-avatar-action" disabled="{{uploading || saving}}" bindtap="onUploadAvatar">{{i18n.f('上传头像', [], language)}} <text>↗</text></button><view class="edit-avatar-hint">{{i18n.f('头像上传后立即生效', [], language)}}</view></view></view>
    <view class="edit-tabs">
      <button class="edit-tab {{editSection === 'basic' ? 'active' : ''}}" data-section="basic" bindtap="onEditSection">{{i18n.t('基本资料', language)}}</button>
      <button class="edit-tab {{editSection === 'intro' ? 'active' : ''}}" data-section="intro" bindtap="onEditSection">{{i18n.t('介绍与荣誉', language)}}</button>
      <button class="edit-tab {{editSection === 'photos' ? 'active' : ''}}" data-section="photos" bindtap="onEditSection">{{i18n.t('照片与证书', language)}}</button>
    </view>
    <view class="edit-panel" wx:if="{{editSection === 'basic'}}">
      <view class="edit-field"><view class="edit-field-label">{{i18n.f('教练头衔', [], language)}}</view><view class="edit-input-shell"><input class="edit-input" value="{{draft.title}}" maxlength="60" data-field="title" bindinput="onInput" disabled="{{saving || uploading}}" placeholder-class="edit-placeholder" cursor-spacing="24" placeholder="{{i18n.f('例如：泰拳教练', [], language)}}" /></view></view>
      <view class="edit-field"><view class="edit-field-label">{{i18n.f('资历与等级', [], language)}}</view><view class="edit-input-shell"><input class="edit-input" value="{{draft.levelLabel}}" maxlength="60" data-field="levelLabel" bindinput="onInput" disabled="{{saving || uploading}}" placeholder-class="edit-placeholder" cursor-spacing="24" placeholder="{{i18n.f('填写执教资历或训练等级', [], language)}}" /></view></view>
      <view class="edit-field"><view class="edit-field-label">{{i18n.f('擅长领域', [], language)}}</view><view class="edit-textarea-shell"><textarea class="edit-textarea edit-short" value="{{draft.specialties}}" maxlength="500" data-field="specialties" bindinput="onInput" disabled="{{saving || uploading}}" placeholder-class="edit-placeholder" cursor-spacing="24" placeholder="{{i18n.f('每行一项，最多10项', [], language)}}" /></view><view class="edit-field-hint">{{i18n.f('每行一项，最多10项', [], language)}}</view></view>
    </view>
    <view class="edit-panel" wx:if="{{editSection === 'intro'}}">
      <view class="edit-field"><view class="edit-label-row"><view class="edit-field-label">{{i18n.f('个人介绍', [], language)}}</view><text class="edit-counter">{{draft.bio.length}} / 2000</text></view><view class="edit-textarea-shell"><textarea class="edit-textarea edit-bio" value="{{draft.bio}}" maxlength="2000" data-field="bio" bindinput="onInput" disabled="{{saving || uploading}}" placeholder-class="edit-placeholder" cursor-spacing="24" placeholder="{{i18n.f('介绍训练经历、教学风格和适合的学员', [], language)}}" /></view></view>
      <view class="edit-field"><view class="edit-field-label">{{i18n.f('荣誉与资质', [], language)}}</view><view class="edit-textarea-shell"><textarea class="edit-textarea edit-honors" value="{{draft.honors}}" maxlength="2100" data-field="honors" bindinput="onInput" disabled="{{saving || uploading}}" placeholder-class="edit-placeholder" cursor-spacing="24" placeholder="{{i18n.f('每行一项，填写比赛荣誉或教练认证', [], language)}}" /></view><view class="edit-field-hint">{{i18n.f('最多10项荣誉，每项不超过200个字符', [], language)}}</view></view>
    </view>
    <view class="edit-panel edit-photos-panel" wx:if="{{editSection === 'photos'}}"><view class="edit-label-row"><view class="edit-field-label">{{i18n.f('照片与证书', [], language)}}</view><text class="edit-counter">{{draft.photos.length}} / 6</text></view><view class="edit-field-hint">{{i18n.f('最多6张，可上传训练照片、比赛照片或证书。', [], language)}}</view><view class="edit-gallery"><view wx:for="{{draft.photos}}" wx:key="*this" class="edit-photo"><image src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="onPreviewPhoto"></image><button class="edit-photo-remove" aria-label="{{i18n.t('移除照片', language)}}" data-url="{{item}}" disabled="{{saving || uploading}}" bindtap="onRemovePhoto">×</button></view><button wx:if="{{draft.photos.length < 6}}" class="edit-add" bindtap="onAddPhotos" disabled="{{saving || uploading}}"><view class="edit-add-icon">＋</view><text>{{i18n.f('添加照片', [], language)}}</text></button></view></view>
    <view wx:if="{{uploading}}" class="card-desc edit-status">{{i18n.f('正在处理照片，请稍候…', [], language)}}</view><view wx:if="{{formError}}" class="edit-error">{{i18n.t(formError, language)}}</view>
    <view class="edit-footer"><view class="edit-save-hint">{{i18n.f('照片与文字需点击保存后公开展示', [], language)}}</view><button class="primary-button edit-save" loading="{{saving}}" disabled="{{saving || uploading || pageBusy || pageError}}" bindtap="onSave">{{i18n.t(saving ? '保存中...' : '保存教练资料', language)}}</button></view>
  </block>
</view>
