.coach-edit-page{padding:32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom))}
.edit-page-heading{padding:0 4rpx 28rpx}.edit-page-title{font-size:38rpx;font-weight:700;line-height:1.35;overflow-wrap:anywhere}.edit-page-subtitle{margin-top:8rpx;font-size:23rpx;color:#92968b;line-height:1.5}
.edit-identity{display:flex;align-items:center;gap:26rpx;background:#29362d;border-radius:26rpx;padding:30rpx;color:#fff}.edit-avatar{width:116rpx;height:132rpx;border-radius:20rpx;flex-shrink:0;background:#465448}.avatar-fallback{display:flex;align-items:center;justify-content:center;color:#e5eadc;font-size:44rpx}.edit-identity-main{flex:1;min-width:0}.edit-coach-name{font-size:36rpx;font-weight:600;line-height:1.35;overflow-wrap:anywhere}.locale-page button.edit-avatar-action{width:auto;max-width:100%;height:auto;min-height:48rpx;margin:12rpx 0 0;padding:8rpx 14rpx;display:inline-flex;align-items:center;justify-content:center;gap:10rpx;line-height:1.5;white-space:normal;font-size:22rpx;color:#e5eadc;background:rgba(255,255,255,.1);border-radius:10rpx;text-align:center}.edit-avatar-hint{margin-top:12rpx;font-size:20rpx;line-height:1.5;color:#b5bfb0}
.edit-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin:30rpx 0 20rpx;padding:6rpx;border-radius:18rpx;background:#eaece4}.locale-page button.edit-tab{width:100%;margin:0;height:auto;min-height:78rpx;display:flex;align-items:center;justify-content:center;padding:14rpx 8rpx;font-size:24rpx;line-height:1.4;white-space:normal;text-align:center;color:#848a7c;border-radius:13rpx;overflow-wrap:anywhere}.locale-page button.edit-tab.active{background:#fff;color:#29362d;font-weight:600;box-shadow:0 3rpx 10rpx rgba(32,37,31,.06)}
.edit-panel{padding:30rpx;border-radius:24rpx;background:#fff;border:1rpx solid #e7e8df}.edit-field+.edit-field{margin-top:32rpx}.edit-field-label{font-size:25rpx;font-weight:600;color:#444e40;line-height:1.5;margin-bottom:14rpx;overflow-wrap:anywhere}.edit-label-row{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx}.edit-counter{flex-shrink:0;font-size:20rpx;color:#858c7e}.edit-field-hint{font-size:21rpx;color:#858c7e;line-height:1.6;margin-top:12rpx;overflow-wrap:anywhere}
/* 原生 input/textarea 不承担边框和内边距，避免 iOS 的文字基线偏移。 */
.edit-input-shell,.edit-textarea-shell{width:100%;background:#f8f9f5;border:1rpx solid #e9ece2;border-radius:14rpx;padding:20rpx}
.edit-input-shell{display:flex;align-items:center;height:88rpx;padding:0 20rpx}
.edit-input,.edit-textarea{display:block;box-sizing:content-box;width:100%;min-width:0;margin:0;padding:0;border:0;border-radius:0;background:transparent;font-size:26rpx;font-weight:400;color:#354030;text-align:left}
.edit-input{flex:1;height:48rpx;min-height:48rpx;line-height:normal}
.edit-textarea{height:152rpx;line-height:40rpx;resize:none}.edit-short{height:100rpx}.edit-bio{height:230rpx}.edit-honors{height:130rpx}
.edit-placeholder{color:#969e8c;font-size:26rpx;font-weight:400}
.edit-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16rpx;margin-top:26rpx}.edit-photo{position:relative;min-width:0;height:170rpx;border-radius:14rpx;background:#f1f3ec}.edit-photo image{width:100%;height:100%;border-radius:14rpx;display:block}.locale-page button.edit-photo-remove{position:absolute;top:6rpx;right:6rpx;display:flex;align-items:center;justify-content:center;width:46rpx;height:46rpx;padding:0;margin:0;min-height:0;line-height:1;font-size:32rpx;border-radius:50%;color:#fff;background:rgba(32,37,31,.7)}.locale-page button.edit-add{width:100%;height:auto;min-height:170rpx;margin:0;padding:12rpx 8rpx;border:1rpx dashed #cfd6c5;border-radius:14rpx;background:#fafbf7;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#79886c;font-size:22rpx;line-height:1.5;white-space:normal;text-align:center;overflow-wrap:anywhere}.edit-add-icon{font-size:42rpx;line-height:1.2;margin-bottom:8rpx}
.edit-footer{padding:26rpx 4rpx 0}.edit-save-hint{color:#9a9f91;font-size:21rpx;line-height:1.6;text-align:center;margin-bottom:18rpx}.locale-page button.edit-save{width:100%;margin:0;min-height:88rpx;height:auto;padding:20rpx 16rpx;white-space:normal;line-height:1.5;display:flex;align-items:center;justify-content:center;text-align:center;border-radius:18rpx}.edit-error{background:#fff1ec;color:#b3442a;border-radius:14rpx;padding:24rpx;line-height:1.7;margin:20rpx 0;font-size:26rpx;overflow-wrap:anywhere}.edit-status{margin:20rpx 0}

.coach-edit-page { background: linear-gradient(155deg,#e9eee5,#f5f4ef 600rpx); }
.edit-identity { position: relative; overflow: hidden; border: 1rpx solid #465343; box-shadow: 0 14rpx 30rpx rgba(24,35,27,.1); }
.edit-identity-photo,.edit-identity-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.edit-identity-shade { background: linear-gradient(90deg,rgba(20,30,23,.96),rgba(20,30,23,.9) 55%,rgba(20,30,23,.6)); }
.edit-identity .edit-avatar,.edit-identity-main { position: relative; z-index: 1; }
.edit-identity .edit-avatar { border: 2rpx solid rgba(239,219,178,.6); }
.edit-identity button.edit-avatar-action { color: #f1ddba; border: 1rpx solid rgba(239,219,178,.25); }
.edit-avatar-hint { color: #d0d8c9; }
.edit-panel { box-shadow: 0 8rpx 24rpx rgba(32,37,31,.025); border-top: 3rpx solid #cbd4bf; }
.edit-tabs button.edit-tab.active { box-shadow: inset 0 -4rpx 0 #c7452d,0 3rpx 10rpx rgba(32,37,31,.06); }
