<view class="page-shell">
  <view wx:if="{{pageLoading}}" class="page-loading">LOADING WORKSPACE...</view>

  <view class="page-header">
    <view class="eyebrow">WORKSPACE · 派课 · 核销 · 排课</view>
    <view class="page-title">教练工作台</view>
  </view>

  <view wx:if="{{!hasPermission}}" class="card">
    <view class="section-title">ACCESS DENIED</view>
    <view class="card-desc">当前身份不是教练，此页面仅 Role=2 可见。请去“我的”页切换角色后再验收。</view>
  </view>

  <block wx:else>
    <view class="card coach-hero-card">
      <view class="avatar-square">{{avatarText}}</view>
      <view class="coach-hero-main">
        <view class="coach-hero-name">{{runtime.userProfile.nickname}} 的工作台</view>
        <view class="card-desc">今日 {{pageData.todayClasses.length}} 节课 · {{pageData.currentStore.name}} · Role 2</view>
      </view>
    </view>

    <view class="card">
      <view class="stats-grid coach-stat-grid">
        <view class="stats-item">
          <view class="stats-value">{{pageData.todayClasses.length * 6 || 0}}</view>
          <view class="stats-note">今日预约</view>
        </view>
        <view class="stats-item">
          <view class="stats-value">{{pageData.todayClasses.length}}</view>
          <view class="stats-note">日排班</view>
        </view>
        <view class="stats-item">
          <view class="stats-value">{{pageData.todayClasses.length ? pageData.todayClasses[0].checkedCount + pageData.todayClasses[0].absentCount : 0}}</view>
          <view class="stats-note">待处理</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">QUICK ACTIONS · 核心操作</view>
      <view class="workspace-action-grid">
        <view
          wx:for="{{pageData.quickActions}}"
          wx:key="id"
          class="workspace-action-card {{index === 0 ? 'primary' : ''}}"
          data-action-id="{{item.id}}"
          bindtap="onTapAction"
        >
          <view class="workspace-action-top">{{index === 0 ? 'SCAN' : index === 1 ? 'NEW' : 'ENTRY'}}</view>
          <view class="workspace-action-title">{{item.title}}</view>
          <view class="workspace-action-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="headline-row">
        <view class="section-title">TODAY · 今日课程</view>
        <view class="card-desc">{{pageData.todayClasses.length}} CLASSES</view>
      </view>
      <view wx:for="{{pageData.todayClasses}}" wx:key="id" class="today-class-card" data-class-id="{{item.id}}" bindtap="goClassDetail">
        <view class="today-class-time">
          <view class="today-class-time-main">{{item.timeStart}}</view>
          <view class="today-class-time-sub">{{item.timeEnd}}</view>
        </view>
        <view class="today-class-main">
          <view class="headline-row">
            <view class="today-class-title">{{item.title}}</view>
            <view class="menu-arrow">></view>
          </view>
          <view class="card-desc">{{item.venue}}</view>
          <view class="card-desc">{{item.bookedCount}} / {{item.capacity}} 人 · 已核销 {{item.checkedCount}} · 缺席 {{item.absentCount}}</view>
        </view>
      </view>
    </view>
  </block>

  <app-tabbar current="/pages/workspace/index"></app-tabbar>
</view>
