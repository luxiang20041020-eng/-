<view class="page-shell">
  <page-feedback loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="page-header">
    <view>
      <view class="page-title">到场核销</view>
      <view class="page-subtitle">{{pageData.classInfo.title}} · {{pageData.classInfo.timeRange}}</view>
    </view>
    <view class="role-badge">教练</view>
  </view>

  <view class="card">
    <view class="card-title">训练概览</view>
    <view class="card-desc">{{pageData.classInfo.venue}} · {{pageData.classInfo.dateLabel}}</view>
    <view class="metric-grid">
      <view class="metric-item">
        <view class="metric-label">预约人数</view>
        <view class="metric-value">{{pageData.classInfo.bookedCount}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-label">已核销</view>
        <view class="metric-value">{{pageData.classInfo.checkedCount}}</view>
      </view>
      <view class="metric-item">
        <view class="metric-label">已缺席</view>
        <view class="metric-value">{{pageData.classInfo.absentCount}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">预约名单</view>
    <view wx:for="{{pageData.roster}}" wx:key="bookingId" class="roster-item">
      <view class="row-between">
        <view class="schedule-title">{{item.userName}}</view>
        <view class="status-chip">{{item.status}}</view>
      </view>
      <view class="card-desc">{{item.phone}}</view>
      <view wx:if="{{item.status === '待核销'}}" class="button-row" style="margin-top: 16rpx;">
        <button class="primary-button" size="mini" loading="{{submittingBookingId === item.bookingId}}" disabled="{{submittingBookingId === item.bookingId}}" data-booking-id="{{item.bookingId}}" data-status="已核销" bindtap="onUpdateStatus">确认到场</button>
        <button class="secondary-button" size="mini" loading="{{submittingBookingId === item.bookingId}}" disabled="{{submittingBookingId === item.bookingId}}" data-booking-id="{{item.bookingId}}" data-status="已缺席" bindtap="onUpdateStatus">标记缺席</button>
      </view>
      <view wx:else class="card-desc" style="margin-top: 16rpx;">当前状态已确认，无需重复操作。</view>
    </view>
  </view>
</view>
