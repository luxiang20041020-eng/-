.distribute-page {
  padding:24rpx 24rpx calc(156rpx + env(safe-area-inset-bottom))
}

.distribute-hero {
  padding:30rpx;
  background:#20251f;
  color:#fff;
  border-radius:24rpx
}

.hero-eyebrow {
  font-size:18rpx;
  letter-spacing:3rpx;
  color:#bdc2b6;
  margin-bottom:20rpx
}

.hero-title {
  font-size:44rpx;
  font-weight:800
}

.hero-role {
  font-size:22rpx;
  color:#d8dbd1
}

.hero-caption {
  font-size:23rpx;
  color:#bdc2b6;
  margin-top:12rpx;
  line-height:1.6
}

.steps {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:28rpx 0;
  gap:10rpx
}

.step {
  display:flex;
  align-items:center;
  font-size:22rpx;
  color:#7c8076;
  gap:8rpx
}

.step.active {
  color:#c7452d;
  font-weight:700
}

.step-number {
  display:flex;
  align-items:center;
  justify-content:center;
  width:34rpx;
  height:34rpx;
  border-radius:50%;
  background:#e5e8dd;
  font-size:20rpx
}

.step.active .step-number {
  color:#fff;
  background:#c7452d
}

.step-line {
  height:2rpx;
  flex:1;
  background:#dce0d3
}

.flow-card,.review-card {
  padding:28rpx;
  background:#fff;
  border:1rpx solid #e6e7df;
  border-radius:22rpx;
  margin-bottom:20rpx
}

.section-title {
  font-size:30rpx;
  font-weight:700
}

.muted {
  font-size:23rpx;
  color:#7c8076;
  line-height:1.6;
  margin-top:8rpx
}

.search-input {
  margin-top:24rpx
}

.search-state {
  padding:42rpx 16rpx;
  text-align:center;
  font-size:24rpx;
  line-height:1.7;
  color:#7c8076
}

.member-option {
  padding:24rpx 0;
  border-bottom:1rpx solid #e8eade
}

.summary-name {
  font-size:29rpx;
  font-weight:700;
  word-break:break-all
}

.change-link {
  font-size:23rpx;
  color:#c7452d;
  flex-shrink:0
}

.balance-row {
  display:flex;
  gap:20rpx;
  font-size:22rpx;
  color:#626b56;
  margin-top:18rpx
}

.selected-member {
  background:#f5f4ef;
  border-radius:16rpx;
  padding:22rpx;
  margin-top:22rpx
}

.member-summary {
  display:flex;
  align-items:center;
  gap:18rpx;
  background:#eaece4;
  border-radius:18rpx;
  padding:22rpx;
  margin-bottom:20rpx
}

.member-avatar {
  display:flex;
  align-items:center;
  justify-content:center;
  width:64rpx;
  height:64rpx;
  flex-shrink:0;
  border-radius:14rpx;
  background:#20251f;
  color:#fff;
  font-size:30rpx;
  font-weight:700
}

.summary-main {
  flex:1;
  min-width:0
}

.type-tabs {
  display:flex;
  gap:10rpx;
  margin:22rpx 0
}

.type-tab {
  padding:12rpx 26rpx;
  border-radius:12rpx;
  background:#f0f1e9;
  font-size:24rpx;
  color:#7c8076
}

.type-tab.active {
  background:#20251f;
  color:#fff
}

.package-option {
  padding:24rpx;
  border:2rpx solid #e6e7df;
  border-radius:18rpx;
  margin-top:16rpx
}

.package-option.selected {
  background:#fcf0ea;
  border-color:#c7452d
}

.package-type {
  font-size:21rpx;
  font-weight:600;
  color:#626b56
}

.selection-mark {
  font-size:22rpx;
  color:#c7452d
}

.package-name {
  font-size:29rpx;
  font-weight:700;
  margin:14rpx 0
}

.package-lessons {
  font-size:40rpx;
  font-weight:800
}

.package-lessons text {
  font-size:22rpx;
  font-weight:400
}

.package-price {
  font-size:28rpx;
  font-weight:600
}

.amount-label {
  font-size:23rpx;
  color:#7c8076;
  margin-top:28rpx
}

.amount-field {
  display:flex;
  align-items:center;
  gap:12rpx;
  border-bottom:2rpx solid #dce0d3;
  padding:18rpx 0
}

.amount-field text {
  font-size:40rpx
}

.amount-field input {
  font-size:52rpx;
  font-weight:700;
  flex:1;
  min-width:0;
  height:74rpx
}

.payment-grid {
  display:flex;
  flex-wrap:wrap;
  gap:12rpx;
  margin-top:16rpx
}

.payment-option {
  padding:17rpx 24rpx;
  background:#f5f4ef;
  border:1rpx solid #e6e7df;
  border-radius:12rpx;
  font-size:24rpx
}

.payment-option.selected {
  background:#fcf0ea;
  border-color:#c7452d;
  color:#c7452d
}

.expiry-picker {
  display:flex;
  justify-content:space-between;
  padding:24rpx;
  background:#f5f4ef;
  border-radius:14rpx;
  margin-top:16rpx;
  font-size:27rpx
}

.expiry-picker text {
  font-size:23rpx;
  color:#c7452d
}

.review-card {
  background:#eaece4;
  border-color:#dce0d3
}

.balance-preview {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  margin:22rpx 0 26rpx
}

.balance-number {
  font-size:48rpx;
  font-weight:800
}

.balance-number text {
  font-size:22rpx;
  font-weight:400
}

.balance-arrow {
  font-size:25rpx;
  color:#7c8076
}

.accented {
  color:#c7452d
}

.receipt-line {
  display:flex;
  justify-content:space-between;
  gap:24rpx;
  border-top:1rpx solid #dce0d3;
  padding:18rpx 0;
  font-size:24rpx;
  line-height:1.6
}

.receipt-line text:first-child {
  color:#7c8076;
  flex-shrink:0
}

.receipt-line text:last-child {
  text-align:right;
  word-break:break-all
}

.review-note {
  margin-top:12rpx
}

.distribute-dock {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  display:flex;
  align-items:center;
  gap:24rpx;
  justify-content:space-between;
  background:#fff;
  border-top:1rpx solid #e6e7df;
  padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  z-index:10
}

.next-button {
  margin:0;
  padding:25rpx 28rpx;
  border-radius:16rpx;
  background:#c7452d;
  color:#fff;
  font-size:26rpx;
  font-weight:700;
  flex:1
}

.back-button {
  margin:0;
  font-size:25rpx;
  padding:20rpx;
  color:#7c8076
}

.dock-hint {
  font-size:23rpx;
  color:#7c8076;
  max-width:220rpx;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap
}

.receipt-card {
  background:#fff;
  border:1rpx solid #e6e7df;
  padding:36rpx 28rpx;
  border-radius:24rpx;
  margin-top:24rpx;
  text-align:center
}

.success-mark {
  display:flex;
  align-items:center;
  justify-content:center;
  width:82rpx;
  height:82rpx;
  border-radius:50%;
  background:#eaece4;
  color:#526341;
  font-size:46rpx;
  margin:0 auto 18rpx
}

.receipt-title {
  font-size:36rpx;
  font-weight:700
}

.receipt-lessons {
  font-size:60rpx;
  font-weight:800;
  color:#c7452d;
  margin:28rpx 0
}

.receipt-lessons text {
  font-size:25rpx;
  font-weight:400
}

.receipt-note {
  margin:20rpx 0 28rpx
}
