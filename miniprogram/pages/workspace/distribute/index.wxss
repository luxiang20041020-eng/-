.member-item,
.package-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
}

.member-item.is-selected,
.package-item.is-selected {
  border-color: #ff1f4f;
  background: #fff1f5;
}

.selected-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #ffd2dc;
  border-radius: 28rpx;
  background: #fff1f5;
}

.summary-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 26rpx;
  background: #ff1f4f;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-name {
  color: #07142f;
  font-size: 30rpx;
  font-weight: 900;
}

.summary-meta,
.member-phone {
  margin-top: 8rpx;
  color: #7d8798;
  font-size: 22rpx;
  line-height: 1.45;
}

.package-summary {
  margin-bottom: 4rpx;
}

.result-list,
.package-list {
  margin-top: 8rpx;
}

.search-hint {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx dashed #dce2ec;
  border-radius: 24rpx;
  color: #7d8798;
  background: #f8f9fc;
  font-size: 24rpx;
  line-height: 1.6;
}

.picker-display {
  color: #07142f;
}

.picker-display.placeholder {
  color: #9aa3b2;
}
