.member-item,
.package-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.member-item.is-selected,
.package-item.is-selected {
  border-color: #c7452d;
  background: #f9eae4;
}

.selected-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #ecd8cf;
  border-radius: 16rpx;
  background: #f9eae4;
}

.summary-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #c7452d;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-name {
  color: #20251f;
  font-size: 30rpx;
  font-weight: 600;
}

.summary-meta,
.member-phone {
  margin-top: 8rpx;
  color: #7c8076;
  font-size: 22rpx;
  line-height: 1.45;
}

.package-summary {
  margin-bottom: 4rpx;
}

.result-list,
.package-list {
  margin-top: 8rpx;
}

.search-hint {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx dashed #dce2ec;
  border-radius: 24rpx;
  color: #7c8076;
  background: #f7f7f2;
  font-size: 24rpx;
  line-height: 1.6;
}

.picker-display {
  color: #20251f;
}

.picker-display.placeholder {
  color: #979b90;
}
