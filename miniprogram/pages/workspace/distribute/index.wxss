.form-input,
.form-textarea {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #343434;
  border-radius: 14rpx;
  background: #101010;
  color: #f5f5f5;
  font-size: 26rpx;
}

.form-textarea {
  min-height: 160rpx;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #e5e5e5;
}

.member-item,
.package-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #2a2a2a;
  border-radius: 14rpx;
  background: #101010;
}

.member-item.is-selected,
.package-item.is-selected {
  border-color: #facc15;
}

.picker-display {
  color: #ffffff;
}

.picker-display.placeholder {
  color: #888888;
}
