<wxs module="i18n" src="../../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} distribute-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="distribute-hero"><view class="hero-eyebrow">ONE / MEMBER BENEFITS</view><view class="row-between"><view class="hero-title">{{i18n.f('权益派发', [], language)}}</view><view class="hero-role">{{i18n.t(runtime.role === 'admin' ? '管理员' : '教练', language)}}</view></view><view class="hero-caption">{{i18n.f('{0} · 记录收款，为学员补充课时。', [pageData.currentStore.name], language)}}</view></view>
  <view wx:if="{{receipt}}" class="receipt-card"><view class="success-mark">✓</view><view class="receipt-title">{{i18n.f('权益已派发', [], language)}}</view><view class="muted">{{receipt.name}} · {{receipt.phone}}</view><view wx:if="{{receipt.unlimited}}" class="receipt-lessons">{{i18n.t('期限内无限次', language)}}</view><view wx:else class="receipt-lessons">＋{{receipt.lessons}}<text>{{i18n.f('节{0}', [i18n.t(receipt.typeLabel, language)], language)}}</text></view><view class="receipt-line"><text>{{i18n.f('套餐', [], language)}}</text><text>{{receipt.packageName}}</text></view><view class="receipt-line"><text>{{i18n.f('到账有效期', [], language)}}</text><text>{{receipt.expiry}}</text></view><view class="receipt-line"><text>{{i18n.t(receipt.payType, language)}}</text><text>¥{{receipt.amount}}</text></view><view class="muted receipt-note">{{i18n.f('权益和收款记录已保存。', [], language)}}</view><button class="primary-button" bindtap="onContinueDistribute">{{i18n.f('继续派发', [], language)}}</button></view>
  <block wx:else>
    <view class="steps"><view class="step {{step === 1 ? 'active' : ''}}" data-step="1" bindtap="onStep"><text class="step-number">1</text>{{i18n.f('选学员', [], language)}}</view><view class="step-line" /><view class="step {{step === 2 ? 'active' : ''}}" data-step="2" bindtap="onStep"><text class="step-number">2</text>{{i18n.f('选套餐', [], language)}}</view><view class="step-line" /><view class="step {{step === 3 ? 'active' : ''}}" data-step="3" bindtap="onStep"><text class="step-number">3</text>{{i18n.f('收款与核对', [], language)}}</view></view>
    <view wx:if="{{selectedMember && step !== 1}}" class="member-summary" data-step="1" bindtap="onStep"><view class="member-avatar">{{selectedMember.avatarText}}</view><view class="summary-main"><view class="summary-name">{{selectedMember.nickname}}</view><view class="muted">{{selectedMember.phone}}</view></view><text class="change-link">{{i18n.f('更换 ›', [], language)}}</text></view>
    <view wx:if="{{step === 1}}" class="flow-card"><view class="section-title">{{i18n.f('派发给谁？', [], language)}}</view><view class="muted">{{i18n.f('按姓名或手机号查找学员，核对号码后选择。', [], language)}}</view><input class="form-input search-input" placeholder="{{i18n.f('输入姓名或手机号', [], language)}}" maxlength="32" disabled="{{submitting}}" value="{{keyword}}" bindinput="onKeywordInput" />
      <view wx:if="{{searching}}" class="search-state">{{i18n.f('正在查找学员…', [], language)}}</view>
      <view wx:elif="{{keyword && !pageError}}"><view wx:for="{{pageData.members}}" wx:key="id" class="member-option" data-member-id="{{item.id}}" bindtap="onSelectMember"><view class="row-between"><view><view class="summary-name">{{item.nickname}}</view><view class="muted">{{item.phone}}</view></view><text class="change-link">{{i18n.f('选择 ›', [], language)}}</text></view><view class="balance-row"><text>{{i18n.f('团课 {0} 节', [(item.groupUnlimited ? i18n.t('无限', language) : item.groupCount)], language)}}</text><text>{{i18n.f('私教 {0} 节', [(item.privateUnlimited ? i18n.t('无限', language) : item.privateCount)], language)}}</text></view></view><view wx:if="{{!pageData.members.length && !pageBusy}}" class="search-state">{{i18n.f('未找到学员，换个姓名或手机号再试。', [], language)}}</view></view>
      <view wx:elif="{{!selectedMember}}" class="search-state">{{i18n.f('先选择学员，再为其派发权益。', [], language)}}</view>
      <view wx:if="{{selectedMember}}" class="selected-member"><view class="muted">{{i18n.f('当前已选', [], language)}}</view><view class="summary-name">{{selectedMember.nickname}}</view><view class="muted">{{selectedMember.phone}}</view><view class="balance-row"><text>{{i18n.f('团课 {0} 节', [(selectedMember.groupUnlimited ? i18n.t('无限', language) : selectedMember.groupCount)], language)}}</text><text>{{i18n.f('私教 {0} 节', [(selectedMember.privateUnlimited ? i18n.t('无限', language) : selectedMember.privateCount)], language)}}</text></view></view>
    </view>
    <view wx:if="{{step === 2}}" class="flow-card"><view class="section-title">{{i18n.f('选择要增加的权益', [], language)}}</view><view class="muted">{{i18n.f('选择套餐后自动填入标准金额和有效期。', [], language)}}</view><view class="type-tabs"><view class="type-tab {{packageType === 'all' ? 'active' : ''}}" data-type="all" bindtap="onPackageFilter">{{i18n.f('全部', [], language)}}</view><view class="type-tab {{packageType === 'group' ? 'active' : ''}}" data-type="group" bindtap="onPackageFilter">{{i18n.f('团课', [], language)}}</view><view class="type-tab {{packageType === 'private' ? 'active' : ''}}" data-type="private" bindtap="onPackageFilter">{{i18n.f('私教', [], language)}}</view></view>
      <view wx:for="{{visiblePackages}}" wx:key="id" class="package-option {{selectedPackageId === item.id ? 'selected' : ''}}" data-package-id="{{item.id}}" bindtap="onSelectPackage"><view class="row-between"><text class="package-type">{{i18n.t(item.typeLabel, language)}}</text><text class="selection-mark">{{i18n.t(selectedPackageId === item.id ? '✓ 已选择' : '选择', language)}}</text></view><view class="package-name">{{item.name}}</view><view class="row-between"><view wx:if="{{item.unlimited}}" class="package-lessons">{{i18n.t('期限内无限次', language)}}</view><view wx:else class="package-lessons">{{item.lessons}}<text>{{i18n.f('节', [], language)}}</text></view><view class="package-price">¥{{item.price}}</view></view><view class="muted">{{i18n.f('有效期 {0} 天 · 标准价', [item.validDays], language)}}</view></view>
      <view wx:if="{{!visiblePackages.length && !pageBusy && !pageError}}" class="search-state">{{i18n.f('暂无可用套餐，请联系管理员上架。', [], language)}}</view>
    </view>
    <view wx:if="{{step === 3}}">
      <view class="flow-card"><view class="row-between"><view class="section-title">{{i18n.f('记录线下收款', [], language)}}</view><view class="change-link" data-step="2" bindtap="onStep">{{i18n.f('更换套餐 ›', [], language)}}</view></view><view class="muted">{{selectedPackage.unlimited ? selectedPackage.name + ' · ' + i18n.t('期限内无限次', language) : i18n.f('{0} · 增加 {1} 节{2}', [selectedPackage.name, selectedPackage.lessons, i18n.t(selectedPackage.typeLabel, language)], language)}}</view><view class="amount-label">{{i18n.f('实收金额（元）', [], language)}}</view><view class="amount-field"><text>¥</text><input type="digit" maxlength="12" value="{{amount}}" disabled="{{submitting}}" bindinput="onAmountInput" placeholder="0.00" /></view><view class="muted">{{i18n.f('标准价 ¥{0}，按实际收款填写。', [selectedPackage.price], language)}}</view><view class="field-block"><view class="field-label">{{i18n.f('收款方式', [], language)}}</view><view class="payment-grid"><view wx:for="{{paymentOptions}}" wx:key="*this" class="payment-option {{payType === item ? 'selected' : ''}}" data-value="{{item}}" bindtap="onPaymentSelect">{{item}}</view></view></view><view class="field-block"><view class="field-label">{{i18n.f('权益到期日', [], language)}}</view><picker mode="date" value="{{expiryDate}}" start="{{minExpiryDate}}" disabled="{{submitting}}" bindchange="onExpiryDateChange"><view class="expiry-picker">{{i18n.t(expiryDate || '请选择日期', language)}}<text>{{i18n.f('更改 ›', [], language)}}</text></view></picker><view class="muted">{{i18n.f('同类型权益合并，保留新旧到期日中较晚的日期。', [], language)}}</view></view><view class="field-block"><view class="field-label">{{i18n.f('备注（选填）', [], language)}}</view><textarea class="form-textarea" maxlength="200" value="{{remark}}" disabled="{{submitting}}" placeholder="{{i18n.f('如：续费、活动赠课、收款凭证编号', [], language)}}" bindinput="onRemarkInput" /></view></view>
      <view class="review-card"><view class="section-title">{{i18n.f('派发前核对', [], language)}}</view><view wx:if="{{selectedPackage.unlimited}}" class="muted review-note">{{i18n.t('派发期限内无限次权益，次数余额保持不变。', language)}}</view><view wx:else class="balance-preview"><view><view class="muted">{{i18n.f('当前可用', [], language)}}</view><view class="balance-number">{{preview.before}}</view></view><view class="balance-arrow">＋ {{selectedPackage.lessons}} →</view><view><view class="muted">{{i18n.f('预计到账后', [], language)}}</view><view class="balance-number accented">{{preview.after}}<text>{{i18n.f('节', [], language)}}</text></view></view></view><view class="receipt-line"><text>{{i18n.f('权益类型', [], language)}}</text><text>{{i18n.t(selectedPackage.typeLabel, language)}}</text></view><view class="receipt-line"><text>{{i18n.f('到账有效期', [], language)}}</text><text>{{preview.expiry}}</text></view><view class="receipt-line"><text>{{i18n.f('实收 / {0}', [i18n.t(payType, language)], language)}}</text><text>¥{{preview.amount}}</text></view><view class="muted review-note">{{i18n.f('余额以派发时的实际记录为准；已过期课时不计入本次到账。', [], language)}}</view></view>
    </view>
    <view class="distribute-dock"><button wx:if="{{step > 1}}" class="back-button" disabled="{{submitting}}" bindtap="onBack">{{i18n.f('上一步', [], language)}}</button><view wx:else class="dock-hint">{{i18n.t(selectedMember ? selectedMember.nickname : '尚未选择学员', language)}}</view><button wx:if="{{step < 3}}" class="next-button" disabled="{{pageBusy || pageError || (step === 1 ? !selectedMember : !selectedPackage)}}" bindtap="onNext">{{i18n.t(step === 1 ? '下一步 · 选套餐' : '下一步 · 记录收款', language)}}</button><button wx:else class="next-button" loading="{{submitting}}" disabled="{{submitting || pageBusy || pageError}}" bindtap="onSubmit">{{i18n.t(submitting ? '正在派发…' : '确认派发权益', language)}}</button></view>
  </block>
</view>
