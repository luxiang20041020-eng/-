.coach-hero-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: #ecd8cf;
  background: #fbfaf6;
}

.coach-hero-main {
  flex: 1;
  min-width: 0;
}

.coach-hero-name {
  font-size: 34rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-stat-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.coach-stat-grid .stats-item {
  min-height: 116rpx;
  text-align: center;
}

.workspace-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.workspace-action-card {
  min-height: 172rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(32, 37, 31, 0.05);
}

.workspace-action-card.primary {
  border-color: #ecd8cf;
  background: #f9eae4;
}

.workspace-action-top {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #c7452d;
  font-weight: 600;
}

.workspace-action-title {
  margin-top: 22rpx;
  font-size: 31rpx;
  line-height: 1.3;
  color: #20251f;
  font-weight: 600;
}

.workspace-action-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7c8076;
}

.today-class-card {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.today-class-time {
  width: 108rpx;
}

.today-class-time-main {
  font-size: 43rpx;
  line-height: 1;
  color: #20251f;
  font-weight: 600;
}

.today-class-time-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7c8076;
  font-weight: 600;
}

.today-class-main {
  flex: 1;
  min-width: 0;
}

.today-class-title {
  flex: 1;
  padding-right: 12rpx;
  font-size: 30rpx;
  line-height: 1.35;
  color: #20251f;
  font-weight: 600;
}
