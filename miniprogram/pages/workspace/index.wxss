.coach-hero-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: #ffe1e8;
  background: #fffafa;
}

.coach-hero-main {
  flex: 1;
  min-width: 0;
}

.coach-hero-name {
  font-size: 34rpx;
  color: #07142f;
  font-weight: 900;
}

.coach-stat-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.coach-stat-grid .stats-item {
  min-height: 116rpx;
  text-align: center;
}

.workspace-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.workspace-action-card {
  min-height: 172rpx;
  padding: 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(8, 20, 47, 0.05);
}

.workspace-action-card.primary {
  border-color: #ffd2dc;
  background: #fff1f5;
}

.workspace-action-top {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #ff1f4f;
  font-weight: 900;
}

.workspace-action-title {
  margin-top: 22rpx;
  font-size: 31rpx;
  line-height: 1.3;
  color: #07142f;
  font-weight: 900;
}

.workspace-action-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7d8798;
}

.today-class-card {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
}

.today-class-time {
  width: 108rpx;
}

.today-class-time-main {
  font-size: 43rpx;
  line-height: 1;
  color: #07142f;
  font-weight: 900;
}

.today-class-time-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7d8798;
  font-weight: 800;
}

.today-class-main {
  flex: 1;
  min-width: 0;
}

.today-class-title {
  flex: 1;
  padding-right: 12rpx;
  font-size: 30rpx;
  line-height: 1.35;
  color: #07142f;
  font-weight: 900;
}
