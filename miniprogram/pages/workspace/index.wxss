.coach-hero-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.coach-hero-main {
  flex: 1;
}

.coach-hero-name {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 700;
}

.coach-stat-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.coach-stat-grid .stats-item {
  min-height: 116rpx;
  text-align: center;
}

.workspace-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.workspace-action-card {
  min-height: 172rpx;
  padding: 18rpx;
  border: 1rpx solid #242424;
  background: #0b0b0b;
}

.workspace-action-card.primary {
  background: linear-gradient(180deg, rgba(255, 52, 52, 0.18) 0%, rgba(17, 17, 17, 1) 100%);
}

.workspace-action-top {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #b5b5b5;
}

.workspace-action-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  line-height: 1.3;
  color: #ffffff;
  font-weight: 700;
}

.workspace-action-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8d8d8d;
}

.today-class-card {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #1d1d1d;
}

.today-class-card:first-of-type {
  border-top: none;
  padding-top: 0;
}

.today-class-time {
  width: 106rpx;
}

.today-class-time-main {
  font-size: 46rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 700;
}

.today-class-time-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8c8c8c;
}

.today-class-main {
  flex: 1;
}

.today-class-title {
  flex: 1;
  padding-right: 12rpx;
  font-size: 30rpx;
  line-height: 1.35;
  color: #ffffff;
  font-weight: 700;
}
