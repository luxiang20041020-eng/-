.coach-hero-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: #ecd8cf;
  background: #fbfaf6;
}

.workspace-page .coach-hero-card { border-radius: 24rpx; border-color: #dce3d2; background: linear-gradient(120deg,#edf2e5,#fafbf7); }
.workspace-page .workspace-action-card { border-radius: 20rpx; background: linear-gradient(145deg,#f5f6ee,#fff); }
.workspace-page .workspace-action-card.primary { border-color: #c7d1ba; background: linear-gradient(135deg,#e5eddc,#f4f7ed); }
.workspace-page .workspace-action-top { color: #899575; font-size: 32rpx; }
.workspace-page .today-class-time { width: 124rpx; flex-shrink: 0; border-radius: 12rpx; background: #edf1e5; padding: 14rpx 8rpx; }
.workspace-page .today-class-time-main { font-size: 36rpx; }

.coach-hero-main {
  flex: 1;
  min-width: 0;
}

.coach-hero-name {
  font-size: 34rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-stat-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.coach-stat-grid .stats-item {
  min-height: 116rpx;
  text-align: center;
}

.workspace-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.workspace-action-card {
  min-height: 172rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(32, 37, 31, 0.05);
}

.workspace-action-card.primary {
  border-color: #ecd8cf;
  background: #f9eae4;
}

.workspace-action-top {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #c7452d;
  font-weight: 600;
}

.workspace-action-title {
  margin-top: 22rpx;
  font-size: 31rpx;
  line-height: 1.3;
  color: #20251f;
  font-weight: 600;
}

.workspace-action-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7c8076;
}

.today-class-card {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.today-class-time {
  width: 108rpx;
}

.today-class-time-main {
  font-size: 43rpx;
  line-height: 1;
  color: #20251f;
  font-weight: 600;
}

.today-class-time-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7c8076;
  font-weight: 600;
}

.today-class-main {
  flex: 1;
  min-width: 0;
}

.today-class-title {
  flex: 1;
  padding-right: 12rpx;
  font-size: 30rpx;
  line-height: 1.35;
  color: #20251f;
  font-weight: 600;
}
