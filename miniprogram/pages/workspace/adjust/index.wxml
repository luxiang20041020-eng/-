<wxs module="i18n" src="../../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} adjustment-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="page-header"><view class="eyebrow">ONE / OPERATIONS</view><view class="page-title">{{i18n.t(mode === 'schedule' ? '调整排课' : '操作纠错', language)}}</view><view class="card-desc">{{i18n.t('填写原因，保留原始记录与操作轨迹。', language)}}</view></view>
  <block wx:if="{{mode === 'schedule' && pageData.schedule}}">
    <view class="card">
      <view class="section-title">{{pageData.schedule.storeName}} · {{pageData.schedule.title}}</view>
      <view wx:if="{{pageData.schedule.cancelled}}" class="notice">{{i18n.t(pageData.schedule.remaining ? '场次已取消，仍有客户待退课' : '场次已取消，退课已完成', language)}}</view>
      <block wx:else>
        <view class="field-label">{{i18n.t('训练主题', language)}}</view><input class="form-input" data-field="title" value="{{title}}" maxlength="60" disabled="{{submitting}}" bindinput="onInput" />
        <view class="field-label">{{i18n.t('教练', language)}}</view><picker range="{{pageData.coaches}}" range-key="name" value="{{coachIndex}}" disabled="{{submitting || runtime.role !== 'admin'}}" bindchange="onCoachChange"><view class="picker-value">{{pageData.coaches[coachIndex].name}} <text wx:if="{{runtime.role === 'admin'}}">⌄</text></view></picker>
        <view class="field-label">{{i18n.t('训练日期', language)}}</view><picker mode="date" value="{{date}}" disabled="{{submitting}}" bindchange="onDateChange"><view class="picker-value">{{date}} ⌄</view></picker>
        <view class="button-row"><picker mode="time" value="{{startTime}}" data-field="startTime" disabled="{{submitting}}" bindchange="onTimeChange"><view class="picker-value">{{i18n.t('开始', language)}} {{startTime}}</view></picker><picker mode="time" value="{{endTime}}" data-field="endTime" disabled="{{submitting}}" bindchange="onTimeChange"><view class="picker-value">{{i18n.t('结束', language)}} {{endTime}}</view></picker></view>
        <view class="field-label">{{i18n.t('预约人数上限', language)}}</view><input class="form-input" type="number" data-field="capacity" value="{{capacity}}" maxlength="3" disabled="{{submitting || pageData.schedule.classType === 2}}" bindinput="onInput" />
      </block>
    </view>
    <view class="card"><view class="section-title">{{i18n.f('受影响客户（{0}）', [pageData.affected.length], language)}}</view><view wx:if="{{!pageData.affected.length}}" class="card-desc">{{i18n.t('暂无受影响客户', language)}}</view><view wx:for="{{pageData.affected}}" wx:key="id" class="record-item"><view class="row-between"><view>{{item.name}}</view><view class="badge">{{i18n.t(item.status, language)}}</view></view><view class="card-desc">{{item.phone}}</view></view></view>
    <view wx:if="{{!pageData.schedule.cancelled || pageData.schedule.remaining}}" class="card"><view class="field-label">{{i18n.t('操作原因（必填）', language)}}</view><textarea class="reason-input" data-field="reason" value="{{reason}}" maxlength="200" disabled="{{submitting || pageData.schedule.cancelled}}" bindinput="onInput" placeholder="{{i18n.t('请填写操作原因，最多 200 字', language)}}" /><view class="card-desc">{{i18n.t(progress, language)}}</view><view class="button-row"><button wx:if="{{!pageData.schedule.cancelled}}" class="primary-button" disabled="{{submitting || pageBusy || pageError}}" loading="{{submitting}}" bindtap="onSaveSchedule">{{i18n.t('保存排课修改', language)}}</button><button class="secondary-button" disabled="{{submitting || pageBusy || pageError}}" loading="{{submitting}}" bindtap="onCancelSchedule">{{i18n.t(pageData.schedule.cancelled ? '继续退课' : '取消场次并退课', language)}}</button></view></view>
    <view wx:if="{{pageData.history.length}}" class="card"><view class="section-title">{{i18n.t('排课调整记录', language)}}</view><view wx:for="{{pageData.history}}" wx:key="id" class="record-item"><view>{{item.operatorName}} · {{item.time}}</view><view class="card-desc">{{item.before.title}} · {{item.before.start_time}} → {{item.after.title}} · {{item.after.start_time}}</view><view class="card-desc">{{item.beforeCoachName}} → {{item.afterCoachName}} · {{item.before.max_capacity}} → {{item.after.max_capacity}}</view><view class="card-desc">{{i18n.t(item.after.status === 4 ? '已取消' : '排课已修改，已有预约已同步更新', language)}}</view><view class="card-desc">{{i18n.f('原因：{0}', [item.reason], language)}}</view></view></view>
  </block>
  <block wx:if="{{mode === 'records' && runtime.role === 'admin'}}">
    <view class="card"><view class="section-title">{{i18n.t('派发与核销记录', language)}}</view><view class="card-desc">{{i18n.t('撤销派发不代表退款，线下款项需另行核对。', language)}}</view><view wx:if="{{!pageData.records.length}}" class="empty-state">{{i18n.t('暂无可纠错记录', language)}}</view><view wx:for="{{pageData.records}}" wx:key="id" class="record-item"><view class="row-between"><view class="record-title">{{item.userName}} · {{item.title}}</view><view class="badge">{{i18n.t(item.kind === 'distribution' ? '权益派发' : '到场核销', language)}}</view></view><view class="card-desc">{{item.time}} · {{item.operatorName}}</view><view class="card-desc">{{i18n.t(item.hint, language)}}</view><view class="row-between"><view>{{i18n.f('当前余额 {0} 次', [item.balance], language)}}</view><button wx:if="{{item.eligible}}" class="secondary-button correction-button" data-id="{{item.id}}" data-kind="{{item.kind}}" disabled="{{submitting}}" bindtap="onSelectRecord">{{i18n.t('撤销操作', language)}}</button></view></view></view>
    <view class="card"><view class="section-title">{{i18n.t('纠错审计记录', language)}}</view><view wx:if="{{!pageData.history.length}}" class="card-desc">{{i18n.t('暂无纠错记录', language)}}</view><view wx:for="{{pageData.history}}" wx:key="id" class="record-item"><view>{{item.userName}} · {{i18n.t(item.title, language)}}</view><view class="card-desc">{{item.operatorName}} · {{item.time}}</view><view>{{i18n.f('余额：{0} → {1} 次', [item.beforeBalance, item.afterBalance], language)}}</view><view class="card-desc">{{i18n.f('原因：{0}', [item.reason], language)}}</view></view></view>
  </block>
  <view wx:if="{{selectedRecord}}" class="correction-mask"><view class="correction-sheet"><scroll-view scroll-y class="correction-scroll"><view class="section-title">{{i18n.t('撤销操作', language)}}</view><view class="record-item">{{selectedRecord.userName}} · {{selectedRecord.title}}</view><view class="notice">{{i18n.t(selectedRecord.hint, language)}}</view><view class="card-desc">{{i18n.f('当前余额 {0} 次', [selectedRecord.balance], language)}}</view><view class="card-desc">{{i18n.f('余额：{0} → {1} 次', [selectedRecord.balance, selectedRecord.projectedBalance], language)}}</view><view class="field-label">{{i18n.t('操作原因（必填）', language)}}</view><textarea class="reason-input" data-field="reason" value="{{reason}}" maxlength="200" disabled="{{submitting}}" bindinput="onInput" placeholder="{{i18n.t('请填写操作原因，最多 200 字', language)}}" /></scroll-view><view class="button-row"><button class="secondary-button" disabled="{{submitting}}" bindtap="onCloseRecord">{{i18n.t('取消', language)}}</button><button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onReverse">{{i18n.t('确认撤销操作', language)}}</button></view></view></view>
</view>
