.adjustment-page { padding-bottom: 60rpx; }
.field-label { margin: 24rpx 0 12rpx; font-size: 25rpx; color: #6f746a; }
.picker-value { padding: 20rpx; background: #f5f4ef; border: 1rpx solid #dedfd6; border-radius: 14rpx; }
.reason-input { width: 100%; min-height: 150rpx; height: 180rpx; box-sizing: border-box; padding: 20rpx; border-radius: 14rpx; background: #f5f4ef; border: 1rpx solid #dedfd6; margin-bottom: 24rpx; }
.record-item { padding: 24rpx 0; border-bottom: 1rpx solid #ecece5; line-height: 1.6; overflow-wrap: anywhere; }
.record-item:last-child { border-bottom: 0; }
.record-title { flex: 1; min-width: 0; font-weight: 600; }
.badge { font-size: 21rpx; color: #7b8276; }
.notice { padding: 20rpx; margin: 16rpx 0; background: #faf0e9; color: #995339; border-radius: 14rpx; font-size: 25rpx; line-height: 1.7; }
.row-between { gap: 16rpx; }
.button-row { margin-top: 24rpx; }
.button-row picker { flex: 1; min-width: 0; }
.locale-page button.correction-button { flex: 0 1 auto; width: auto; min-width: 130rpx; max-width: 50%; margin: 16rpx 0 0; padding: 14rpx; }
.correction-mask { position: fixed; inset: 0; z-index: 50; background: rgba(0,0,0,.4); display: flex; align-items: flex-end; }
.correction-sheet { box-sizing: border-box; width: 100%; max-height: 90vh; padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 24rpx 24rpx 0 0; }
.correction-scroll { max-height: 65vh; }
