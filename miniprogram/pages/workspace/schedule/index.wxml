<wxs module="i18n" src="../../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} schedule-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="schedule-hero"><view class="hero-eyebrow">ONE / TRAINING SCHEDULE</view><view class="row-between"><view class="hero-title">{{i18n.f('排期管理', [], language)}}</view><view class="hero-role">{{i18n.t(runtime.role === 'admin' ? '管理员兼教练' : '教练', language)}}</view></view><view class="hero-caption">{{i18n.t(runtime.role === 'admin' ? '查看门店课程，安排下一场训练。' : '查看我的课程，安排下一场训练。', language)}}</view><view class="venue-selector" bindtap="onStoreFieldTap"><view><view class="venue-name">{{selectedStoreName || i18n.t('选择门店', language)}}</view><view class="venue-address">{{selectedStoreAddress}}</view></view><text>{{i18n.f('切换 ›', [], language)}}</text></view></view>
  <view class="calendar-card"><view class="row-between"><view><view class="section-title">{{weekRange}}</view><view class="muted">{{i18n.f(runtime.role === 'admin' ? '本周 {0} 场 · 门店排期' : '本周 {0} 场 · 我的排期', [weekCount], language)}}</view></view><button class="today-button" bindtap="onToday">{{i18n.f('今天', [], language)}}</button></view><view class="week-navigation"><button data-days="-7" bindtap="onShiftWeek">{{i18n.f('‹ 上周', [], language)}}</button><picker mode="date" value="{{selectedDate}}" bindchange="onCalendarDateChange"><view>{{i18n.f('选择日期 ⌄', [], language)}}</view></picker><button data-days="7" bindtap="onShiftWeek">{{i18n.f('下周 ›', [], language)}}</button></view><view class="calendar-grid"><view wx:for="{{days}}" wx:key="key" class="calendar-day {{selectedDate === item.key ? 'selected' : ''}}" data-date="{{item.key}}" bindtap="onSelectDay"><view class="day-week">{{i18n.t(item.label, language)}}</view><view class="day-number">{{item.day}}</view><view class="day-count">{{i18n.t(item.count ? item.count + '场' : '—', language)}}</view></view></view></view>
  <view class="row-between agenda-heading"><view class="section-title">{{i18n.t(dayHeading, language)}}</view><view class="muted">{{i18n.f('{0} 场', [dayPlans.length], language)}}</view></view>
  <view class="type-tabs"><view class="type-tab {{filterType === 'all' ? 'active' : ''}}" data-type="all" bindtap="onFilter">{{i18n.f('全部', [], language)}}</view><view class="type-tab {{filterType === 'group' ? 'active' : ''}}" data-type="group" bindtap="onFilter">{{i18n.f('团课', [], language)}}</view><view class="type-tab {{filterType === 'private' ? 'active' : ''}}" data-type="private" bindtap="onFilter">{{i18n.f('私教', [], language)}}</view></view>
  <view wx:if="{{scheduleNotice}}" class="schedule-notice">{{scheduleNotice}}<button bindtap="onRetry">{{i18n.f('重新同步', [], language)}}</button></view>
  <view wx:if="{{!dayPlans.length && !pageBusy && !pageError && !scheduleNotice}}" class="agenda-empty"><view class="empty-symbol">＋</view><view class="section-title">{{i18n.f('当天暂无{0}', [i18n.t(filterType === 'all' ? '课程' : (filterType === 'group' ? '团课' : '私教'), language)], language)}}</view><view class="muted">{{i18n.f('选择其他日期查看，或为这一天新增排期。', [], language)}}</view><button class="empty-add" bindtap="onOpenEditor">{{i18n.f('新增排期', [], language)}}</button></view>
  <view wx:for="{{dayPlans}}" wx:key="id" class="agenda-item {{item.status === '已取消' ? 'cancelled' : ''}}"><view class="agenda-time"><view class="start-time">{{item.startTime}}</view><view class="end-time">{{item.endTime}}</view><view class="time-line" /></view><view class="agenda-content"><view class="row-between"><view class="class-type {{item.type}}">{{i18n.t(item.type === 'group' ? '团课' : '私教', language)}}</view><view class="class-status">{{i18n.t(item.status, language)}}</view></view><view class="class-title">{{item.title}}</view><view class="muted">{{item.venue}}<text wx:if="{{item.repeatWeekly}}">{{i18n.f('· 每周重复', [], language)}}</text></view><view class="row-between class-footer"><view class="capacity-count">{{i18n.f('已约 {0} / {1} 人', [item.bookedCount || 0, item.capacity || '—'], language)}}</view><button wx:if="{{item.status !== '已取消'}}" class="roster-link" data-id="{{item.id}}" bindtap="onOpenClass">{{i18n.f('名单与核销 ›', [], language)}}</button></view><button class="secondary-button" data-id="{{item.id}}" bindtap="onAdjustClass">{{i18n.t(item.cancelRemaining ? '继续退课' : (item.status === '已取消' ? '查看取消记录' : '调整 / 取消'), language)}}</button></view></view>
  <view class="schedule-dock"><view><view class="dock-date">{{selectedDate}}</view><view class="muted">{{i18n.f('安排下一场训练', [], language)}}</view></view><button class="dock-add" disabled="{{pageBusy || pageError}}" bindtap="onOpenEditor">{{i18n.f('＋ 新增排期', [], language)}}</button></view>
  <view wx:if="{{editorOpen}}" class="editor-overlay"><view class="editor-sheet"><view class="editor-header row-between"><view><view class="section-title">{{i18n.f('新增排期', [], language)}}</view><view class="muted">{{selectedStoreName}} · {{runtime.userProfile.nickname}}</view></view><button class="close-editor" disabled="{{submitting}}" bindtap="onCloseEditor">{{i18n.f('关闭', [], language)}}</button></view><scroll-view scroll-y class="editor-scroll"><view class="editor-body">
    <view class="field-label">{{i18n.f('训练主题', [], language)}}</view><input class="form-input" data-field="title" value="{{title}}" disabled="{{submitting}}" maxlength="60" bindinput="onInput" placeholder="{{i18n.f('如：泰拳基础步法', [], language)}}" />
    <view class="field-block"><view class="field-label">{{i18n.f('训练类型', [], language)}}</view><view class="type-tabs editor-types"><view class="type-tab {{type === 'group' ? 'active' : ''}}" data-type="group" bindtap="onTypeChange">{{i18n.f('团课', [], language)}}</view><view class="type-tab {{type === 'private' ? 'active' : ''}}" data-type="private" bindtap="onTypeChange">{{i18n.f('私教 · 1 对 1', [], language)}}</view></view></view>
    <view class="field-block"><view class="field-label">{{i18n.f('训练日期', [], language)}}</view><picker mode="date" value="{{fullDate}}" start="{{minDate}}" disabled="{{submitting}}" bindchange="onDateChange"><view class="picker-value">{{fullDate}} · {{i18n.t(weekLabel, language)}}<text>{{i18n.f('更改 ›', [], language)}}</text></view></picker></view>
    <view class="field-block"><view class="field-label">{{i18n.f('训练时段', [], language)}}</view><view class="time-picker-row"><picker mode="time" value="{{startTime}}" disabled="{{submitting}}" data-field="startTime" bindchange="onTimeChange"><view class="time-value"><view class="muted">{{i18n.f('开始', [], language)}}</view><view>{{startTime}}</view></view></picker><view class="time-divider">—</view><picker mode="time" value="{{endTime}}" disabled="{{submitting}}" data-field="endTime" bindchange="onTimeChange"><view class="time-value"><view class="muted">{{i18n.f('结束', [], language)}}</view><view>{{endTime}}</view></view></picker></view></view>
    <view wx:if="{{type === 'group'}}" class="field-block"><view class="field-label">{{i18n.f('预约人数上限', [], language)}}</view><input class="form-input" type="number" maxlength="3" data-field="capacity" value="{{capacity}}" disabled="{{submitting}}" bindinput="onInput" placeholder="{{i18n.f('1 至 100 人', [], language)}}" /></view>
    <view class="field-block repeat-block"><view class="row-between"><view><view class="field-label">{{i18n.f('每周重复', [], language)}}</view><view class="muted">{{i18n.f('同一星期、同一时段，连续 4 周', [], language)}}</view></view><switch checked="{{repeatWeekly}}" disabled="{{submitting}}" color="#c7452d" bindchange="onRepeatWeeklyChange" /></view></view>
    <view class="publish-preview"><view class="field-label">{{i18n.f('将发布 {0} 场训练', [repeatDates.length], language)}}</view><view class="muted">{{i18n.f('{0} · {1} 人 / 场', [timeRange, type === 'group' ? capacity : 1], language)}}</view><view class="repeat-dates"><text wx:for="{{repeatDates}}" wx:key="*this">{{item}}</text></view></view>
    <view wx:if="{{conflictPlans.length}}" class="conflict-box"><view class="field-label">{{i18n.f('时间重叠，请调整时段', [], language)}}</view><view wx:for="{{conflictPlans}}" wx:key="id">{{item.fullDate}} {{item.timeRange}} · {{item.title}}</view></view>
    <view class="muted editor-note">{{i18n.f('其他门店的教练排期也会在发布时校验，避免同一时段重复排课。', [], language)}}</view>
  </view></scroll-view><view class="editor-actions"><button class="primary-button" loading="{{submitting}}" disabled="{{submitting || pageBusy || pageError || conflictPlans.length}}" bindtap="onSubmit">{{i18n.t(submitting ? '正在发布…' : '确认发布 ' + repeatDates.length + ' 场', language)}}</button></view></view></view>
</view>
