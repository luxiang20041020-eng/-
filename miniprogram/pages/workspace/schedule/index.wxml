<view class="page-shell">
  <page-feedback loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="page-header">
    <view>
      <view class="page-title">排课管理</view>
      <view class="page-subtitle">{{pageData.currentStore.name}} · 维护近期发布训练安排并补录新排课。</view>
    </view>
    <view class="role-badge">教练</view>
  </view>

  <view class="card">
    <view class="card-title">新增排课</view>
    <view class="field-block">
      <view class="field-label">选择星期</view>
      <view class="button-row week-option-row" style="margin-top: 16rpx;">
        <view wx:for="{{weekOptions}}" wx:key="value" class="outline-chip {{weekDay === item.value ? 'active' : ''}}" data-week-day="{{item.value}}" bindtap="onWeekChange">{{item.label}}</view>
      </view>
    </view>
    <view class="field-block">
      <view class="field-label">训练日期</view>
      <picker mode="date" value="{{fullDate}}" start="{{minDate}}" bindchange="onDateChange">
        <view class="readonly-value">{{fullDate}} · {{weekLabel}} <text class="inline-link">更改</text></view>
      </picker>
    </view>
    <view class="field-block">
      <view class="field-label">时间段</view>
      <view class="time-picker-row">
        <picker mode="time" value="{{startTime}}" data-field="startTime" bindchange="onTimeChange"><view class="readonly-value">{{startTime}} 开始</view></picker>
        <picker mode="time" value="{{endTime}}" data-field="endTime" bindchange="onTimeChange"><view class="readonly-value">{{endTime}} 结束</view></picker>
      </view>
    </view>
    <view class="field-block">
      <view class="field-label">训练主题</view>
      <input class="form-input" data-field="title" value="{{title}}" maxlength="60" bindinput="onInput" placeholder="如：泰拳基础步法" />
    </view>
    <view class="field-block">
      <view class="field-label">训练类型</view>
      <view class="button-row" style="margin-top: 16rpx;">
        <view class="outline-chip {{type === 'group' ? 'active' : ''}}" data-type="group" bindtap="onTypeChange">团课</view>
        <view class="outline-chip {{type === 'private' ? 'active' : ''}}" data-type="private" bindtap="onTypeChange">私教</view>
      </view>
    </view>
    <view class="field-block">
      <view class="field-label">门店选择（即场地）</view>
      <view class="store-picker" bindtap="onStoreFieldTap">
        <view class="store-picker-main">
          <view class="store-picker-value {{selectedStoreName ? '' : 'placeholder'}}">{{selectedStoreName || '点击选择门店'}}</view>
          <view wx:if="{{selectedStoreAddress}}" class="card-desc">{{selectedStoreAddress}}</view>
        </view>
        <view class="store-picker-arrow">></view>
      </view>
    </view>
    <view class="field-block">
      <view class="row-between">
        <view class="field-label">每周重复，连续 4 周</view>
        <switch checked="{{repeatWeekly}}" color="#c7452d" bindchange="onRepeatWeeklyChange" />
      </view>
      <view class="card-desc">开启后将一次发布所选日期及随后 3 周的同一时段。</view>
    </view>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting || pageBusy || pageError}}" bindtap="onSubmit">确认新增排课</button>
  </view>

  <view class="card">
    <view class="card-title">近期排课</view>
    <view wx:if="{{!pageData.plans.length}}" class="empty-state"><view class="empty-title">尚未发布排课</view><view>选择日期与时段，发布第一场训练。</view></view>
    <view wx:for="{{pageData.plans}}" wx:key="id" class="plan-item">
      <view class="row-between">
        <view class="schedule-title">{{item.title}}</view>
        <view class="status-chip">{{item.status}}</view>
      </view>
      <view class="card-desc">{{item.weekLabel}} {{item.dateLabel}} · {{item.timeRange}}</view>
      <view class="card-desc">{{item.type === 'group' ? '团课' : '私教'}} · {{item.venue}}<text wx:if="{{item.repeatWeekly}}"> · 每周固定</text></view>
    </view>
  </view>
</view>
