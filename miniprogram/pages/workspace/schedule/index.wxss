.week-option-row {
  flex-wrap: wrap;
}

.store-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-picker-main {
  flex: 1;
  min-width: 0;
}

.store-picker-value {
  color: #07142f;
  font-size: 26rpx;
  font-weight: 900;
}

.store-picker-value.placeholder {
  color: #9aa3b2;
}

.store-picker-arrow {
  margin-left: 16rpx;
  color: #7d8798;
  font-size: 28rpx;
  font-weight: 900;
}

.plan-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
}
