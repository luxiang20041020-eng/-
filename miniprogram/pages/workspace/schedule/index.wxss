.week-option-row {
  flex-wrap: wrap;
}

.time-picker-row { display: flex; gap: 20rpx; }
.time-picker-row picker { flex: 1; }

.store-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-picker-main {
  flex: 1;
  min-width: 0;
}

.store-picker-value {
  color: #20251f;
  font-size: 26rpx;
  font-weight: 600;
}

.store-picker-value.placeholder {
  color: #979b90;
}

.store-picker-arrow {
  margin-left: 16rpx;
  color: #7c8076;
  font-size: 28rpx;
  font-weight: 600;
}

.plan-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
}
