.schedule-page {
  padding:24rpx 24rpx calc(158rpx + env(safe-area-inset-bottom))
}

.schedule-notice {
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 14rpx;
  background: #fae9e3;
  color: #a33322;
  font-size: 23rpx;
  line-height: 1.6;
}

.schedule-notice button {
  color: #a33322;
  font-size: 23rpx;
  text-align: left;
  margin: 10rpx 0 0;
}

.schedule-hero {
  padding:30rpx;
  background:#20251f;
  color:#fff;
  border-radius:24rpx
}

.hero-eyebrow {
  color:#bdc2b6;
  font-size:18rpx;
  letter-spacing:3rpx;
  margin-bottom:20rpx
}

.hero-title {
  font-size:44rpx;
  font-weight:800
}

.hero-role {
  color:#d8dbd1;
  font-size:22rpx
}

.hero-caption {
  color:#bdc2b6;
  font-size:24rpx;
  margin-top:10rpx
}

.venue-selector {
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-top:1rpx solid #495044;
  margin-top:28rpx;
  padding-top:24rpx;
  font-size:22rpx
}

.venue-name {
  font-size:28rpx;
  font-weight:600
}

.venue-address {
  color:#bdc2b6;
  font-size:21rpx;
  margin-top:6rpx;
  max-width:460rpx
}

.calendar-card {
  margin-top:20rpx;
  padding:26rpx 18rpx 20rpx;
  background:#fff;
  border-radius:24rpx;
  border:1rpx solid #e6e7df
}

.section-title {
  font-size:28rpx;
  font-weight:700
}

.muted {
  font-size:22rpx;
  color:#7c8076;
  line-height:1.6
}

.today-button {
  margin:0;
  padding:12rpx 22rpx;
  background:#f5f4ef;
  border-radius:12rpx;
  font-size:23rpx
}

.week-navigation {
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin:26rpx 0 18rpx;
  font-size:23rpx;
  color:#7c8076
}

.week-navigation button {
  margin:0;
  padding:12rpx 10rpx;
  font-size:23rpx;
  color:#20251f
}

.calendar-grid {
  display:flex;
  gap:6rpx
}

.calendar-day {
  flex:1;
  min-width:0;
  text-align:center;
  border-radius:16rpx;
  padding:16rpx 0 12rpx
}

.calendar-day.selected {
  background:#c7452d;
  color:#fff
}

.day-week {
  font-size:20rpx
}

.day-number {
  font-size:34rpx;
  font-weight:700;
  margin:12rpx 0
}

.day-count {
  font-size:18rpx;
  opacity:.65
}

.agenda-heading {
  margin:32rpx 4rpx 18rpx
}

.type-tabs {
  display:flex;
  gap:10rpx;
  margin-bottom:22rpx
}

.type-tab {
  padding:12rpx 28rpx;
  font-size:24rpx;
  color:#7c8076;
  border-radius:12rpx;
  background:#eaece4
}

.type-tab.active {
  color:#fff;
  background:#20251f;
  font-weight:600
}

.agenda-item {
  display:flex;
  margin-bottom:18rpx;
  gap:20rpx
}

.agenda-time {
  width:100rpx;
  flex-shrink:0;
  text-align:center;
  padding-top:22rpx
}

.start-time {
  font-size:30rpx;
  font-weight:700
}

.end-time {
  font-size:22rpx;
  color:#7c8076;
  margin-top:8rpx
}

.time-line {
  height:64rpx;
  border-left:2rpx solid #d7dacd;
  margin:16rpx 0 0 50rpx
}

.agenda-content {
  flex:1;
  min-width:0;
  background:#fff;
  border:1rpx solid #e6e7df;
  border-left:5rpx solid #c7452d;
  border-radius:18rpx;
  padding:22rpx
}

.class-type {
  font-size:20rpx;
  color:#c7452d;
  font-weight:600
}

.class-type.private {
  color:#58654a
}

.class-status {
  color:#7c8076;
  font-size:20rpx
}

.class-title {
  font-size:30rpx;
  font-weight:700;
  margin:14rpx 0 8rpx;
  word-break:break-all
}

.class-footer {
  border-top:1rpx solid #eeefe8;
  padding-top:16rpx;
  margin-top:18rpx;
  gap:10rpx
}

.capacity-count {
  font-size:21rpx
}

.roster-link {
  margin:0;
  color:#c7452d;
  font-size:21rpx;
  padding:8rpx 0
}

.cancelled {
  opacity:.55
}

.cancelled .agenda-content {
  border-left-color:#9a9f91
}

.agenda-empty {
  padding:40rpx 20rpx;
  text-align:center;
  border:1rpx dashed #d7dacd;
  border-radius:20rpx
}

.empty-symbol {
  font-size:48rpx;
  color:#c7452d;
  margin-bottom:16rpx
}

.agenda-empty .muted {
  margin-top:12rpx
}

.empty-add {
  color:#c7452d;
  font-size:25rpx;
  padding:20rpx
}

.schedule-dock {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  z-index:10;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20rpx;
  padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  background:#fff;
  border-top:1rpx solid #e6e7df
}

.dock-date {
  font-weight:700;
  font-size:26rpx
}

.dock-add {
  margin:0;
  padding:24rpx 32rpx;
  border-radius:16rpx;
  background:#c7452d;
  color:#fff;
  font-size:27rpx;
  font-weight:600
}

.editor-overlay {
  position:fixed;
  top:0;
  bottom:0;
  left:0;
  right:0;
  z-index:30;
  background:rgba(16,22,15,.6);
  display:flex;
  align-items:flex-end
}

.editor-sheet {
  width:100%;
  height:90vh;
  display:flex;
  flex-direction:column;
  border-radius:28rpx 28rpx 0 0;
  background:#f5f4ef;
  overflow:hidden
}

.editor-header {
  padding:28rpx;
  flex-shrink:0;
  border-bottom:1rpx solid #e0e3d8
}

.close-editor {
  margin:0;
  padding:14rpx;
  font-size:25rpx;
  color:#7c8076
}

.editor-scroll {
  flex:1;
  min-height:0;
  height:0
}

.editor-body {
  padding:28rpx
}

.editor-types {
  margin-top:16rpx;
  margin-bottom:0
}

.picker-value {
  display:flex;
  justify-content:space-between;
  padding:24rpx;
  margin-top:14rpx;
  border-radius:14rpx;
  background:#fff;
  font-size:28rpx
}

.picker-value text {
  font-size:23rpx;
  color:#c7452d
}

.time-picker-row {
  display:flex;
  align-items:center;
  gap:16rpx;
  margin-top:14rpx
}

.time-picker-row picker {
  flex:1
}

.time-value {
  text-align:center;
  background:#fff;
  border-radius:14rpx;
  padding:20rpx;
  font-size:36rpx;
  font-weight:700
}

.time-divider {
  color:#979b90
}

.repeat-block {
  padding:24rpx 0;
  border-top:1rpx solid #e0e3d8;
  border-bottom:1rpx solid #e0e3d8
}

.publish-preview {
  background:#eaece4;
  border-radius:16rpx;
  padding:24rpx
}

.repeat-dates {
  display:flex;
  flex-wrap:wrap;
  gap:12rpx;
  margin-top:16rpx
}

.repeat-dates text {
  background:#fff;
  padding:10rpx 14rpx;
  border-radius:10rpx;
  font-size:23rpx
}

.conflict-box {
  background:#fae9e3;
  color:#a33322;
  padding:22rpx;
  border-radius:16rpx;
  margin-top:18rpx;
  font-size:23rpx;
  line-height:1.8
}

.editor-note {
  margin-top:18rpx
}

.editor-actions {
  flex-shrink:0;
  background:#fff;
  padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom))
}

.locale-page .agenda-content button.secondary-button {
  width: 100%;
  min-width: 0;
  margin: 20rpx 0 0;
}
