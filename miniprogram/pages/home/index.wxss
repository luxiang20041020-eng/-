.home-top-shell {
  margin: -24rpx -24rpx 0;
  padding: 28rpx 28rpx 34rpx;
  background: #ffffff;
}

.home-store-trigger {
  display: inline-flex;
  align-items: center;
  min-width: 0;
}

.home-store-pin {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #fff1f5;
}

.home-store-pin::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 16rpx;
  width: 20rpx;
  height: 26rpx;
  border-radius: 20rpx 20rpx 20rpx 0;
  background: #ff1f4f;
  transform: rotate(-45deg);
}

.home-store-pin-core {
  position: absolute;
  left: 28rpx;
  top: 24rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ffffff;
  z-index: 1;
}

.home-store-name {
  max-width: 350rpx;
  font-size: 30rpx;
  line-height: 1.2;
  color: #07142f;
  font-weight: 900;
}

.home-store-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 12rpx;
  border-right: 3rpx solid #7d8798;
  border-bottom: 3rpx solid #7d8798;
  transform: rotate(45deg) translateY(-2rpx);
}

.home-bell {
  position: relative;
  width: 174rpx;
  height: 78rpx;
  border: 1rpx solid #e8ecf3;
  border-radius: 999rpx;
  background: #f8f9fc;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.home-bell::after {
  content: '...';
  position: absolute;
  right: 24rpx;
  top: 14rpx;
  color: #07142f;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.home-bell-handle {
  position: absolute;
  top: 22rpx;
  left: 40rpx;
  width: 18rpx;
  height: 8rpx;
  border: 3rpx solid #07142f;
  border-bottom: none;
  border-radius: 16rpx 16rpx 0 0;
}

.home-bell-body {
  position: absolute;
  top: 30rpx;
  left: 32rpx;
  width: 34rpx;
  height: 24rpx;
  border: 3rpx solid #07142f;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  border-bottom: none;
}

.home-bell-clapper {
  position: absolute;
  top: 54rpx;
  left: 44rpx;
  width: 10rpx;
  height: 3rpx;
  background: #07142f;
}

.home-bell-dot {
  position: absolute;
  top: 16rpx;
  left: 58rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff1f4f;
}

.home-hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 64rpx;
}

.home-hero-copy {
  flex: 1;
  min-width: 0;
}

.home-hero-kicker {
  font-size: 20rpx;
  letter-spacing: 8rpx;
  color: #ff1f4f;
  font-weight: 900;
}

.home-hero-title {
  margin-top: 18rpx;
  font-size: 86rpx;
  line-height: 0.92;
  color: #07142f;
  font-weight: 900;
  font-style: italic;
  text-shadow: 7rpx 0 0 #ff8b5d;
}

.home-hero-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: #697386;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.home-hero-stat {
  min-width: 138rpx;
  padding-left: 24rpx;
  border-left: 1rpx solid #e8ecf3;
  text-align: center;
}

.home-hero-stat-value {
  font-size: 58rpx;
  line-height: 1;
  color: #07142f;
  font-weight: 900;
}

.home-hero-stat-label {
  margin-top: 14rpx;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: #7d8798;
  font-weight: 900;
}

.home-event-card {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  padding: 48rpx 42rpx 46rpx;
  border: 1rpx solid #ffe1e8;
  border-radius: 42rpx;
  background:
    repeating-linear-gradient(45deg, rgba(255, 31, 79, 0.045) 0, rgba(255, 31, 79, 0.045) 10rpx, transparent 10rpx, transparent 26rpx),
    #fff7f9;
  box-shadow: 0 18rpx 38rpx rgba(255, 31, 79, 0.08);
}

.home-event-copy {
  position: relative;
  z-index: 1;
  max-width: 78%;
}

.home-event-kicker,
.pricing-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: #ff1f4f;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
}

.home-event-title {
  margin-top: 24rpx;
  font-size: 31rpx;
  line-height: 1.42;
  color: #07142f;
  font-weight: 900;
}

.home-event-index {
  position: absolute;
  right: 24rpx;
  bottom: -24rpx;
  font-size: 150rpx;
  line-height: 1;
  color: rgba(255, 31, 79, 0.08);
  font-weight: 900;
  font-style: italic;
}

.home-event-pager {
  display: none;
}

.home-access-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 26rpx;
}

.home-access-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 232rpx;
  padding: 34rpx 10rpx 24rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 38rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 38rpx rgba(8, 20, 47, 0.06);
}

.home-access-item:nth-child(3) {
  border-color: #ffd1dc;
  background: #fffafa;
}

.home-access-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  color: #ff1f4f;
  background: #fff1f5;
}

.icon-calendar {
  border: 3rpx solid #ff1f4f;
}

.icon-calendar-top {
  position: absolute;
  top: 14rpx;
  left: 12rpx;
  right: 12rpx;
  height: 3rpx;
  background: #ff1f4f;
}

.icon-calendar-grid {
  position: absolute;
  top: 28rpx;
  left: 14rpx;
  right: 14rpx;
  height: 3rpx;
  background: #ff1f4f;
  box-shadow: 0 12rpx 0 #ff1f4f;
}

.icon-user-head {
  position: absolute;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #ff1f4f;
  border-radius: 50%;
}

.icon-user-body {
  position: absolute;
  bottom: 12rpx;
  width: 30rpx;
  height: 18rpx;
  border: 3rpx solid #ff1f4f;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  border-bottom: none;
}

.icon-list {
  flex-direction: column;
  gap: 8rpx;
}

.icon-list-row {
  position: relative;
  width: 32rpx;
  height: 3rpx;
  background: #ff1f4f;
}

.icon-list-row::before {
  content: '';
  position: absolute;
  left: -10rpx;
  top: -3rpx;
  width: 8rpx;
  height: 8rpx;
  border: 2rpx solid #ff1f4f;
  border-radius: 50%;
}

.icon-qr-box {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #ff1f4f;
}

.icon-qr-box.box-1 { top: 10rpx; left: 10rpx; }
.icon-qr-box.box-2 { top: 10rpx; right: 10rpx; }
.icon-qr-box.box-3 { bottom: 10rpx; left: 10rpx; }
.icon-qr-box.box-4 { bottom: 10rpx; right: 10rpx; background: #ff1f4f; }

.home-access-kicker {
  margin-top: 18rpx;
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #697386;
  font-weight: 900;
}

.home-access-title {
  margin-top: 8rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.28;
  color: #07142f;
  font-weight: 900;
}

.home-section-name {
  margin-top: 8rpx;
  font-size: 34rpx;
  color: #07142f;
  font-weight: 900;
}

.section-link {
  font-size: 21rpx;
  letter-spacing: 1rpx;
  color: #697386;
  font-weight: 900;
}

.facility-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.facility-card {
  position: relative;
  overflow: hidden;
  min-height: 220rpx;
  padding: 18rpx;
  border-radius: 32rpx;
  background: #07142f;
}

.facility-image,
.facility-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.facility-shade {
  background: linear-gradient(180deg, rgba(7, 20, 47, 0.05) 0%, rgba(7, 20, 47, 0.58) 100%);
}

.facility-card-main {
  min-height: 360rpx;
  grid-row: span 2;
}

.facility-index {
  position: relative;
  z-index: 1;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #ffffff;
  font-weight: 900;
}

.facility-name {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 1;
  font-size: 28rpx;
  line-height: 1.35;
  color: #ffffff;
  font-weight: 900;
}

.pricing-list {
  margin-top: 20rpx;
}

.pricing-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #eef1f6;
}

.pricing-item:first-child {
  border-top: none;
  padding-top: 0;
}

.pricing-tag.is-private {
  background: #07142f;
}

.pricing-tag.is-group {
  background: #ff1f4f;
}

.pricing-name {
  margin-top: 16rpx;
  font-size: 31rpx;
  line-height: 1.35;
  color: #07142f;
  font-weight: 900;
}

.pricing-meta {
  margin-top: 10rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7d8798;
  font-weight: 800;
}

.pricing-price-wrap {
  text-align: right;
}

.pricing-price {
  font-size: 42rpx;
  line-height: 1;
  color: #07142f;
  font-weight: 900;
}

.pricing-note {
  margin-top: 10rpx;
  font-size: 18rpx;
  color: #7d8798;
  font-weight: 800;
}
