.store-anchor {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
}

.bell-mark {
  min-width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  border: 1rpx solid #2b2b2b;
  color: #ff3d3d;
  font-size: 20rpx;
}

.home-hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 18rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9d9d9d;
}

.hero-side-stat {
  text-align: right;
}

.hero-side-value {
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
  color: #ffffff;
}

.hero-side-label {
  margin-top: 8rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #8b8b8b;
}

.notice-banner {
  background:
    linear-gradient(135deg, rgba(255, 53, 53, 0.18) 0%, rgba(255, 53, 53, 0.04) 48%, rgba(5, 5, 5, 0.98) 48%, rgba(5, 5, 5, 0.98) 100%),
    #0a0a0a;
}

.notice-title {
  margin-top: 14rpx;
  font-size: 36rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #ffffff;
}

.home-store-switch {
  margin-top: 18rpx;
}

.home-action-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0;
  margin-top: 18rpx;
  border: 1rpx solid #242424;
}

.home-action-card {
  min-height: 144rpx;
  padding: 22rpx 14rpx;
  border-right: 1rpx solid #242424;
  background: #090909;
}

.home-action-card:last-child {
  border-right: none;
}

.home-action-card.primary {
  background: linear-gradient(180deg, rgba(255, 52, 52, 0.14) 0%, rgba(10, 10, 10, 1) 100%);
}

.home-action-kicker {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #ff3d3d;
}

.home-action-title {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.3;
  color: #ffffff;
  font-weight: 700;
}

.home-section-name {
  margin-top: 10rpx;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 700;
}

.section-link {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #9c9c9c;
}

.facility-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.facility-card {
  min-height: 220rpx;
  padding: 18rpx;
  border: 1rpx solid #232323;
  background: linear-gradient(180deg, rgba(255, 52, 52, 0.06) 0%, rgba(14, 14, 14, 0.98) 100%);
}

.facility-card-main {
  min-height: 360rpx;
  grid-row: span 2;
}

.facility-index {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #ff4a4a;
}

.facility-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #ffffff;
  font-weight: 700;
}

.pricing-list {
  margin-top: 20rpx;
}

.pricing-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #1d1d1d;
}

.pricing-item:first-child {
  border-top: none;
  padding-top: 0;
}

.pricing-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 110rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border: 1rpx solid #2f2f2f;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.pricing-tag.is-private {
  border-color: #ff3d3d;
  color: #ff3d3d;
}

.pricing-tag.is-group {
  color: #b0b0b0;
}

.pricing-name {
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.35;
  color: #ffffff;
  font-weight: 700;
}

.pricing-meta {
  margin-top: 10rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #6f6f6f;
}

.pricing-price-wrap {
  text-align: right;
}

.pricing-price {
  font-size: 48rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 700;
}

.pricing-note {
  margin-top: 10rpx;
  font-size: 18rpx;
  color: #9f9f9f;
}
