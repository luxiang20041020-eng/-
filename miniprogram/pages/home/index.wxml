<view class="page-shell">
  <view wx:if="{{pageLoading}}" class="page-loading">LOADING HOME DATA...</view>

  <view class="home-top-shell">
    <view class="headline-row">
      <view class="home-store-trigger" bindtap="onOpenStorePicker">
        <view class="home-store-pin">
          <view class="home-store-pin-core"></view>
        </view>
        <view class="home-store-name">{{pageData.currentStore.name}}</view>
        <view class="home-store-chevron"></view>
      </view>
      <view class="home-bell" bindtap="onBellTap">
        <view class="home-bell-handle"></view>
        <view class="home-bell-body"></view>
        <view class="home-bell-clapper"></view>
        <view class="home-bell-dot"></view>
      </view>
    </view>
    <view class="home-hero-row">
      <view class="home-hero-copy">
        <view class="home-hero-kicker">EST. 2018 · CHENGDU</view>
        <view class="home-hero-title">IRONFIST</view>
        <view class="home-hero-subtitle">铁拳 · 泰拳搏击馆</view>
      </view>
      <view class="home-hero-stat">
        <view class="home-hero-stat-value">{{pageData.coachCountText}}</view>
        <view class="home-hero-stat-label">COACHES</view>
      </view>
    </view>
  </view>

  <view class="home-event-card">
    <view class="home-event-copy">
      <view class="home-event-kicker">EVENT</view>
      <view class="home-event-title">{{pageData.heroNotice}}</view>
      <view class="home-event-desc">3 级别 8 强淘汰奖金 10,000 ￥</view>
    </view>
    <view class="home-event-index">01</view>
  </view>

  <view class="home-event-pager">
    <view class="home-event-pager-item active"></view>
    <view class="home-event-pager-item"></view>
  </view>

  <view class="home-access-grid">
    <view class="home-access-item" bindtap="goBooking">
      <view class="home-access-icon icon-calendar">
        <view class="icon-calendar-top"></view>
        <view class="icon-calendar-grid"></view>
      </view>
      <view class="home-access-kicker">GROUP</view>
      <view class="home-access-title">团课预约</view>
    </view>
    <view class="home-access-item" bindtap="goBooking">
      <view class="home-access-icon icon-user">
        <view class="icon-user-head"></view>
        <view class="icon-user-body"></view>
      </view>
      <view class="home-access-kicker">PT</view>
      <view class="home-access-title">私教预约</view>
    </view>
    <view class="home-access-item" bindtap="goMySchedule">
      <view class="home-access-icon icon-list">
        <view class="icon-list-row"></view>
        <view class="icon-list-row"></view>
        <view class="icon-list-row"></view>
      </view>
      <view class="home-access-kicker">MINE</view>
      <view class="home-access-title">我的课表</view>
    </view>
    <view class="home-access-item" bindtap="goIdentityQr">
      <view class="home-access-icon icon-qr">
        <view class="icon-qr-box box-1"></view>
        <view class="icon-qr-box box-2"></view>
        <view class="icon-qr-box box-3"></view>
        <view class="icon-qr-box box-4"></view>
      </view>
      <view class="home-access-kicker">QR</view>
      <view class="home-access-title">身份码</view>
    </view>
  </view>

  <view class="card">
    <view class="headline-row">
      <view>
        <view class="eyebrow">FACILITY</view>
        <view class="home-section-name">馆内实景</view>
      </view>
      <view class="section-link">VIEW ALL</view>
    </view>
    <view class="facility-grid">
      <view wx:for="{{pageData.galleryList}}" wx:key="*this" class="facility-card {{index === 0 ? 'facility-card-main' : ''}}">
        <view class="facility-index">0{{index + 1}}</view>
        <view class="facility-name">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="headline-row">
      <view>
        <view class="eyebrow">PRICING</view>
        <view class="home-section-name">课程价目表</view>
      </view>
      <view class="card-desc">线下了解</view>
    </view>
    <view class="pricing-list">
      <view wx:for="{{pageData.packages}}" wx:key="id" class="pricing-item">
        <view>
          <view class="pricing-tag {{item.type === 'private' ? 'is-private' : 'is-group'}}">{{item.type === 'private' ? 'PRIVATE' : 'GROUP'}}</view>
          <view class="pricing-name">{{item.name}}</view>
          <view class="pricing-meta">{{item.lessons}} CLASSES · CODE-00{{index + 1}}</view>
        </view>
        <view class="pricing-price-wrap">
          <view class="pricing-price">￥{{item.price}}</view>
          <view class="pricing-note">仅线下</view>
        </view>
      </view>
    </view>
  </view>

  <app-tabbar current="/pages/home/index"></app-tabbar>
</view>
