<view class="page-shell home-page">
  <view class="home-masthead">
    <view class="home-brand"><text class="home-wordmark">ONE</text><text class="home-brand-caption">泰拳格斗馆</text></view>
    <view class="home-store-trigger" bindtap="onOpenStorePicker" hover-class="tap-feedback"><text class="store-indicator"></text><text>{{pageData.currentStore.name || '选择门店'}}</text><text class="home-chevron">⌄</text></view>
  </view>
  <page-feedback loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="home-hero">
    <image class="home-hero-image" src="/images/gym-interior-1.jpg" mode="aspectFill"></image>
    <view class="home-hero-shade"></view>
    <view class="home-hero-content">
      <view class="home-hero-kicker">ONE / MUAY THAI CLUB</view>
      <view class="home-hero-title"><view>每一次出拳，</view><view>都更进一步。</view></view>
      <view class="home-hero-subtitle">专注当下，练出自己的节奏。</view>
      <button class="home-hero-cta" data-type="group" bindtap="goBooking" hover-class="tap-feedback">预约下一次训练 <text>↗</text></button>
    </view>
    <view class="home-hero-bottom"><text>团体训练 · 专属指导</text><text>KEEP SHOWING UP.</text></view>
  </view>
  <view class="home-notice" bindtap="onBellTap" hover-class="tap-feedback"><view class="notice-dot"></view><text class="notice-copy">{{pageData.heroNotice}}</text><text>›</text></view>
  <view class="home-section-head"><view class="section-heading">你的训练，从这里开始</view><text class="home-small-label">TRAINING</text></view>
  <view class="home-training-grid">
    <view class="home-training-card" data-type="group" bindtap="goBooking" hover-class="tap-feedback"><view class="training-number">01 <text>↗</text></view><view class="training-title">团体训练</view><view class="training-description">一起进步，保持热爱</view><view class="training-tag">查看团课场次</view></view>
    <view class="home-training-card training-private" data-type="private" bindtap="goBooking" hover-class="tap-feedback"><view class="training-number">02 <text>↗</text></view><view class="training-title">专属训练</view><view class="training-description">专注你的动作与目标</view><view class="training-tag">查看专属场次</view></view>
  </view>
  <view class="home-member-links"><view bindtap="goMySchedule" hover-class="tap-feedback"><text class="member-link-title">我的预约</text><text class="member-link-desc">查看训练安排</text><text class="member-link-arrow">›</text></view><view bindtap="goIdentityQr" hover-class="tap-feedback"><text class="member-link-title">到店身份码</text><text class="member-link-desc">出示给场馆人员</text><text class="member-link-arrow">›</text></view></view>
  <view class="home-section-head"><view class="section-heading">在这里，认真训练</view><view class="inline-link" data-index="0" bindtap="onPreviewGallery">查看实景 ↗</view></view>
  <scroll-view class="facility-scroll" scroll-x="true" show-scrollbar="false"><view wx:for="{{pageData.galleryList}}" wx:key="*this" class="facility-card" data-index="{{index}}" bindtap="onPreviewGallery" hover-class="tap-feedback"><image class="facility-image" src="/images/gym-interior-{{index + 1}}.jpg" mode="aspectFill"></image><view class="facility-caption"><text>0{{index + 1}}</text><text>{{item}}</text></view></view></scroll-view>
  <view class="card home-pricing">
    <view class="collapsible-header" bindtap="onTogglePricing" hover-class="tap-feedback"><view><view class="section-heading">选择适合你的训练计划</view><view class="page-caption">{{pageData.packages.length || 0}} 个套餐 · 到馆咨询</view></view><view class="collapse-toggle"><view class="collapse-chevron {{pricingExpanded ? 'expanded' : ''}}"></view></view></view>
    <view wx:if="{{pricingExpanded}}" class="pricing-list"><view wx:for="{{pageData.packages}}" wx:key="id" class="pricing-item"><view><view class="pricing-tag">{{item.type === 'private' ? '专属训练' : '团体训练'}}</view><view class="pricing-name">{{item.name}}</view><view class="pricing-meta">{{item.lessons}} 次训练</view></view><view class="pricing-price-wrap"><view class="pricing-price">¥{{item.price}}</view><view class="pricing-note">到馆购买</view></view></view><view wx:if="{{!pageData.packages.length}}" class="empty-text">套餐整理中，欢迎到馆咨询</view></view>
  </view>
  <view class="home-address" wx:if="{{pageData.currentStore.address}}" bindtap="onOpenLocation" hover-class="tap-feedback"><view class="section-heading">{{pageData.currentStore.name}}</view><view class="page-caption">{{pageData.currentStore.address}}</view><view class="inline-link">查看位置与路线 ↗</view></view>
  <view class="home-footer">ONE · 每一次坚持，都算数。</view>
  <app-tabbar id="tabbar" current="/pages/home/index"></app-tabbar>
</view>
