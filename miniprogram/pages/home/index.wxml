<view class="page-shell">
  <view class="page-header">
    <view>
      <view class="page-title">铁拳泰拳</view>
      <view class="page-subtitle">{{pageData.currentStore.address}} · {{pageData.currentStore.notice}}</view>
    </view>
    <view class="role-badge">{{runtime.roleLabel}}</view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="card-title">门店切换</view>
      <view class="store-badge">当前：{{pageData.currentStore.name}}</view>
    </view>
    <scroll-view class="scroll-row home-store-row" scroll-x="true" show-scrollbar="false">
      <view class="scroll-chip" wx:for="{{runtime.stores}}" wx:key="id">
        <view
          class="outline-chip {{item.id === runtime.currentStore.id ? 'active' : ''}}"
          data-store-id="{{item.id}}"
          bindtap="onSwitchStore"
        >
          {{item.name}}
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="card">
    <view class="card-title">公告与推荐</view>
    <view class="card-desc" wx:for="{{pageData.notices}}" wx:key="*this">- {{item}}</view>
  </view>

  <view class="card">
    <view class="card-title">快捷入口</view>
    <view class="button-row" style="margin-top: 20rpx;">
      <button class="primary-button" bindtap="goBooking">去预约</button>
      <button class="secondary-button" bindtap="goProfile">看资产</button>
    </view>
    <button class="secondary-button" style="margin-top: 16rpx;" bindtap="goRolePage">进入当前角色工作区</button>
  </view>

  <view class="card">
    <view class="card-title">馆内分区</view>
    <view class="card-desc" wx:for="{{pageData.galleryList}}" wx:key="*this">{{index + 1}}. {{item}}</view>
  </view>

  <view class="card">
    <view class="card-title">价格公示</view>
    <view class="card-desc">仅作展示，引导客户线下成交，符合当前业务约束。</view>
    <view class="metric-grid">
      <view class="metric-item" wx:for="{{pageData.packages}}" wx:key="id">
        <view class="metric-label">{{item.name}}</view>
        <view class="card-desc">{{item.type === 'group' ? '团课' : '私教'}} · {{item.lessons}} 节</view>
        <view class="metric-value">￥{{item.price}}</view>
      </view>
    </view>
  </view>

  <app-tabbar current="/pages/home/index"></app-tabbar>
</view>
