.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at top left, rgba(255, 52, 52, 0.22), transparent 34%),
    linear-gradient(180deg, #121212 0%, #050505 100%);
}

.login-hero {
  margin-top: 80rpx;
}

.login-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  color: #ff6565;
  font-size: 22rpx;
  letter-spacing: 6rpx;
}

.login-title {
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 600;
}

.login-subtitle {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  line-height: 1.7;
}

.login-card {
  margin-top: 36rpx;
}

.login-tip {
  margin-top: 18rpx;
  color: #f5f5f5;
  font-size: 28rpx;
}

.login-button {
  margin-top: 32rpx;
}

.login-error {
  margin-top: 20rpx;
  color: #ff7b7b;
  font-size: 24rpx;
  line-height: 1.6;
}
