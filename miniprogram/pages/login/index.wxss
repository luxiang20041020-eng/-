.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 80rpx;
  background:
    linear-gradient(180deg, #ffffff 0%, #fff7f9 48%, #f4f6fb 100%);
}

.login-hero {
  position: relative;
  padding: 0 4rpx;
}

.login-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ff1f4f;
  font-size: 20rpx;
  letter-spacing: 7rpx;
  font-weight: 900;
}

.login-title {
  margin-top: 22rpx;
  color: #07142f;
  font-size: 66rpx;
  line-height: 1.08;
  font-weight: 900;
  font-style: italic;
  text-shadow: 6rpx 0 0 #ff8b5d;
}

.login-subtitle {
  max-width: 560rpx;
  margin-top: 22rpx;
  color: #697386;
  font-size: 27rpx;
  line-height: 1.65;
  font-weight: 700;
}

.login-card {
  position: relative;
  overflow: hidden;
  margin-top: 42rpx;
  border-color: #ffe1e8;
  background:
    repeating-linear-gradient(45deg, rgba(255, 31, 79, 0.04) 0, rgba(255, 31, 79, 0.04) 10rpx, transparent 10rpx, transparent 28rpx),
    #ffffff;
}

.login-card::after {
  content: '01';
  position: absolute;
  right: 20rpx;
  bottom: -32rpx;
  color: rgba(255, 31, 79, 0.07);
  font-size: 146rpx;
  font-weight: 900;
  font-style: italic;
}

.login-tip {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  color: #07142f;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 900;
}

.login-button {
  position: relative;
  z-index: 1;
  margin-top: 32rpx;
}

.login-error {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  color: #ff1f4f;
  font-size: 24rpx;
  line-height: 1.6;
  font-weight: 800;
}

.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(7, 20, 47, 0.45);
  backdrop-filter: blur(10px);
}

.privacy-panel {
  width: 100%;
  max-width: 660rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid #ffe1e8;
  border-radius: 38rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(8, 20, 47, 0.18);
}

.privacy-title {
  color: #07142f;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
}

.privacy-content {
  margin-top: 22rpx;
  color: #697386;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: left;
}

.privacy-link {
  color: #ff1f4f;
  font-weight: 900;
}

.privacy-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.privacy-cancel,
.privacy-confirm {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 900;
}

.privacy-cancel {
  border: 1rpx solid #e7ebf2;
  background: #f8f9fc;
  color: #07142f;
}

.privacy-confirm {
  background: #ff1f4f;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(255, 31, 79, 0.22);
}
