.login-page { padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); background:#f5f4ef; }
.login-hero { position:relative; height:540rpx; overflow:hidden; border-radius:16rpx; padding:40rpx 32rpx; background:#20251f; }
.login-cover,.login-cover-shade { position:absolute; left:0; top:0; width:100%; height:100%; }.login-cover-shade { background:linear-gradient(90deg,rgba(19,26,17,.94),rgba(19,26,17,.35)); }
.login-badge,.login-title,.login-subtitle { position:relative; }.login-badge { color:#d2d6c6; font-size:21rpx; letter-spacing:3rpx; }.login-title { margin-top:72rpx; color:#fffef5; font-size:54rpx; line-height:1.4; font-weight:600; }.login-subtitle { color:#c9cdbd; font-size:24rpx; margin-top:28rpx; }
.login-card { margin-top:28rpx; padding:32rpx; }.login-tip { color:#7c8076; font-size:25rpx; line-height:1.7; margin-top:16rpx; }.login-button { margin-top:30rpx; }.login-error { color:#a23926; font-size:24rpx; margin-top:20rpx; line-height:1.6; }.login-browse { margin-top:28rpx; line-height:80rpx; color:#68715e; font-size:25rpx; }
.privacy-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 220;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(32, 37, 31, 0.45);
  backdrop-filter: blur(10px);
}

.privacy-panel {
  width: 100%;
  max-width: 660rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid #ecd8cf;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(32, 37, 31, 0.18);
}

.privacy-title {
  color: #20251f;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 600;
}

.privacy-content {
  margin-top: 22rpx;
  color: #73786e;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: left;
}

.privacy-link {
  color: #c7452d;
  font-weight: 600;
}

.privacy-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.privacy-cancel,
.privacy-confirm {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 600;
}

.privacy-cancel {
  border: 1rpx solid #e1e3d9;
  background: #f7f7f2;
  color: #20251f;
}

.privacy-confirm {
  background: #c7452d;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(199, 69, 45, 0.22);
}
