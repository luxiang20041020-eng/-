<view class="page-shell login-page">
  <view class="login-hero">
    <view class="login-badge">IRONFIST</view>
    <view class="login-title">欢迎来到ONE泰拳格斗馆</view>
    <view class="login-subtitle">使用微信绑定手机号一键登录，进入预约、排课与核销工作台。</view>
  </view>

  <view class="card login-card">
    <view class="section-title">WECHAT LOGIN</view>
    <view wx:if="{{checkingSession}}" class="login-tip">正在检查登录状态...</view>
    <view wx:else class="login-tip">认证完成后将自动同步你的门店、角色与用户昵称。</view>
    <button
      class="primary-button login-button"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{submitting}}"
      disabled="{{checkingSession || submitting || needPrivacyAuthorization}}"
    >
      {{submitting ? '登录中...' : '手机号一键登录'}}
    </button>
    <view wx:if="{{loginError}}" class="login-error">{{loginError}}</view>
    <view class="card-desc">点击即表示同意通过微信授权手机号完成登录绑定。</view>
  </view>

  <view wx:if="{{needPrivacyAuthorization}}" class="privacy-mask">
    <view class="privacy-panel">
      <view class="privacy-title">用户隐私保护提示</view>
      <view class="privacy-content">
        <text>本小程序需要获取你的手机号用于登录验证。请先阅读并同意</text>
        <text class="privacy-link" bindtap="onOpenPrivacyContract">《{{privacyContractName}}》</text>
        <text>后继续使用。</text>
      </view>
      <view class="privacy-actions">
        <button class="privacy-cancel" bindtap="onRejectPrivacyAuthorization">暂不使用</button>
        <button
          id="privacyAgreeButton"
          class="privacy-confirm"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onAgreePrivacyAuthorization"
        >
          同意并继续
        </button>
      </view>
    </view>
  </view>
</view>
