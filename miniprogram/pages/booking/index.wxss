.booking-title-row {
  margin-top: 6rpx;
}

.filter-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid #2a2a2a;
  color: #ffffff;
  font-size: 18rpx;
}

.booking-type-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border: 1rpx solid #232323;
}

.booking-type-tab {
  min-height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: #a3a3a3;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  border-right: 1rpx solid #232323;
  background: #0a0a0a;
}

.booking-type-tab:last-child {
  border-right: none;
}

.booking-type-tab.active {
  color: #ffffff;
  background: #131313;
  box-shadow: inset 0 -4rpx 0 #ff3434;
}

.filter-scroll {
  margin-top: 18rpx;
}

.booking-filter-row {
  margin-top: 18rpx;
}

.coach-filter-trigger {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 240rpx;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #232323;
  background: #0a0a0a;
}

.coach-filter-trigger.active {
  border-color: #ff3434;
}

.coach-filter-label {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

.coach-filter-arrow {
  font-size: 20rpx;
  color: #8a8a8a;
}

.booking-result-count {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #8a8a8a;
}

.date-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.date-card {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 108rpx;
  height: 116rpx;
  margin-right: 12rpx;
  padding: 14rpx 12rpx;
  border: 1rpx solid #232323;
  background: #0b0b0b;
}

.date-card.active {
  border-color: #ff3434;
  background: linear-gradient(180deg, rgba(255, 52, 52, 0.2) 0%, rgba(15, 15, 15, 1) 100%);
}

.date-card-kicker {
  font-size: 18rpx;
  color: #8a8a8a;
}

.date-card-label {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1.2;
}

.booking-schedule-card {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #242424;
  background: #0a0a0a;
}

.booking-time-block {
  width: 122rpx;
  min-height: 180rpx;
  padding: 16rpx 12rpx;
  background: linear-gradient(180deg, rgba(255, 52, 52, 0.14) 0%, rgba(16, 16, 16, 1) 100%);
}

.booking-time-main {
  font-size: 46rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 700;
}

.booking-time-sub {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #8c8c8c;
}

.booking-card-main {
  flex: 1;
}

.booking-card-status {
  padding: 8rpx 12rpx;
  border: 1rpx solid #ff3434;
  color: #ffffff;
  background: #ff3434;
  font-size: 18rpx;
}

.booking-card-status.is-disabled {
  border-color: #444444;
  background: #232323;
  color: #a7a7a7;
}

.booking-card-status.is-booked {
  border-color: #2c2c2c;
  background: #111111;
  color: #d0d0d0;
}

.booking-card-title {
  margin-top: 14rpx;
  font-size: 34rpx;
  line-height: 1.35;
  color: #ffffff;
  font-weight: 700;
}

.booking-card-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8d8d8d;
}

.capacity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.capacity-label,
.capacity-value {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #bdbdbd;
}

.progress-track {
  height: 8rpx;
  margin-top: 8rpx;
  background: #303030;
}

.progress-bar {
  height: 100%;
  background: #ff3434;
}

.booking-action-btn {
  margin-top: 18rpx;
}

.coach-drawer-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  background: rgba(0, 0, 0, 0.72);
}

.coach-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 121;
  height: 72vh;
  padding: 24rpx 22rpx 30rpx;
  border-top: 1rpx solid #2b2b2b;
  background: #050505;
}

.coach-drawer-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.coach-drawer-title {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
}

.coach-drawer-subtitle {
  margin-top: 10rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #787878;
}

.coach-drawer-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid #2b2b2b;
  font-size: 30rpx;
  color: #8d8d8d;
}

.coach-search-input {
  width: 100%;
  height: 72rpx;
  margin-top: 22rpx;
  padding: 0 18rpx;
  border: 1rpx solid #232323;
  background: #0b0b0b;
  color: #ffffff;
  font-size: 24rpx;
}

.coach-search-placeholder {
  color: #666666;
}

.coach-drawer-scroll {
  height: calc(72vh - 170rpx);
  margin-top: 18rpx;
}

.coach-option-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #181818;
}

.coach-option-item.active {
  background: linear-gradient(90deg, rgba(255, 52, 52, 0.14) 0%, rgba(8, 8, 8, 0.92) 100%);
}

.coach-option-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid #2e2e2e;
  background: #131313;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.coach-option-main {
  flex: 1;
}

.coach-option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.coach-option-name {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

.coach-option-level {
  font-size: 18rpx;
  color: #ff4646;
}

.coach-option-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #878787;
}
