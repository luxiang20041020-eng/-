.booking-title-row {
  margin-top: 6rpx;
}

.filter-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #f9eae4;
  color: #c7452d;
  font-size: 22rpx;
  font-weight: 600;
}

.booking-type-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #eeeee7;
}

.booking-type-tab {
  min-height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: #73786e;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 22rpx;
}

.booking-type-tab.active {
  color: #ffffff;
  background: #c7452d;
  box-shadow: 0 14rpx 28rpx rgba(199, 69, 45, 0.2);
}

.booking-filter-row,
.date-scroll {
  margin-top: 18rpx;
}

.coach-filter-trigger {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 240rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 24rpx;
  background: #ffffff;
}

.coach-filter-trigger.active {
  border-color: #c7452d;
}

.coach-filter-label {
  font-size: 24rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-filter-arrow {
  font-size: 20rpx;
  color: #7c8076;
}

.booking-result-count {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #7c8076;
  font-weight: 600;
}

.date-card {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 112rpx;
  height: 118rpx;
  margin-right: 12rpx;
  padding: 16rpx 14rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 16rpx;
  background: #ffffff;
}

.date-card.active {
  border-color: #c7452d;
  background: #f9eae4;
}

.date-card-kicker {
  font-size: 22rpx;
  color: #7c8076;
  font-weight: 600;
}

.date-card-label {
  font-size: 28rpx;
  color: #20251f;
  font-weight: 600;
  line-height: 1.2;
}

.booking-schedule-card {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(32, 37, 31, 0.05);
}

.booking-time-block {
  width: 122rpx;
  min-height: 184rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  background: #20251f;
}

.booking-time-main {
  font-size: 43rpx;
  line-height: 1;
  color: #ffffff;
  font-weight: 600;
}

.booking-time-sub {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.62);
  font-weight: 600;
}

.booking-card-main {
  flex: 1;
  min-width: 0;
}

.booking-card-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #c7452d;
  font-size: 22rpx;
  font-weight: 600;
}

.booking-card-status.is-disabled {
  background: #d8dde7;
  color: #73786e;
}

.booking-card-status.is-booked {
  background: #20251f;
  color: #ffffff;
}

.booking-card-title {
  margin-top: 14rpx;
  font-size: 32rpx;
  line-height: 1.35;
  color: #20251f;
  font-weight: 600;
}

.booking-card-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #7c8076;
  font-weight: 700;
}

.capacity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.capacity-label,
.capacity-value {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #73786e;
  font-weight: 600;
}

.progress-track {
  height: 10rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: #e9e9e1;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #c7452d;
}

.booking-action-btn {
  margin-top: 18rpx;
}

.pricing-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 600;
}

.pricing-tag.is-private {
  background: #20251f;
}

.pricing-tag.is-group {
  background: #c7452d;
}

.coach-drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  background: rgba(32, 37, 31, 0.45);
  backdrop-filter: blur(10px);
}

.coach-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 121;
  height: 74vh;
  padding: 28rpx 24rpx 34rpx;
  border-radius: 16rpx 42rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -24rpx 80rpx rgba(32, 37, 31, 0.18);
}

.coach-drawer-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.coach-drawer-title {
  font-size: 32rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-drawer-subtitle {
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #7c8076;
  font-weight: 700;
}

.coach-drawer-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #eeeee7;
  font-size: 34rpx;
  color: #20251f;
  font-weight: 700;
}

.coach-search-input {
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 24rpx;
  background: #f7f7f2;
  color: #20251f;
  font-size: 24rpx;
}

.coach-drawer-scroll {
  height: calc(74vh - 182rpx);
  margin-top: 18rpx;
}

.coach-option-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #e9e9e1;
}

.coach-option-item.active {
  border-radius: 16rpx;
  background: #f9eae4;
}

.coach-option-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 22rpx;
  background: #20251f;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.coach-option-main {
  flex: 1;
  min-width: 0;
}

.coach-option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.coach-option-name {
  font-size: 28rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-option-level {
  font-size: 22rpx;
  color: #c7452d;
  font-weight: 600;
}

.coach-option-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #7c8076;
}
