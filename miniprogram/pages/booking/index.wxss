t-child{flex:1;min-width:0}.coach-drawer-close{flex-shrink:0;margin-left:16rpx}.coach-drawer .coach-option-item{align-items:center}.coach-option-avatar{flex-shrink:0}.coach-summary{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.coach-more-hint{padding:24rpx;text-align:center;color:#93968c;font-size:22rpx;line-height:1.5}.private-time-card{margin-top:24rpx}.private-time-grid{display:flex;gap:20rpx;margin:24rpx 0}.private-time-grid .private-time-picker{flex:1;min-width:0;background:#f4f4ed;border-radius:16rpx;padding:20rpx}.private-time-value{font-size:40rpx;font-weight:600;margin-top:12rpx}.private-busy-list{display:flex;flex-wrap:wrap;gap:12rpx;margin:20rpx 0}.private-busy-list text{padding:10rpx;background:#eff0e9;border-radius:8rpx;font-size:24rpx}.private-note{margin:20rpx 0;line-height:1.7}.locale-page .private-time-card button,.locale-page .private-pending button{width:100%;margin-top:24rpx}
