.booking-title-row {
  margin-top: 6rpx;
}

.filter-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #f9eae4;
  color: #c7452d;
  font-size: 22rpx;
  font-weight: 600;
}

.booking-type-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #eeeee7;
}

.booking-type-tab {
  min-height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  color: #73786e;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 22rpx;
}

.booking-type-tab.active {
  color: #ffffff;
  background: #c7452d;
  box-shadow: 0 14rpx 28rpx rgba(199, 69, 45, 0.2);
}

.booking-filter-row,
.date-scroll {
  margin-top: 18rpx;
}

.coach-filter-trigger {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 240rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 24rpx;
  background: #ffffff;
}

.coach-filter-trigger.active {
  border-color: #c7452d;
}

.coach-filter-label {
  font-size: 24rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-filter-arrow {
  font-size: 20rpx;
  color: #7c8076;
}

.booking-result-count {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #7c8076;
  font-weight: 600;
}

.date-card {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 112rpx;
  height: 118rpx;
  margin-right: 12rpx;
  padding: 16rpx 14rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 16rpx;
  background: #ffffff;
}

.date-card.active {
  border-color: #c7452d;
  background: #f9eae4;
}

.date-card-kicker {
  font-size: 22rpx;
  color: #7c8076;
  font-weight: 600;
}

.date-card-label {
  font-size: 28rpx;
  color: #20251f;
  font-weight: 600;
  line-height: 1.2;
}

.booking-schedule-section { margin-top: 32rpx; }
.booking-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 0 4rpx 4rpx; }
.booking-section-heading .section-title { color: #20251f; font-size: 28rpx; }
.booking-section-hint { font-size: 21rpx; color: #92968b; }
.booking-schedule-card { margin-top: 20rpx; padding: 28rpx; border: 1rpx solid #e4e5dc; border-radius: 24rpx; background: #ffffff; }
.booking-card-header { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.booking-time-range { display: flex; align-items: baseline; gap: 12rpx; white-space: nowrap; }
.booking-time-main { font-size: 46rpx; line-height: 1.15; letter-spacing: -1rpx; color: #20251f; font-weight: 700; }
.booking-time-divider { color: #b2b6aa; font-size: 24rpx; }
.booking-time-end { font-size: 30rpx; font-weight: 500; color: #73786e; }
.booking-card-status { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; color: #597251; background: #f0f4ed; padding: 8rpx 12rpx; border-radius: 10rpx; font-size: 21rpx; font-weight: 500; white-space: nowrap; }
.booking-status-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: currentColor; }
.booking-card-status.is-disabled { background: #f1f1eb; color: #8a8e83; }
.booking-card-status.is-booked { background: #fbede7; color: #b8442d; }
.booking-card-info { margin-top: 26rpx; }
.booking-course-type { font-size: 21rpx; color: #b8442d; letter-spacing: 1rpx; }
.booking-course-type.is-private { color: #73786e; }
.booking-card-title { margin-top: 8rpx; font-size: 36rpx; line-height: 1.4; color: #20251f; font-weight: 600; word-break: break-word; }
.booking-card-meta { display: flex; align-items: baseline; gap: 16rpx; margin-top: 12rpx; font-size: 23rpx; line-height: 1.5; }
.booking-meta-label { flex-shrink: 0; color: #92968b; }
.booking-meta-value { min-width: 0; color: #63695e; word-break: break-word; }
.booking-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #eeefe8; }
.booking-capacity { flex: 1; min-width: 0; }
.capacity-label { font-size: 21rpx; color: #92968b; }
.capacity-value { margin-top: 8rpx; font-size: 27rpx; color: #535b4e; font-weight: 600; line-height: 1.4; }
.booking-action-area { flex: 0 1 250rpx; width: 250rpx; max-width: 55%; min-width: 0; text-align: center; }
/* 覆盖原生 button 的尺寸规则，按钮始终以操作区为边界。 */
.booking-action-area button.booking-action-btn { width: 100%; min-width: 0; max-width: 100%; margin: 0; box-sizing: border-box; min-height: 80rpx; display: flex; align-items: center; justify-content: center; padding: 14rpx 20rpx; border-radius: 14rpx; background: #c7452d; color: #ffffff; font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.booking-action-area button.booking-action-btn[disabled] { background: #e8eae2; color: #8a8e83; }
.booking-action-area button.booking-action-btn.is-booked { background: #f5e9e2; color: #b8442d; }
.booking-action-hint { margin-top: 10rpx; color: #92968b; font-size: 20rpx; line-height: 1.4; }
.booking-schedule-card.is-full .booking-time-main { color: #73786e; }
.booking-schedule-section .empty-state { margin-top: 20rpx; padding: 48rpx 28rpx; border: 1rpx dashed #dce0d3; border-radius: 24rpx; background: #faf9f5; }

.coach-drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  background: rgba(32, 37, 31, 0.45);
  backdrop-filter: blur(10px);
}

.coach-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 121;
  height: 74vh;
  padding: 28rpx 24rpx 34rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -24rpx 80rpx rgba(32, 37, 31, 0.18);
}

.coach-drawer-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.coach-drawer-title {
  font-size: 32rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-drawer-subtitle {
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: #7c8076;
  font-weight: 700;
}

.coach-drawer-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #eeeee7;
  font-size: 34rpx;
  color: #20251f;
  font-weight: 700;
}

.coach-search-input {
  width: 100%;
  height: 76rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 24rpx;
  background: #f7f7f2;
  color: #20251f;
  font-size: 24rpx;
}

.coach-drawer-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  overflow-y: auto;
  margin-top: 18rpx;
}

.coach-option-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid #e9e9e1;
}

.coach-option-item.active {
  border-radius: 16rpx;
  background: #f9eae4;
}

.coach-option-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 22rpx;
  background: #20251f;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.coach-option-main {
  flex: 1;
  min-width: 0;
}

.coach-option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.coach-option-name {
  font-size: 28rpx;
  color: #20251f;
  font-weight: 600;
}

.coach-option-level {
  font-size: 22rpx;
  color: #c7452d;
  font-weight: 600;
}

.coach-option-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #7c8076;
}

