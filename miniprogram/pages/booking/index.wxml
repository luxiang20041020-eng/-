<view class="page-shell">
  <view class="page-header">
    <view class="eyebrow">BOOKING · 选课 · 扣课课时</view>
    <view class="headline-row booking-title-row">
      <view class="page-title">预约大厅</view>
      <view class="filter-mark">FLT</view>
    </view>
    <view class="page-subtitle">{{pageData.currentStore.name}} · 当前余额 G {{pageData.assets.groupCount}} / P {{pageData.assets.privateCount}}</view>
  </view>

  <view class="card">
    <view class="booking-type-switch">
      <view class="booking-type-tab {{pageData.filters.type === 'group' ? 'active' : ''}}" data-type="group" bindtap="onTypeChange">团课 GROUP</view>
      <view class="booking-type-tab {{pageData.filters.type === 'private' ? 'active' : ''}}" data-type="private" bindtap="onTypeChange">私教 PRIVATE</view>
    </view>

    <scroll-view class="scroll-row filter-scroll" scroll-x="true" show-scrollbar="false">
      <view class="scroll-chip" wx:for="{{runtime.stores}}" wx:key="id">
        <view class="filter-chip {{item.id === runtime.currentStore.id ? 'active' : ''}}" data-store-id="{{item.id}}" bindtap="onSwitchStore">{{item.name}}</view>
      </view>
    </scroll-view>

    <view class="headline-row booking-filter-row">
      <view class="coach-filter-trigger {{pageData.filters.coachId !== 'all' ? 'active' : ''}}" bindtap="onOpenCoachPicker">
        <text class="coach-filter-label">{{pageData.selectedCoachName}}</text>
        <text class="coach-filter-arrow">></text>
      </view>
      <view class="booking-result-count">{{pageData.resultCount}} 门课</view>
    </view>

    <scroll-view class="scroll-row date-scroll" scroll-x="true" show-scrollbar="false">
      <view wx:for="{{pageData.dates}}" wx:key="key" class="date-card {{pageData.filters.dateKey === item.key ? 'active' : ''}}" data-date-key="{{item.key}}" bindtap="onDateChange">
        <view class="date-card-kicker">{{item.displayWeekday}}</view>
        <view class="date-card-label">{{item.displayMonthDay}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="card">
    <view class="section-title">CLASS BOARD</view>
    <view wx:if="{{pageData.schedules.length === 0}}" class="empty-text">当前筛选条件下暂无课程，请切换日期或门店。</view>
    <view wx:for="{{pageData.schedules}}" wx:key="id" class="booking-schedule-card">
      <view class="booking-time-block">
        <view class="booking-time-main">{{item.timeStart}}</view>
        <view class="booking-time-sub">{{item.timeEnd}}</view>
      </view>
      <view class="booking-card-main">
        <view class="headline-row">
          <view class="class-tags">
            <view class="pricing-tag {{item.type === 'private' ? 'is-private' : 'is-group'}}">{{item.typeLabel}}</view>
          </view>
          <view class="booking-card-status {{item.isFull ? 'is-disabled' : item.isBooked ? 'is-booked' : ''}}">
            {{item.isBooked ? '已预约' : item.isFull ? '已满员' : '立即预约'}}
          </view>
        </view>
        <view class="booking-card-title">{{item.title}}</view>
        <view class="booking-card-meta">{{item.coachName}} · {{item.venue}}</view>
        <view class="capacity-row">
          <view class="capacity-label">CAPACITY</view>
          <view class="capacity-value">{{item.progressText}}</view>
        </view>
        <view class="progress-track">
          <view class="progress-bar" style="width: {{item.progressPercent}}%;"></view>
        </view>
        <button
          class="{{item.isBooked ? 'secondary-button' : 'primary-button'}} booking-action-btn"
          data-schedule-id="{{item.id}}"
          data-title="{{item.title}}"
          bindtap="onBook"
          disabled="{{item.isBooked || item.isFull}}"
        >
          {{item.isBooked ? '已预约' : item.isFull ? '当前满员' : '立即预约 · 扣 1 课时'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{coachPickerVisible}}" class="coach-drawer-mask" bindtap="onCloseCoachPicker"></view>
  <view wx:if="{{coachPickerVisible}}" class="coach-drawer">
    <view class="coach-drawer-header">
      <view>
        <view class="coach-drawer-title">选择教练</view>
        <view class="coach-drawer-subtitle">支持按姓名 / 头衔 / 专长搜索</view>
      </view>
      <view class="coach-drawer-close" bindtap="onCloseCoachPicker">×</view>
    </view>
    <input class="coach-search-input" placeholder="搜索姓名、头衔、专长" placeholder-class="coach-search-placeholder" value="{{coachKeyword}}" bindinput="onCoachKeywordInput" />
    <scroll-view class="coach-drawer-scroll" scroll-y="true">
      <view class="coach-option-item {{pageData.filters.coachId === 'all' ? 'active' : ''}}" data-coach-id="all" bindtap="onCoachChange">
        <view class="coach-option-avatar">ALL</view>
        <view class="coach-option-main">
          <view class="coach-option-name">全部教练</view>
          <view class="coach-option-meta">当前筛选结果 {{pageData.resultCount}} 门课</view>
        </view>
      </view>
      <view wx:for="{{pageData.filteredCoachOptions}}" wx:key="id" class="coach-option-item {{pageData.filters.coachId === item.id ? 'active' : ''}}" data-coach-id="{{item.id}}" bindtap="onCoachChange">
        <view class="coach-option-avatar">{{item.avatarText}}</view>
        <view class="coach-option-main">
          <view class="coach-option-row">
            <view class="coach-option-name">{{item.name}}</view>
            <view class="coach-option-level">{{item.levelLabel}}</view>
          </view>
          <view class="coach-option-meta">{{item.title}}</view>
          <view class="coach-option-meta">{{item.summaryText}}</view>
        </view>
      </view>
      <view wx:if="{{pageData.filteredCoachOptions.length === 0}}" class="empty-text">没有匹配到教练，请换个关键词再试。</view>
    </scroll-view>
  </view>

  <app-tabbar current="/pages/booking/index"></app-tabbar>
</view>
