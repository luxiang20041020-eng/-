<view class="page-shell">
  <view class="page-header">
    <view>
      <view class="eyebrow">ADMIN · STORE NETWORK</view>
      <view class="page-title">门店管理</view>
      <view class="page-subtitle">维护首页可选门店、营业状态与场馆地址。</view>
    </view>
    <view class="role-badge">管理员</view>
  </view>

  <view wx:if="{{!hasPermission}}" class="card">
    <view class="section-title">ACCESS DENIED</view>
    <view class="card-desc">当前账号不是管理员，无法管理门店。</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="section-title">OVERVIEW · 门店概览</view>
      <view class="metric-grid">
        <view class="metric-item">
          <view class="metric-label">TOTAL</view>
          <view class="metric-value">{{pageData.stats.total}}</view>
          <view class="metric-note">全部门店</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">OPEN</view>
          <view class="metric-value">{{pageData.stats.activeCount}}</view>
          <view class="metric-note">营业中</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">CLOSED</view>
          <view class="metric-value">{{pageData.stats.inactiveCount}}</view>
          <view class="metric-note">已停用</view>
        </view>
      </view>
    </view>

    <view class="card create-store-entry" bindtap="onOpenCreatePopup">
      <view class="create-store-mark">+</view>
      <view class="create-store-main">
        <view class="section-title">CREATE STORE</view>
        <view class="create-store-title">新增门店</view>
        <view class="card-desc">录入门店名称、地址和地图坐标。</view>
      </view>
      <view class="menu-arrow">></view>
    </view>

    <view wx:if="{{loading}}" class="page-loading">正在读取门店列表...</view>
    <view wx:elif="{{!pageData.stores.length}}" class="card">
      <view class="empty-text">暂无门店数据</view>
    </view>

    <block wx:else>
      <view wx:for="{{pageData.stores}}" wx:key="id" class="card store-card">
        <view class="headline-row store-head">
          <view class="store-title-wrap">
            <view class="store-name">{{item.name}}</view>
            <view wx:if="{{item.id === runtime.currentStore.id}}" class="current-store-label">当前选择</view>
          </view>
          <view class="store-status status-{{item.status === 1 ? 'active' : 'inactive'}}">{{item.statusLabel}}</view>
        </view>

        <view class="store-address">{{item.address || '暂未填写地址'}}</view>

        <view class="store-meta-grid">
          <view class="store-meta-item">
            <view class="meta-label">归属人员</view>
            <view class="meta-value">{{item.userCount}} 人</view>
          </view>
          <view class="store-meta-item">
            <view class="meta-label">累计排课</view>
            <view class="meta-value">{{item.scheduleCount}} 场</view>
          </view>
        </view>

        <view wx:if="{{item.longitude !== '' && item.latitude !== ''}}" class="store-coordinate">
          坐标 {{item.longitude}}, {{item.latitude}}
        </view>

        <view class="button-row store-actions">
          <button class="secondary-button" data-store-id="{{item.id}}" bindtap="onOpenEditPopup" disabled="{{submitting}}">编辑资料</button>
          <button
            class="secondary-button {{item.status === 1 ? 'status-action-off' : 'status-action-on'}}"
            data-store-id="{{item.id}}"
            bindtap="onToggleStoreStatus"
            disabled="{{submitting}}"
          >
            {{item.status === 1 ? '停用门店' : '恢复营业'}}
          </button>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{showStorePopup}}" class="modal-mask" bindtap="onCloseStorePopup">
    <view class="modal-panel" catchtap="noop">
      <view class="headline-row">
        <view class="modal-heading">
          <view class="section-title">{{editingStoreId ? 'EDIT STORE' : 'CREATE STORE'}}</view>
          <view class="modal-title">{{editingStoreId ? '编辑门店资料' : '新增门店'}}</view>
        </view>
        <view class="modal-close" bindtap="onCloseStorePopup">×</view>
      </view>

      <view class="field-block">
        <view class="field-label">门店名称</view>
        <input class="form-input" value="{{storeForm.name}}" data-field="name" maxlength="50" bindinput="onStoreFieldInput" placeholder="如：城南训练中心" placeholder-class="input-placeholder" />
      </view>

      <view class="field-block">
        <view class="field-label">详细地址</view>
        <input class="form-input" value="{{storeForm.address}}" data-field="address" maxlength="120" bindinput="onStoreFieldInput" placeholder="请输入门店详细地址" placeholder-class="input-placeholder" />
      </view>

      <view class="coordinate-fields">
        <view class="field-block">
          <view class="field-label">经度</view>
          <input class="form-input" type="digit" value="{{storeForm.longitude}}" data-field="longitude" bindinput="onStoreFieldInput" placeholder="可选" placeholder-class="input-placeholder" />
        </view>
        <view class="field-block">
          <view class="field-label">纬度</view>
          <input class="form-input" type="digit" value="{{storeForm.latitude}}" data-field="latitude" bindinput="onStoreFieldInput" placeholder="可选" placeholder-class="input-placeholder" />
        </view>
      </view>

      <view wx:if="{{!editingStoreId}}" class="field-block">
        <view class="row-between">
          <view class="field-label">创建后立即营业</view>
          <switch checked="{{storeForm.status === 1}}" color="#ff1f4f" bindchange="onCreateStatusChange" />
        </view>
      </view>

      <view class="button-row modal-button-row">
        <button class="secondary-button" bindtap="onCloseStorePopup" disabled="{{submitting}}">取消</button>
        <button class="primary-button" bindtap="onSubmitStore" loading="{{submitting}}">{{editingStoreId ? '保存修改' : '确认创建'}}</button>
      </view>
    </view>
  </view>

  <app-tabbar id="tabbar" current="/pages/admin/index"></app-tabbar>
</view>
