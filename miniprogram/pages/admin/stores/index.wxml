<wxs module="i18n" src="../../../utils/i18n.wxs" />
<media-privacy id="mediaPrivacy" language="{{language}}"></media-privacy>
<view class="page-shell locale-page locale-{{language}}">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="page-header">
    <view>
      <view class="eyebrow">{{i18n.f('门店运营管理', [], language)}}</view>
      <view class="page-title">{{i18n.f('门店管理', [], language)}}</view>
      <view class="page-subtitle">{{i18n.f('维护首页可选门店、营业状态与场馆地址。', [], language)}}</view>
    </view>
    <view class="role-badge">{{i18n.f('管理员', [], language)}}</view>
  </view>

  <view wx:if="{{!hasPermission}}" class="card">
    <view class="section-title">{{i18n.f('访问权限提示', [], language)}}</view>
    <view class="card-desc">{{i18n.f('当前账号不是管理员，无法管理门店。', [], language)}}</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="section-title">{{i18n.f('门店概览', [], language)}}</view>
      <view class="metric-grid">
        <view class="metric-item">
          <view class="metric-label">{{i18n.f('总计', [], language)}}</view>
          <view class="metric-value">{{pageData.stats.total}}</view>
          <view class="metric-note">{{i18n.f('全部门店', [], language)}}</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">{{i18n.f('营业中', [], language)}}</view>
          <view class="metric-value">{{pageData.stats.activeCount}}</view>
          <view class="metric-note">{{i18n.f('营业中', [], language)}}</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">{{i18n.f('已停用', [], language)}}</view>
          <view class="metric-value">{{pageData.stats.inactiveCount}}</view>
          <view class="metric-note">{{i18n.f('已停用', [], language)}}</view>
        </view>
      </view>
    </view>

    <view class="card create-store-entry" bindtap="onOpenCreatePopup">
      <view class="create-store-mark">+</view>
      <view class="create-store-main">
        <view class="section-title">{{i18n.f('创建训练空间', [], language)}}</view>
        <view class="create-store-title">{{i18n.f('新增门店', [], language)}}</view>
        <view class="card-desc">{{i18n.f('录入门店名称、地址和地图坐标。', [], language)}}</view>
      </view>
      <view class="menu-arrow">></view>
    </view>

    <view wx:if="{{loading}}" class="page-loading">{{i18n.f('正在读取门店列表...', [], language)}}</view>
    <view wx:elif="{{!pageData.stores.length}}" class="card">
      <view class="empty-text">{{i18n.f('暂无门店数据', [], language)}}</view>
    </view>

    <block wx:else>
      <view wx:for="{{pageData.stores}}" wx:key="id" class="card store-card">
        <view class="headline-row store-head">
          <view class="store-title-wrap">
            <view class="store-name">{{item.name}}</view>
            <view wx:if="{{item.id === runtime.currentStore.id}}" class="current-store-label">{{i18n.f('当前选择', [], language)}}</view>
          </view>
          <view class="store-status status-{{item.status === 1 ? 'active' : 'inactive'}}">{{i18n.t(item.statusLabel, language)}}</view>
        </view>

        <view class="store-address">{{item.address || i18n.t('暂未填写地址', language)}}</view>

        <view class="store-meta-grid">
          <view class="store-meta-item">
            <view class="meta-label">{{i18n.f('归属人员', [], language)}}</view>
            <view class="meta-value">{{i18n.f('{0} 人', [item.userCount], language)}}</view>
          </view>
          <view class="store-meta-item">
            <view class="meta-label">{{i18n.f('累计排课', [], language)}}</view>
            <view class="meta-value">{{i18n.f('{0} 场', [item.scheduleCount], language)}}</view>
          </view>
        </view>

        <view wx:if="{{item.longitude !== '' && item.latitude !== ''}}" class="store-coordinate">{{i18n.f('坐标 {0}, {1}', [item.longitude, item.latitude], language)}}</view>

        <view class="store-gallery-entry" data-store-id="{{item.id}}" bindtap="onOpenGallery" hover-class="tap-feedback">
          <image wx:if="{{item.gallery.length}}" class="store-gallery-cover" src="{{item.gallery[0].url}}" mode="aspectFill"></image>
          <view class="store-gallery-copy"><view class="field-label">{{i18n.f('首页实景图片', [], language)}}</view><view class="card-desc">{{i18n.f('添加、更换图片与说明', [], language)}}</view></view><text>›</text>
        </view>

        <view class="button-row store-actions">
          <button class="secondary-button" data-store-id="{{item.id}}" bindtap="onOpenEditPopup" disabled="{{submitting}}">{{i18n.f('编辑资料', [], language)}}</button>
          <button
            class="secondary-button {{item.status === 1 ? 'status-action-off' : 'status-action-on'}}"
            data-store-id="{{item.id}}"
            bindtap="onToggleStoreStatus"
            disabled="{{submitting}}"
          >
            {{i18n.t(item.status === 1 ? '停用门店' : '恢复营业', language)}}
          </button>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{showStorePopup}}" class="modal-mask" bindtap="onCloseStorePopup">
    <view class="modal-panel store-edit-panel" catchtap="noop">
      <view class="headline-row">
        <view class="modal-heading">
          <view class="section-title">{{i18n.t(editingStoreId ? '更新门店资料' : '创建训练空间', language)}}</view>
          <view class="modal-title">{{i18n.t(editingStoreId ? '编辑门店资料' : '新增门店', language)}}</view>
        </view>
        <view class="modal-close" bindtap="onCloseStorePopup">×</view>
      </view>

      <scroll-view class="store-edit-scroll" scroll-y="true">
      <view class="field-block">
        <view class="field-label">{{i18n.f('门店名称', [], language)}}</view>
        <input class="form-input" value="{{storeForm.name}}" data-field="name" maxlength="50" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('如：城南训练中心', [], language)}}" placeholder-class="input-placeholder" />
      </view>

      <view class="field-block">
        <view class="field-label">{{i18n.f('详细地址', [], language)}}</view>
        <input class="form-input" value="{{storeForm.address}}" data-field="address" maxlength="120" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('请输入门店详细地址', [], language)}}" placeholder-class="input-placeholder" />
      </view>

      <view class="coordinate-fields">
        <view class="field-block">
          <view class="field-label">{{i18n.f('经度', [], language)}}</view>
          <input class="form-input" type="text" value="{{storeForm.longitude}}" data-field="longitude" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('可选', [], language)}}" placeholder-class="input-placeholder" />
        </view>
        <view class="field-block">
          <view class="field-label">{{i18n.f('纬度', [], language)}}</view>
          <input class="form-input" type="text" value="{{storeForm.latitude}}" data-field="latitude" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('可选', [], language)}}" placeholder-class="input-placeholder" />
        </view>
      </view>

      <button class="secondary-button store-map-pick" bindtap="onPickStoreLocation" loading="{{storeLocating}}" disabled="{{submitting || storeLocating}}">{{i18n.f('地图选点', [], language)}}</button><view class="store-form-hint">{{i18n.f('地图选点会同时更新地址和坐标。', [], language)}}</view>
      <view class="field-block"><view class="field-label">{{i18n.f('门店介绍', [], language)}}</view><view class="store-textarea-shell"><textarea value="{{storeForm.introduction}}" data-field="introduction" maxlength="1200" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('介绍场馆特色、训练环境与课程', [], language)}}" placeholder-class="input-placeholder" /></view></view>
      <view class="field-block"><view class="field-label">{{i18n.f('营业时间', [], language)}}</view><input class="form-input" value="{{storeForm.businessHours}}" data-field="businessHours" maxlength="120" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('如：周一至周日 10:00–22:00', [], language)}}" placeholder-class="input-placeholder" /></view>
      <view class="field-block"><view class="field-label">{{i18n.f('联系电话', [], language)}}</view><input class="form-input" value="{{storeForm.phone}}" data-field="phone" maxlength="30" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('可填写国家区号和联系电话', [], language)}}" placeholder-class="input-placeholder" /></view>
      <view class="field-block"><view class="field-label">{{i18n.f('到店指引', [], language)}}</view><view class="store-textarea-shell store-arrival-shell"><textarea value="{{storeForm.arrivalTips}}" data-field="arrivalTips" maxlength="300" bindinput="onStoreFieldInput" disabled="{{submitting || storeLocating}}" placeholder="{{i18n.f('如：地铁出口、楼层入口、停车方式', [], language)}}" placeholder-class="input-placeholder" /></view></view>

      <view wx:if="{{!editingStoreId}}" class="field-block">
        <view class="row-between">
          <view class="field-label">{{i18n.f('创建后立即营业', [], language)}}</view>
          <switch checked="{{storeForm.status === 1}}" color="#c7452d" bindchange="onCreateStatusChange" disabled="{{submitting || storeLocating}}" />
        </view>
      </view>

      </scroll-view>
      <view class="button-row modal-button-row">
        <button class="secondary-button" bindtap="onCloseStorePopup" disabled="{{submitting || storeLocating}}">{{i18n.f('取消', [], language)}}</button>
        <button class="primary-button" bindtap="onSubmitStore" loading="{{submitting}}" disabled="{{storeLocating}}">{{i18n.t(editingStoreId ? '保存修改' : '确认创建', language)}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showGalleryPopup}}" class="modal-mask gallery-mask" bindtap="onCloseGallery">
    <view class="modal-panel gallery-panel" catchtap="noop">
      <view class="headline-row"><view class="modal-heading"><view class="section-title">{{galleryStoreName}}</view><view class="modal-title">{{i18n.f('首页实景图片', [], language)}}</view></view><button class="modal-close gallery-close" bindtap="onCloseGallery" disabled="{{galleryBusy}}">×</button></view>
      <view class="gallery-hint">{{i18n.f('最多6张，按列表顺序展示；保存后更新首页。', [], language)}}</view>
      <scroll-view class="gallery-scroll" scroll-y="true">
        <view wx:for="{{galleryDraft}}" wx:key="url" class="gallery-photo-card">
          <image class="gallery-photo" src="{{item.url}}" mode="aspectFill" data-index="{{index}}" bindtap="onPreviewGalleryPhoto"></image>
          <view class="gallery-photo-body"><view class="gallery-photo-number">{{i18n.f('图片 {0}', [index + 1], language)}}</view><input class="form-input gallery-caption-input" value="{{item.title}}" maxlength="40" placeholder="{{i18n.f('图片说明（可选）', [], language)}}" placeholder-class="input-placeholder" data-index="{{index}}" bindinput="onGalleryTitleInput" disabled="{{galleryBusy}}" /><view class="button-row gallery-photo-actions"><button class="secondary-button" data-index="{{index}}" bindtap="onChooseGalleryPhoto" disabled="{{galleryBusy}}">{{i18n.f('更换图片', [], language)}}</button><button class="secondary-button gallery-remove" data-index="{{index}}" bindtap="onRemoveGalleryPhoto" disabled="{{galleryBusy}}">{{i18n.f('删除', [], language)}}</button></view></view>
        </view>
        <view wx:if="{{!galleryDraft.length}}" class="gallery-empty">{{i18n.f('暂无图片，保存后首页将隐藏实景模块。', [], language)}}</view>
        <button wx:if="{{galleryDraft.length < 6}}" class="secondary-button gallery-add" bindtap="onChooseGalleryPhoto" disabled="{{galleryBusy}}">{{i18n.f('添加场馆图片', [], language)}}</button>
        <button class="gallery-reset" bindtap="onResetGallery" disabled="{{galleryBusy}}">{{i18n.f('恢复默认图片', [], language)}}</button>
      </scroll-view>
      <view wx:if="{{galleryError}}" class="gallery-error">{{i18n.t(galleryError, language)}}</view>
      <button class="primary-button gallery-save" bindtap="onSaveGallery" loading="{{galleryBusy}}" disabled="{{galleryBusy}}">{{i18n.t(galleryBusy ? '正在处理图片…' : '保存门店图片', language)}}</button>
    </view>
  </view>

  <app-tabbar id="tabbar" current="/pages/admin/index"></app-tabbar>
</view>
