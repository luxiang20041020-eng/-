.metric-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.create-store-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-color: #ffd2dc;
  background: #fffafa;
}

.create-store-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #ff1f4f;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
}

.create-store-main {
  flex: 1;
  min-width: 0;
}

.create-store-title {
  margin-top: 8rpx;
  color: #07142f;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 900;
}

.store-card {
  padding: 24rpx;
}

.store-head {
  align-items: flex-start;
}

.store-title-wrap {
  flex: 1;
  min-width: 0;
}

.store-name {
  color: #07142f;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 900;
  word-break: break-word;
}

.current-store-label {
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  margin-top: 10rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #07142f;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
}

.store-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.store-status.status-active {
  background: #ff1f4f;
  color: #ffffff;
}

.store-status.status-inactive {
  background: #eef1f6;
  color: #697386;
}

.store-address {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 22rpx;
  background: #f8f9fc;
  color: #5f697c;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-word;
}

.store-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.store-meta-item {
  padding: 16rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 22rpx;
  background: #ffffff;
}

.meta-label {
  color: #7d8798;
  font-size: 18rpx;
  font-weight: 900;
}

.meta-value {
  margin-top: 8rpx;
  color: #07142f;
  font-size: 26rpx;
  font-weight: 900;
}

.store-coordinate {
  margin-top: 14rpx;
  color: #7d8798;
  font-size: 20rpx;
  line-height: 1.45;
}

.store-actions {
  margin-top: 20rpx;
}

.status-action-off {
  border-color: #ffd2dc;
  background: #fff1f5;
  color: #ff1f4f;
}

.status-action-on {
  border-color: #ff1f4f;
  background: #ff1f4f;
  color: #ffffff;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(7, 20, 47, 0.45);
  backdrop-filter: blur(10px);
}

.modal-panel {
  width: 100%;
  max-height: 84vh;
  padding: 28rpx;
  border: 1rpx solid #ffe1e8;
  border-radius: 38rpx;
  background: #ffffff;
  overflow-y: auto;
  box-shadow: 0 30rpx 80rpx rgba(8, 20, 47, 0.18);
}

.modal-heading {
  flex: 1;
  min-width: 0;
}

.modal-title {
  margin-top: 8rpx;
  color: #07142f;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 900;
}

.modal-close {
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #f3f5f9;
  color: #07142f;
  font-size: 34rpx;
  line-height: 54rpx;
  text-align: center;
  font-weight: 700;
}

.coordinate-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.modal-button-row {
  margin-top: 28rpx;
}
