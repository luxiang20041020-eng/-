.toolbar-row {
  margin-top: 14rpx;
}

.clear-button {
  width: auto;
  min-width: 110rpx;
  min-height: 62rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.user-card {
  padding: 22rpx;
}

.user-head {
  align-items: flex-start;
  gap: 16rpx;
}

.user-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.user-avatar {
  flex-shrink: 0;
}

.user-text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.user-name {
  font-size: 32rpx;
  line-height: 1.2;
  color: #20251f;
  font-weight: 600;
}

.self-chip {
  min-height: 38rpx;
  padding: 0 12rpx;
  font-size: 18rpx;
}

.user-phone {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8076;
}

.user-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.user-role-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eeeee7;
  color: #20251f;
  font-size: 22rpx;
  font-weight: 600;
}

.user-role-chip.role-admin {
  background: #c7452d;
  color: #ffffff;
}

.user-role-chip.role-coach {
  background: #20251f;
  color: #ffffff;
}

.user-role-chip.role-client {
  background: #e9e9e1;
  color: #73786e;
}

.store-chip {
  min-height: 40rpx;
  padding: 0 14rpx;
  font-size: 18rpx;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-item {
  padding: 16rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 22rpx;
  background: #f7f7f2;
}

.meta-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7c8076;
  font-weight: 600;
}

.meta-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #20251f;
  font-weight: 600;
}

.role-action-button {
  margin-top: 18rpx;
}

.metric-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.metric-item { padding: 20rpx 12rpx; text-align: center; }
.metric-value { font-size: 42rpx; }
.metric-note { font-size: 22rpx; line-height: 1.5; }
