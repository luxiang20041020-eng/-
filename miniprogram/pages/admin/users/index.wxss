.toolbar-row {
  margin-top: 14rpx;
}

.clear-button {
  width: auto;
  min-width: 110rpx;
  min-height: 62rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.user-card {
  padding: 22rpx;
}

.user-head {
  align-items: flex-start;
  gap: 16rpx;
}

.user-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.user-avatar {
  flex-shrink: 0;
}

.user-text {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.user-name {
  font-size: 32rpx;
  line-height: 1.2;
  color: #07142f;
  font-weight: 900;
}

.self-chip {
  min-height: 38rpx;
  padding: 0 12rpx;
  font-size: 18rpx;
}

.user-phone {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7d8798;
}

.user-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.user-role-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f3f5f9;
  color: #07142f;
  font-size: 22rpx;
  font-weight: 900;
}

.user-role-chip.role-admin {
  background: #ff1f4f;
  color: #ffffff;
}

.user-role-chip.role-coach {
  background: #07142f;
  color: #ffffff;
}

.user-role-chip.role-client {
  background: #eef1f6;
  color: #697386;
}

.store-chip {
  min-height: 40rpx;
  padding: 0 14rpx;
  font-size: 18rpx;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-item {
  padding: 16rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 22rpx;
  background: #f8f9fc;
}

.meta-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7d8798;
  font-weight: 900;
}

.meta-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #07142f;
  font-weight: 900;
}

.role-action-button {
  margin-top: 18rpx;
}
