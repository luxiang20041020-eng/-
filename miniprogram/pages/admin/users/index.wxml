<wxs module="i18n" src="../../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} manage-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="manage-hero"><view class="hero-eyebrow">ONE / PEOPLE &amp; ACCESS</view><view class="row-between"><view class="hero-title">{{i18n.f('人员权限', [], language)}}</view><button wx:if="{{hasPermission}}" class="hero-add" disabled="{{submittingUserId || creatingUser || pageBusy || pageError}}" bindtap="onOpenCreate">{{i18n.f('＋ 录入新用户', [], language)}}</button><text wx:else class="hero-badge">{{i18n.f('管理员', [], language)}}</text></view><view class="hero-caption">{{i18n.f('清楚分工，让每个人拥有合适的权限。', [], language)}}</view></view>
  <view wx:if="{{!hasPermission && !pageBusy}}" class="manage-card"><view class="section-title">{{i18n.f('需要管理员权限', [], language)}}</view><view class="card-description">{{i18n.f('当前账号无法查看或调整人员身份。', [], language)}}</view></view>
  <block wx:if="{{hasPermission}}">
    <view class="manage-filters"><input class="form-input manage-search" maxlength="40" value="{{keyword}}" bindinput="onKeywordInput" placeholder="{{i18n.f('搜索姓名、手机号或门店', [], language)}}" /><view class="filter-strip"><view class="filter-pill {{roleFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="onRoleFilter">{{i18n.f('全部', [], language)}}<text class="filter-count">{{roleCounts.all}}</text></view><view class="filter-pill {{roleFilter === '1' ? 'active' : ''}}" data-value="1" bindtap="onRoleFilter">{{i18n.f('客户', [], language)}}<text class="filter-count">{{roleCounts.client}}</text></view><view class="filter-pill {{roleFilter === '2' ? 'active' : ''}}" data-value="2" bindtap="onRoleFilter">{{i18n.f('教练', [], language)}}<text class="filter-count">{{roleCounts.coach}}</text></view><view class="filter-pill {{roleFilter === '3' ? 'active' : ''}}" data-value="3" bindtap="onRoleFilter">{{i18n.f('管理员', [], language)}}<text class="filter-count">{{roleCounts.admin}}</text></view></view><view class="small-filter-row"><view class="small-filter {{statusFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="onStatusFilter">{{i18n.f('全部状态', [], language)}}</view><view class="small-filter {{statusFilter === '1' ? 'active' : ''}}" data-value="1" bindtap="onStatusFilter">{{i18n.f('正常账号', [], language)}}</view><view class="small-filter {{statusFilter === '0' ? 'active' : ''}}" data-value="0" bindtap="onStatusFilter">{{i18n.f('停用账号', [], language)}}</view></view></view>
    <view class="list-heading"><view class="section-title">{{i18n.f('人员列表', [], language)}}<text class="muted">{{i18n.f('{0} 人', [visibleUsers.length], language)}}</text></view><button wx:if="{{keyword || roleFilter !== 'all' || statusFilter !== 'all'}}" class="text-action" bindtap="onResetFilters">{{i18n.f('重置筛选', [], language)}}</button></view>
    <view wx:if="{{!visibleUsers.length && !pageBusy && !pageError}}" class="manage-empty"><view class="section-title">{{i18n.f('暂无匹配人员', [], language)}}</view><view class="muted">{{i18n.f('换个关键词，或调整身份与状态筛选。', [], language)}}</view><button class="text-action" bindtap="onResetFilters">{{i18n.f('查看全部人员', [], language)}}</button></view>
    <view wx:for="{{visibleUsers}}" wx:key="id" class="manage-card">
      <view class="card-top"><view class="person-avatar">{{item.avatarText}}</view><view class="card-main"><view class="item-name">{{item.name}}<text wx:if="{{item.id === pageData.currentUserId}}" class="self-label">{{i18n.f('当前账号', [], language)}}</text></view><view class="item-subtitle">{{item.phone || i18n.t('未绑定手机号', language)}}</view></view><view class="role-label {{item.roleKey}}">{{i18n.t(item.roleLabel, language)}}</view></view>
      <view class="card-meta"><text class="status-label {{item.status === 1 ? '' : 'inactive'}}">{{i18n.t(item.statusLabel, language)}}</text><text>{{item.homeStoreName || i18n.t('未分配门店', language)}}</text></view>
      <view class="card-description">{{i18n.t(item.permissionSummary, language)}}</view>
      <button wx:if="{{item.role === 1}}" class="customer-asset-entry" data-user-id="{{item.id}}" disabled="{{creatingUser || submittingUserId}}" bindtap="onViewAssets">
        <view class="asset-entry-heading"><text>{{i18n.f('剩余套餐', [], language)}}</text><text class="change-link">{{i18n.f('查看详情 ›', [], language)}}</text></view>
        <view wx:if="{{item.assets}}" class="asset-entry-counts"><view>{{i18n.f('团课', [], language)}}<text>{{item.assets.groupUnlimited ? i18n.t('无限', language) : item.assets.groupCount}}</text>{{i18n.f('次', [], language)}}</view><view>{{i18n.f('私教', [], language)}}<text>{{item.assets.privateUnlimited ? i18n.t('无限', language) : item.assets.privateCount}}</text>{{i18n.f('次', [], language)}}</view></view>
        <view wx:else class="muted">{{i18n.f('查看剩余课时与有效期', [], language)}}</view>
      </button>
      <view class="card-footer"><view class="muted">{{i18n.t(item.id === pageData.currentUserId ? '当前账号的管理员权限已保护' : '调整身份与可用功能', language)}}</view><button wx:if="{{item.id !== pageData.currentUserId}}" class="card-action" data-user-id="{{item.id}}" loading="{{submittingUserId === item.id}}" disabled="{{submittingUserId || pageBusy || pageError}}" bindtap="onChangeRole">{{i18n.f('调整权限 ›', [], language)}}</button></view>
    </view>
  </block>
  <view wx:if="{{roleEditorUser}}" class="sheet-mask"><view class="manage-sheet"><view class="sheet-header"><view><view class="section-title">{{i18n.f('调整身份权限', [], language)}}</view><view class="muted">{{roleEditorUser.name}} · {{roleEditorUser.phone}}</view></view><button class="sheet-close" disabled="{{submittingUserId}}" bindtap="onCloseRoleEditor">{{i18n.f('关闭', [], language)}}</button></view><scroll-view scroll-y class="sheet-scroll"><view class="sheet-body"><view wx:for="{{pageData.roleOptions}}" wx:key="value" class="choice-card {{nextRole === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onChooseRole"><view class="row-between"><view class="section-title">{{i18n.t(item.label, language)}}</view><text class="change-link">{{i18n.t(nextRole === item.value ? '✓ 已选择' : '', language)}}</text></view><view class="muted">{{i18n.t(item.description, language)}}</view></view><view class="change-preview"><view>{{i18n.t(roleEditorUser.roleLabel, language)}} → {{i18n.t(selectedRole.label, language)}}</view><view class="muted">{{i18n.f('身份变更不会改变已有课时和预约。{0}', [i18n.t(roleEditorUser.status === 0 ? '此账号仍为停用状态，本次不会启用账号。' : '', language)], language)}}</view></view></view></scroll-view><view class="sheet-actions"><button class="primary-button" disabled="{{submittingUserId || nextRole === roleEditorUser.role || pageBusy || pageError}}" loading="{{submittingUserId}}" bindtap="onConfirmRole">{{i18n.t(submittingUserId ? '正在更新…' : '确认变更权限', language)}}</button></view></view></view>
  <view wx:if="{{showCreatePopup && hasPermission}}" class="sheet-mask">
    <view class="manage-sheet create-user-sheet">
      <view class="sheet-header"><view><view class="section-title">{{i18n.f('录入新用户', [], language)}}</view><view class="muted">{{i18n.f('先建客户档案，再派发训练权益。', [], language)}}</view></view><button class="sheet-close" disabled="{{creatingUser}}" bindtap="onCloseCreatePopup">{{i18n.f('关闭', [], language)}}</button></view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="sheet-body">
          <view class="field-block"><view class="field-label">{{i18n.f('姓名', [], language)}}</view><input class="form-input" maxlength="20" value="{{createForm.name}}" data-field="name" bindinput="onCreateInput" disabled="{{creatingUser}}" placeholder="{{i18n.f('填写客户姓名', [], language)}}" /></view>
          <view class="field-block"><view class="field-label">{{i18n.f('手机号', [], language)}}</view><input class="form-input" type="number" maxlength="11" value="{{createForm.phone}}" data-field="phone" bindinput="onCreateInput" disabled="{{creatingUser}}" placeholder="{{i18n.f('填写本人11位手机号', [], language)}}" /><view class="muted field-hint">{{i18n.f('客户之后使用此手机号登录，将关联已有档案与权益。', [], language)}}</view></view>
          <view class="field-block"><view class="field-label">{{i18n.f('所属门店', [], language)}}</view><picker mode="selector" range="{{pageData.stores}}" range-key="name" value="{{createStoreIndex}}" disabled="{{creatingUser}}" bindchange="onCreateStoreChange"><view class="store-picker row-between"><text>{{createStoreName || i18n.t('请选择门店', language)}}</text><text>⌄</text></view></picker></view>
          <view class="change-preview"><view>{{i18n.f('初始身份：客户', [], language)}}</view><view class="muted">{{i18n.f('录入后可立即派发权益或登记线下训练。教练和管理员身份可在人员列表中调整。', [], language)}}</view></view>
          <view wx:if="{{createError}}" class="create-user-error">{{i18n.t(createError, language)}}</view>
        </view>
      </scroll-view>
      <view class="sheet-actions"><button class="primary-button" disabled="{{creatingUser || pageBusy || pageError}}" loading="{{creatingUser}}" bindtap="onCreateUser">{{i18n.t(creatingUser ? '正在录入…' : '保存用户档案', language)}}</button></view>
    </view>
  </view>
  <view wx:if="{{assetsUser && hasPermission}}" class="sheet-mask">
    <view class="manage-sheet customer-assets-sheet">
      <view class="sheet-header"><view><view class="section-title">{{i18n.f('客户剩余套餐', [], language)}}</view><view class="muted">{{assetsUser.name}} · {{assetsUser.phone}}</view></view><button class="sheet-close" bindtap="onCloseAssets">{{i18n.f('关闭', [], language)}}</button></view>
      <scroll-view scroll-y class="sheet-scroll">
        <view class="sheet-body">
          <view wx:if="{{assetsLoading}}" class="manage-empty"><view class="section-title">{{i18n.f('正在读取套餐余额…', [], language)}}</view><view class="muted">{{i18n.f('请稍候，余额以最新记录为准。', [], language)}}</view></view>
          <view wx:elif="{{assetsError}}" class="create-user-error"><view>{{i18n.t(assetsError, language)}}</view><button class="text-action" bindtap="onRefreshAssets">{{i18n.f('重新读取', [], language)}}</button></view>
          <block wx:elif="{{assetsDetail}}">
            <view wx:if="{{assetsUser.status !== 1}}" class="create-user-error">{{i18n.f('此客户账号已停用，课时记录保留；当前无法预约或核销。', [], language)}}</view>
            <view class="customer-balance-grid">
              <view wx:for="{{assetsDetail.balances}}" wx:key="type" class="customer-balance-card {{item.expired ? 'expired' : ''}}">
                <view class="asset-entry-heading"><view class="section-title">{{i18n.t(item.label, language)}}</view><text class="status-label {{item.unlimited || item.available > 0 ? '' : 'inactive'}}">{{i18n.t(item.statusLabel, language)}}</text></view>
                <view wx:if="{{item.unlimited}}" class="customer-balance-value">{{i18n.t('无限', language)}}</view><view wx:else class="customer-balance-value">{{item.available}}<text>{{i18n.f('次可用', [], language)}}</text></view>
                <view class="muted">{{i18n.t(item.unlimited ? '有效期至 ' + item.unlimitedExpiry : item.expiry ? '有效期至 ' + item.expiry : item.expiryLabel, language)}}</view>
                <view wx:if="{{item.unlimited}}" class="muted">{{i18n.f('次数余额 {0} 次', [item.available], language)}}</view><view wx:if="{{item.expired && item.recordedBalance > 0}}" class="expired-balance">{{i18n.f('另有 {0} 次已过期，无法使用。', [item.recordedBalance], language)}}</view>
              </view>
            </view>
            <view class="muted customer-assets-note">{{i18n.t(assetsDetail.note, language)}}</view>
            <view class="list-heading"><view class="section-title">{{i18n.f('套餐派发记录', [], language)}}</view><text class="muted">{{i18n.f('最近 {0} 笔', [assetsDetail.records.length], language)}}</text></view>
            <view wx:if="{{!assetsDetail.records.length}}" class="manage-empty"><view class="section-title">{{i18n.f('暂无套餐派发记录', [], language)}}</view><view class="muted">{{i18n.f('已建档客户可前往工作台派发权益。', [], language)}}</view></view>
            <view wx:for="{{assetsDetail.records}}" wx:key="id" class="customer-package-record"><view class="asset-entry-heading"><view class="section-title">{{item.packageName}}</view><text class="change-link">{{item.unlimited ? i18n.t('期限内无限次', language) : i18n.f('＋{0} 次', [item.lessons], language)}}</text></view><view class="muted">{{i18n.t(item.typeLabel, language)}} · {{i18n.t(item.time || '日期未记录', language)}}</view><view class="muted">{{i18n.f('实收 ¥{0} · {1}', [item.amount, i18n.t(item.payType, language)], language)}}</view><view class="muted">{{i18n.t(item.expiry ? '本次派发有效期至 ' + item.expiry : '本次派发有效期未记录', language)}}</view></view>
          </block>
        </view>
      </scroll-view>
      <view class="sheet-actions"><button class="secondary-button" loading="{{assetsLoading}}" disabled="{{assetsLoading}}" bindtap="onRefreshAssets">{{i18n.t(assetsLoading ? '正在读取…' : '刷新套餐余额', language)}}</button></view>
    </view>
  </view>
  <app-tabbar id="tabbar" current="/pages/admin/index" />
</view>
