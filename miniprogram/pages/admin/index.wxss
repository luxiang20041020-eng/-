.admin-toolbar-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.admin-toolbar-left {
  flex: 1;
  min-height: 82rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 24rpx;
  background: #f7f7f2;
}

.admin-tool-label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #7c8076;
  font-weight: 600;
}

.admin-tool-value {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #20251f;
  font-weight: 600;
}

.admin-toolbar-mid {
  color: #7c8076;
  font-size: 20rpx;
}

.admin-mini-btn {
  width: 120rpx;
  min-height: 82rpx;
  line-height: 82rpx;
  padding: 0;
}

.audit-item {
  position: relative;
  margin-top: 18rpx;
  padding: 20rpx 20rpx 18rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.audit-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audit-time {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #7c8076;
  font-weight: 600;
}

.audit-paytype {
  font-size: 22rpx;
  color: #c7452d;
  font-weight: 600;
}

.audit-main-text {
  margin-top: 14rpx;
  padding-right: 120rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #20251f;
  font-weight: 600;
}

.audit-remark {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8076;
}

.audit-amount {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  font-size: 38rpx;
  color: #20251f;
  font-weight: 600;
}

.export-button {
  width: auto;
  min-width: 112rpx;
  min-height: 62rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.audit-header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.admin-tools-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.admin-tool-card {
  min-height: 146rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.admin-tool-card.primary {
  border-color: #ecd8cf;
  background: #f9eae4;
}

.admin-card-title {
  font-size: 28rpx;
  line-height: 1.35;
  color: #20251f;
  font-weight: 600;
}

.admin-card-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7c8076;
}

.admin-mini-btn { width: 148rpx; font-size: 22rpx; flex-shrink: 0; }
.admin-toolbar-left { min-width: 0; }
.admin-tool-value { font-size: 23rpx; line-height: 1.4; word-break: break-word; }
.metric-value { font-size: 44rpx; }
