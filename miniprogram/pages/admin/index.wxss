.admin-toolbar-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.admin-toolbar-left {
  flex: 1;
  min-height: 82rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 24rpx;
  background: #f8f9fc;
}

.admin-tool-label {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #7d8798;
  font-weight: 900;
}

.admin-tool-value {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #07142f;
  font-weight: 900;
}

.admin-toolbar-mid {
  color: #7d8798;
  font-size: 20rpx;
}

.admin-mini-btn {
  width: 120rpx;
  min-height: 82rpx;
  line-height: 82rpx;
  padding: 0;
}

.audit-item {
  position: relative;
  margin-top: 18rpx;
  padding: 20rpx 20rpx 18rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 30rpx;
  background: #ffffff;
}

.audit-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audit-time {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7d8798;
  font-weight: 900;
}

.audit-paytype {
  font-size: 18rpx;
  color: #ff1f4f;
  font-weight: 900;
}

.audit-main-text {
  margin-top: 14rpx;
  padding-right: 120rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #07142f;
  font-weight: 900;
}

.audit-remark {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7d8798;
}

.audit-amount {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  font-size: 38rpx;
  color: #07142f;
  font-weight: 900;
}

.export-button {
  width: auto;
  min-width: 112rpx;
  min-height: 62rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.admin-tools-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.admin-tool-card {
  min-height: 146rpx;
  padding: 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 30rpx;
  background: #ffffff;
}

.admin-tool-card.primary {
  border-color: #ffd2dc;
  background: #fff1f5;
}

.admin-card-title {
  font-size: 28rpx;
  line-height: 1.35;
  color: #07142f;
  font-weight: 900;
}

.admin-card-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7d8798;
}
