<wxs module="i18n" src="../../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} manage-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="manage-hero"><view class="hero-eyebrow">ONE / TRAINING PACKAGES</view><view class="row-between"><view class="hero-title">{{i18n.f('套餐管理', [], language)}}</view><button wx:if="{{hasPermission}}" class="hero-add" disabled="{{submittingPackageId || creatingPackage || pageBusy || pageError}}" bindtap="onOpenCreatePopup">{{i18n.f('＋ 新建套餐', [], language)}}</button></view><view class="hero-caption">{{i18n.f('管理团课与私教套餐，控制展示与派发。', [], language)}}</view></view>
  <view wx:if="{{!hasPermission && !pageBusy}}" class="manage-card"><view class="section-title">{{i18n.f('需要管理员权限', [], language)}}</view><view class="card-description">{{i18n.f('当前账号无法新建套餐或调整上下架。', [], language)}}</view></view>
  <block wx:if="{{hasPermission}}">
    <view class="manage-filters"><input class="form-input manage-search" maxlength="60" value="{{keyword}}" bindinput="onKeywordInput" placeholder="{{i18n.f('搜索套餐名称', [], language)}}" /><view class="filter-strip"><view class="filter-pill {{statusFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="onStatusFilterChange">{{i18n.f('全部', [], language)}}<text class="filter-count">{{pageData.stats.total}}</text></view><view class="filter-pill {{statusFilter === 'active' ? 'active' : ''}}" data-value="active" bindtap="onStatusFilterChange">{{i18n.f('已上架', [], language)}}<text class="filter-count">{{pageData.stats.activeCount}}</text></view><view class="filter-pill {{statusFilter === 'inactive' ? 'active' : ''}}" data-value="inactive" bindtap="onStatusFilterChange">{{i18n.f('已下架', [], language)}}<text class="filter-count">{{pageData.stats.inactiveCount}}</text></view></view><view class="small-filter-row"><view class="small-filter {{typeFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="onTypeFilterChange">{{i18n.f('全部类型', [], language)}}</view><view class="small-filter {{typeFilter === 'group' ? 'active' : ''}}" data-value="group" bindtap="onTypeFilterChange">{{i18n.f('团课', [], language)}}</view><view class="small-filter {{typeFilter === 'private' ? 'active' : ''}}" data-value="private" bindtap="onTypeFilterChange">{{i18n.f('私教', [], language)}}</view></view></view>
    <view class="list-heading"><view class="section-title">{{i18n.f('训练套餐', [], language)}}<text class="muted">{{i18n.f('{0} 个', [visiblePackages.length], language)}}</text></view><button wx:if="{{keyword || statusFilter !== 'all' || typeFilter !== 'all'}}" class="text-action" bindtap="onResetFilters">{{i18n.f('重置筛选', [], language)}}</button></view>
    <view wx:if="{{!visiblePackages.length && !pageBusy && !pageError}}" class="manage-empty"><view class="section-title">{{i18n.f('暂无匹配套餐', [], language)}}</view><view class="muted">{{i18n.f('调整筛选条件，或新建训练套餐。', [], language)}}</view><button class="text-action" bindtap="onResetFilters">{{i18n.f('查看全部套餐', [], language)}}</button></view>
    <view wx:for="{{visiblePackages}}" wx:key="id" class="manage-card"><view class="row-between"><view class="role-label">{{i18n.t(item.type === 'group' ? '团课' : '私教', language)}}</view><view class="status-label {{item.status === 1 ? '' : 'inactive'}}">{{i18n.t(item.statusLabel, language)}}</view></view><view class="item-name package-title">{{item.name}}</view><view class="price-line"><view wx:if="{{item.unlimited}}" class="lesson-value">{{i18n.t('无限', language)}}</view><view wx:else class="lesson-value">{{item.lessons}}<text>{{i18n.f('节', [], language)}}</text></view><view class="price-value">¥{{i18n.t(item.priceText, language)}}</view></view><view class="card-description">{{i18n.f('有效期 {0} 天 · 展示价', [item.validDays], language)}}</view><view class="card-footer"><view class="muted">{{i18n.t(item.status === 1 ? '首页可见 · 可派发' : '暂停展示 · 暂停新派发', language)}}</view><button class="card-action {{item.actionMode}}" data-package-id="{{item.id}}" loading="{{submittingPackageId === item.id}}" disabled="{{submittingPackageId || creatingPackage || pageBusy || pageError}}" bindtap="onTogglePackageStatus">{{i18n.t(item.actionText, language)}}</button></view></view>
  </block>
  <view wx:if="{{showCreatePopup}}" class="sheet-mask"><view class="manage-sheet"><view class="sheet-header"><view><view class="section-title">{{i18n.f('新建训练套餐', [], language)}}</view><view class="muted">{{i18n.f('配置课时、展示价和默认有效期。', [], language)}}</view></view><button class="sheet-close" disabled="{{creatingPackage}}" bindtap="onCloseCreatePopup">{{i18n.f('关闭', [], language)}}</button></view><scroll-view scroll-y class="sheet-scroll"><view class="sheet-body"><view class="field-label">{{i18n.f('套餐名称', [], language)}}</view><input class="form-input" maxlength="60" value="{{createForm.name}}" data-field="name" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="{{i18n.f('如：12 节私教入门卡', [], language)}}" /><view class="field-block"><view class="field-label">{{i18n.f('训练类型', [], language)}}</view><view class="create-types"><view class="small-filter {{createForm.type === 'private' ? 'active' : ''}}" data-value="private" bindtap="onCreateTypeChange">{{i18n.f('私教', [], language)}}</view><view class="small-filter {{createForm.type === 'group' ? 'active' : ''}}" data-value="group" bindtap="onCreateTypeChange">{{i18n.f('团课', [], language)}}</view></view></view><view class="field-block"><view class="field-label">{{i18n.t('使用方式', language)}}</view><view class="create-types"><view class="small-filter {{createForm.usageMode === 'count' ? 'active' : ''}}" data-value="count" bindtap="onCreateUsageChange">{{i18n.t('按次数', language)}}</view><view class="small-filter {{createForm.usageMode === 'unlimited' ? 'active' : ''}}" data-value="unlimited" bindtap="onCreateUsageChange">{{i18n.t('期限内无限次', language)}}</view></view></view><view class="form-columns"><view wx:if="{{createForm.usageMode !== 'unlimited'}}" class="field-block"><view class="field-label">{{i18n.f('课时数（节）', [], language)}}</view><input class="form-input" type="number" maxlength="5" value="{{createForm.lessons}}" data-field="lessons" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="{{i18n.f('1 至 10000', [], language)}}" /></view><view class="field-block"><view class="field-label">{{i18n.f('展示价（元）', [], language)}}</view><input class="form-input" type="digit" maxlength="12" value="{{createForm.price}}" data-field="price" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="0.00" /></view></view><view class="field-block"><view class="field-label">{{i18n.f('默认有效期（天）', [], language)}}</view><input class="form-input" type="number" maxlength="4" value="{{createForm.validDays}}" data-field="validDays" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="{{i18n.f('1 至 3650', [], language)}}" /><view class="card-description">{{i18n.f('派发权益时会按此天数自动填写到期日。', [], language)}}</view></view><view class="status-setting"><view class="row-between"><view class="section-title">{{i18n.f('创建后立即上架', [], language)}}</view><switch checked="{{createForm.status === 1}}" disabled="{{creatingPackage}}" color="#c7452d" bindchange="onCreateStatusChange" /></view><view class="muted">{{i18n.t(createForm.status === 1 ? '创建后立即展示在首页，并可派发给学员。' : '创建后保持下架，核对完成后再上架。', language)}}</view></view></view></scroll-view><view class="sheet-actions"><button class="primary-button" disabled="{{creatingPackage || submittingPackageId || pageBusy || pageError}}" loading="{{creatingPackage}}" bindtap="onSubmitCreatePackage">{{i18n.t(creatingPackage ? '正在创建…' : (createForm.status === 1 ? '创建并上架' : '创建套餐 · 暂不上架'), language)}}</button></view></view></view>
  <app-tabbar id="tabbar" current="/pages/admin/index" />
</view>
