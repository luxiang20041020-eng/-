<view class="page-shell manage-page">
  <page-feedback loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="manage-hero"><view class="hero-eyebrow">ONE / TRAINING PACKAGES</view><view class="row-between"><view class="hero-title">套餐管理</view><button wx:if="{{hasPermission}}" class="hero-add" disabled="{{submittingPackageId || creatingPackage || pageBusy || pageError}}" bindtap="onOpenCreatePopup">＋ 新建套餐</button></view><view class="hero-caption">管理团课与私教套餐，控制展示与派发。</view></view>
  <view wx:if="{{!hasPermission && !pageBusy}}" class="manage-card"><view class="section-title">需要管理员权限</view><view class="card-description">当前账号无法新建套餐或调整上下架。</view></view>
  <block wx:if="{{hasPermission}}">
    <view class="manage-filters"><input class="form-input manage-search" maxlength="60" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索套餐名称" /><view class="filter-strip"><view class="filter-pill {{statusFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="onStatusFilterChange">全部<text class="filter-count">{{pageData.stats.total}}</text></view><view class="filter-pill {{statusFilter === 'active' ? 'active' : ''}}" data-value="active" bindtap="onStatusFilterChange">已上架<text class="filter-count">{{pageData.stats.activeCount}}</text></view><view class="filter-pill {{statusFilter === 'inactive' ? 'active' : ''}}" data-value="inactive" bindtap="onStatusFilterChange">已下架<text class="filter-count">{{pageData.stats.inactiveCount}}</text></view></view><view class="small-filter-row"><view class="small-filter {{typeFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="onTypeFilterChange">全部类型</view><view class="small-filter {{typeFilter === 'group' ? 'active' : ''}}" data-value="group" bindtap="onTypeFilterChange">团课</view><view class="small-filter {{typeFilter === 'private' ? 'active' : ''}}" data-value="private" bindtap="onTypeFilterChange">私教</view></view></view>
    <view class="list-heading"><view class="section-title">训练套餐 <text class="muted">{{visiblePackages.length}} 个</text></view><button wx:if="{{keyword || statusFilter !== 'all' || typeFilter !== 'all'}}" class="text-action" bindtap="onResetFilters">重置筛选</button></view>
    <view wx:if="{{!visiblePackages.length && !pageBusy && !pageError}}" class="manage-empty"><view class="section-title">暂无匹配套餐</view><view class="muted">调整筛选条件，或新建训练套餐。</view><button class="text-action" bindtap="onResetFilters">查看全部套餐</button></view>
    <view wx:for="{{visiblePackages}}" wx:key="id" class="manage-card"><view class="row-between"><view class="role-label">{{item.type === 'group' ? '团课' : '私教'}}</view><view class="status-label {{item.status === 1 ? '' : 'inactive'}}">{{item.statusLabel}}</view></view><view class="item-name package-title">{{item.name}}</view><view class="price-line"><view class="lesson-value">{{item.lessons}}<text> 节</text></view><view class="price-value">¥{{item.priceText}}</view></view><view class="card-description">有效期 {{item.validDays}} 天 · 展示价</view><view class="card-footer"><view class="muted">{{item.status === 1 ? '首页可见 · 可派发' : '暂停展示 · 暂停新派发'}}</view><button class="card-action {{item.actionMode}}" data-package-id="{{item.id}}" loading="{{submittingPackageId === item.id}}" disabled="{{submittingPackageId || creatingPackage || pageBusy || pageError}}" bindtap="onTogglePackageStatus">{{item.actionText}}</button></view></view>
  </block>
  <view wx:if="{{showCreatePopup}}" class="sheet-mask"><view class="manage-sheet"><view class="sheet-header"><view><view class="section-title">新建训练套餐</view><view class="muted">配置课时、展示价和默认有效期。</view></view><button class="sheet-close" disabled="{{creatingPackage}}" bindtap="onCloseCreatePopup">关闭</button></view><scroll-view scroll-y class="sheet-scroll"><view class="sheet-body"><view class="field-label">套餐名称</view><input class="form-input" maxlength="60" value="{{createForm.name}}" data-field="name" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="如：12 节私教入门卡" /><view class="field-block"><view class="field-label">训练类型</view><view class="create-types"><view class="small-filter {{createForm.type === 'private' ? 'active' : ''}}" data-value="private" bindtap="onCreateTypeChange">私教</view><view class="small-filter {{createForm.type === 'group' ? 'active' : ''}}" data-value="group" bindtap="onCreateTypeChange">团课</view></view></view><view class="form-columns"><view class="field-block"><view class="field-label">课时数（节）</view><input class="form-input" type="number" maxlength="5" value="{{createForm.lessons}}" data-field="lessons" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="1 至 10000" /></view><view class="field-block"><view class="field-label">展示价（元）</view><input class="form-input" type="digit" maxlength="12" value="{{createForm.price}}" data-field="price" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="0.00" /></view></view><view class="field-block"><view class="field-label">默认有效期（天）</view><input class="form-input" type="number" maxlength="4" value="{{createForm.validDays}}" data-field="validDays" disabled="{{creatingPackage}}" bindinput="onCreateFieldInput" placeholder="1 至 3650" /><view class="card-description">派发权益时会按此天数自动填写到期日。</view></view><view class="status-setting"><view class="row-between"><view class="section-title">创建后立即上架</view><switch checked="{{createForm.status === 1}}" disabled="{{creatingPackage}}" color="#c7452d" bindchange="onCreateStatusChange" /></view><view class="muted">{{createForm.status === 1 ? '创建后立即展示在首页，并可派发给学员。' : '创建后保持下架，核对完成后再上架。'}}</view></view></view></scroll-view><view class="sheet-actions"><button class="primary-button" disabled="{{creatingPackage || submittingPackageId || pageBusy || pageError}}" loading="{{creatingPackage}}" bindtap="onSubmitCreatePackage">{{creatingPackage ? '正在创建…' : (createForm.status === 1 ? '创建并上架' : '创建套餐 · 暂不上架')}}</button></view></view></view>
  <app-tabbar id="tabbar" current="/pages/admin/index" />
</view>
