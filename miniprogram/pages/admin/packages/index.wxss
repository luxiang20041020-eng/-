.form-input {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #343434;
  border-radius: 14rpx;
  background: #101010;
  color: #f5f5f5;
  font-size: 26rpx;
}

.input-placeholder {
  color: #707070;
}

.section-title-no-gap {
  margin-bottom: 0;
}

.metric-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric-item:nth-child(2n) {
  border-right: 1rpx solid #242424;
}

.metric-item:nth-child(3n) {
  border-right: none;
}

.metric-item:nth-last-child(-n + 3) {
  border-bottom: none;
}

.filter-row {
  margin-top: 20rpx;
}

.filter-label {
  font-size: 22rpx;
  color: #e6e6e6;
}

.filter-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.toolbar-row {
  margin-top: 16rpx;
}

.clear-button {
  width: auto;
  min-width: 110rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.create-entry {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #3a1b1b;
  background:
    linear-gradient(135deg, rgba(255, 52, 52, 0.16) 0%, rgba(20, 20, 20, 0.96) 58%, rgba(10, 10, 10, 1) 100%);
}

.create-entry-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #ff3434;
  background: #ff3434;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.create-entry-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.create-entry-kicker {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #ff7c7c;
}

.create-entry-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.2;
  color: #ffffff;
  font-weight: 700;
}

.create-entry-desc {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #a8a8a8;
}

.create-entry-arrow {
  margin-left: 16rpx;
  color: #ff6565;
  font-size: 30rpx;
  font-weight: 700;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: #e6e6e6;
}

.package-card {
  padding: 22rpx;
}

.package-head {
  gap: 16rpx;
  align-items: flex-start;
}

.package-title-wrap {
  flex: 1;
  min-width: 0;
}

.pricing-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 110rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border: 1rpx solid #2f2f2f;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.pricing-tag.is-private {
  border-color: #ff3d3d;
  color: #ff3d3d;
}

.pricing-tag.is-group {
  color: #b0b0b0;
}

.package-name {
  margin-top: 14rpx;
  font-size: 32rpx;
  line-height: 1.3;
  color: #ffffff;
  font-weight: 700;
}

.package-status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border: 1rpx solid #2a2a2a;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.package-status-chip.status-active {
  border-color: #ff3434;
  background: #ff3434;
  color: #ffffff;
}

.package-status-chip.status-inactive {
  border-color: #5a5a5a;
  background: #181818;
  color: #b9b9b9;
}

.package-meta-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.package-meta-item {
  padding: 16rpx;
  border: 1rpx solid #242424;
  background: #0b0b0b;
}

.meta-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #787878;
}

.meta-value {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

.package-action-button {
  margin-top: 18rpx;
}

.package-action-button.action-on {
  border-color: #ff3434;
  background: #ff3434;
  color: #ffffff;
  font-weight: 700;
}

.package-action-button.action-off {
  border-color: #ff8d8d;
  color: #ff8d8d;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  background: rgba(0, 0, 0, 0.68);
}

.modal-panel {
  width: 100%;
  max-height: 80vh;
  padding: 24rpx;
  border: 1rpx solid #2a2a2a;
  background: #090909;
  overflow-y: auto;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1rpx solid #2f2f2f;
  color: #b7b7b7;
  font-size: 32rpx;
}

.modal-button-row {
  margin-top: 28rpx;
}
