.section-title-no-gap {
  margin-bottom: 0;
}

.metric-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.filter-row {
  margin-top: 20rpx;
}

.filter-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.toolbar-row {
  margin-top: 16rpx;
}

.clear-button {
  width: auto;
  min-width: 110rpx;
  min-height: 62rpx;
  line-height: 62rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.create-entry {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #ffd2dc;
  border-radius: 30rpx;
  background:
    repeating-linear-gradient(45deg, rgba(255, 31, 79, 0.04) 0, rgba(255, 31, 79, 0.04) 10rpx, transparent 10rpx, transparent 26rpx),
    #fff7f9;
}

.create-entry-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  background: #ff1f4f;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.create-entry-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.create-entry-kicker {
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #ff1f4f;
  font-weight: 900;
}

.create-entry-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.2;
  color: #07142f;
  font-weight: 900;
}

.create-entry-desc {
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #7d8798;
}

.create-entry-arrow {
  margin-left: 16rpx;
  color: #ff1f4f;
  font-size: 30rpx;
  font-weight: 900;
}

.package-card {
  padding: 22rpx;
}

.package-head {
  gap: 16rpx;
  align-items: flex-start;
}

.package-title-wrap {
  flex: 1;
  min-width: 0;
}

.pricing-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  font-size: 16rpx;
  color: #ffffff;
  font-weight: 900;
}

.pricing-tag.is-private {
  background: #07142f;
}

.pricing-tag.is-group {
  background: #ff1f4f;
}

.package-name {
  margin-top: 14rpx;
  font-size: 32rpx;
  line-height: 1.3;
  color: #07142f;
  font-weight: 900;
}

.package-status-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.package-status-chip.status-active {
  background: #ff1f4f;
  color: #ffffff;
}

.package-status-chip.status-inactive {
  background: #eef1f6;
  color: #697386;
}

.package-meta-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.package-meta-item {
  padding: 16rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 22rpx;
  background: #f8f9fc;
}

.meta-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7d8798;
  font-weight: 900;
}

.meta-value {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #07142f;
  font-weight: 900;
}

.package-action-button {
  margin-top: 18rpx;
}

.package-action-button.action-on {
  background: #ff1f4f;
  color: #ffffff;
}

.package-action-button.action-off {
  border-color: #ffd2dc;
  background: #fff1f5;
  color: #ff1f4f;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(7, 20, 47, 0.45);
  backdrop-filter: blur(10px);
}

.modal-panel {
  width: 100%;
  max-height: 82vh;
  padding: 28rpx;
  border: 1rpx solid #ffe1e8;
  border-radius: 38rpx;
  background: #ffffff;
  overflow-y: auto;
  box-shadow: 0 30rpx 80rpx rgba(8, 20, 47, 0.18);
}

.modal-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #f3f5f9;
  color: #07142f;
  font-size: 34rpx;
  font-weight: 700;
}

.modal-button-row {
  margin-top: 28rpx;
}
