<wxs module="i18n" src="../../../utils/i18n.wxs" />
<view class="page-shell locale-page locale-{{language}} report-page">
  <page-feedback language="{{language}}" loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry" />
  <view class="page-header"><view class="eyebrow">ONE / INSIGHTS</view><view class="page-title">{{i18n.t('客户与经营', language)}}</view><picker range="{{runtime.stores}}" range-key="name" value="{{storeIndex}}" disabled="{{exporting}}" bindchange="onStore"><view class="store-picker">{{runtime.stores[storeIndex].name}} ⌄</view></picker></view>
  <block wx:if="{{runtime.role === 'admin'}}">
    <view class="report-tabs"><view class="report-tab {{mode === 'followup' ? 'active' : ''}}" data-mode="followup" bindtap="onMode">{{i18n.t('客户跟进', language)}}</view><view class="report-tab {{mode === 'report' ? 'active' : ''}}" data-mode="report" bindtap="onMode">{{i18n.t('经营报表', language)}}</view></view>
    <block wx:if="{{mode === 'followup'}}">
      <view class="card"><view class="row-between"><view class="section-title">{{i18n.t('筛选客户', language)}}</view><view bindtap="onSettings" class="settings-link">{{i18n.t('筛选设置', language)}} ⌄</view></view><view class="filter-chips"><view class="filter-chip {{filter === 'needs' ? 'active' : ''}}" data-filter="needs" bindtap="onFilter">{{i18n.t('需要跟进', language)}}</view><view class="filter-chip {{filter === 'expiring' ? 'active' : ''}}" data-filter="expiring" bindtap="onFilter">{{i18n.t('即将到期', language)}}</view><view class="filter-chip {{filter === 'low' ? 'active' : ''}}" data-filter="low" bindtap="onFilter">{{i18n.t('课时不足', language)}}</view><view class="filter-chip {{filter === 'inactive' ? 'active' : ''}}" data-filter="inactive" bindtap="onFilter">{{i18n.t('长期未到店', language)}}</view><view class="filter-chip {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilter">{{i18n.t('全部客户', language)}}</view></view>
        <view wx:if="{{settingsOpen}}" class="threshold-grid"><view><view class="field-label">{{i18n.t('到期提醒天数', language)}}</view><input class="form-input" type="number" value="{{expiryDays}}" data-field="expiryDays" bindinput="onInput" /></view><view><view class="field-label">{{i18n.t('课时不足阈值', language)}}</view><input class="form-input" type="number" value="{{lowBalance}}" data-field="lowBalance" bindinput="onInput" /></view><view><view class="field-label">{{i18n.t('未到店提醒天数', language)}}</view><input class="form-input" type="number" value="{{inactiveDays}}" data-field="inactiveDays" bindinput="onInput" /></view></view>
        <input class="form-input search-input" value="{{keyword}}" data-field="keyword" bindinput="onInput" placeholder="{{i18n.t('按姓名或手机号搜索', language)}}" /><button class="primary-button" disabled="{{pageBusy || exporting}}" bindtap="onQuery">{{i18n.t('查询', language)}}</button><view wx:if="{{followupDirty}}" class="query-notice">{{i18n.t('筛选条件已变化，请查询后再导出', language)}}</view><view class="card-desc scope-note">{{i18n.t('客户按所属门店筛选，最近到店跨门店核对。', language)}}</view>
      </view>
      <view wx:if="{{followup}}" class="report-metrics"><view class="report-metric"><view>{{i18n.t('即将到期', language)}}</view><text>{{followup.counts.expiring}}</text></view><view class="report-metric"><view>{{i18n.t('课时不足', language)}}</view><text>{{followup.counts.low}}</text></view><view class="report-metric"><view>{{i18n.t('长期未到店', language)}}</view><text>{{followup.counts.inactive}}</text></view><view class="report-metric"><view>{{i18n.t('需要跟进', language)}}</view><text>{{followup.counts.needs}}</text></view></view>
      <view wx:if="{{followup}}" class="result-caption">{{i18n.f('当前筛选 {0} 位客户', [followup.total], language)}}</view>
      <view wx:if="{{followup && !followup.total}}" class="card empty-state">{{i18n.t('暂无符合条件的客户', language)}}</view>
      <view wx:for="{{visibleCustomers}}" wx:key="id" class="card customer-card"><view class="row-between"><view class="section-title">{{item.name}}</view><view class="card-desc">{{item.phone}}</view></view><view class="customer-tags"><text wx:if="{{item.expiring}}">{{i18n.t('即将到期', language)}}</text><text wx:if="{{item.low}}">{{i18n.t('课时不足', language)}}</text><text wx:if="{{item.inactive}}">{{i18n.t('长期未到店', language)}}</text></view><view wx:for="{{item.types}}" wx:for-item="asset" wx:key="type" class="asset-row"><view>{{i18n.t(asset.label, language)}}</view><view wx:if="{{!asset.owned}}" class="card-desc">{{i18n.t('未购课', language)}}</view><view wx:else><view>{{asset.unlimited ? i18n.t('期限内无限次', language) : i18n.f('剩余 {0} 次', [asset.balance], language)}}</view><view class="card-desc">{{(asset.unlimited ? asset.unlimitedExpiry : asset.expiry) || i18n.t('无到期限制', language)}}<text wx:if="{{asset.expired}}"> · {{i18n.t('已过期', language)}}</text></view></view></view><view class="card-desc">{{i18n.f('最近到店：{0}', [item.lastVisit || i18n.t('未到店', language)], language)}}</view><view class="card-desc">{{i18n.f('距到店或建档 {0} 天', [item.daysInactive === null ? '—' : item.daysInactive], language)}}</view><button wx:if="{{item.phone}}" class="secondary-button" data-phone="{{item.phone}}" bindtap="onCopyPhone">{{i18n.t('复制手机号', language)}}</button></view>
      <button wx:if="{{followup && visibleCustomers.length < followup.total}}" class="secondary-button" bindtap="onMoreCustomers">{{i18n.t('加载更多客户', language)}}</button>
    </block>
    <block wx:if="{{mode === 'report'}}">
      <view class="card"><view class="section-title">{{i18n.t('日期范围', language)}}</view><view class="date-range"><picker mode="date" value="{{startDate}}" data-field="startDate" disabled="{{exporting}}" bindchange="onDateChange"><view><view class="field-label">{{i18n.t('开始日期', language)}}</view>{{startDate}} ⌄</view></picker><picker mode="date" value="{{endDate}}" data-field="endDate" disabled="{{exporting}}" bindchange="onDateChange"><view><view class="field-label">{{i18n.t('结束日期', language)}}</view>{{endDate}} ⌄</view></picker></view><view class="filter-chips"><view class="filter-chip" data-preset="today" bindtap="onPreset">{{i18n.t('今天', language)}}</view><view class="filter-chip" data-preset="month" bindtap="onPreset">{{i18n.t('本月', language)}}</view><view class="filter-chip" data-preset="recent" bindtap="onPreset">{{i18n.t('近 30 天', language)}}</view></view><button class="primary-button" disabled="{{pageBusy || exporting}}" bindtap="onQuery">{{i18n.t('查询报表', language)}}</button><view wx:if="{{reportDirty}}" class="query-notice">{{i18n.t('日期条件已变化，请查询后再导出', language)}}</view></view>
      <block wx:if="{{report}}">
        <view class="result-caption">{{report.store.name}} · {{report.startDate}} — {{report.endDate}}</view><view class="report-metrics"><view class="report-metric"><view>{{i18n.t('登记实收', language)}}</view><text>¥{{report.summary.incomeText}}</text></view><view class="report-metric"><view>{{i18n.t('收款笔数', language)}}</view><text>{{report.summary.payments}}</text></view><view class="report-metric"><view>{{i18n.t('续费笔数', language)}}</view><text>{{report.summary.renewals}}</text></view><view class="report-metric"><view>{{i18n.t('续费金额', language)}}</view><text>¥{{report.summary.renewalText}}</text></view><view class="report-metric"><view>{{i18n.t('到场人次', language)}}</view><text>{{report.summary.checkins}}</text></view><view class="report-metric"><view>{{i18n.t('已完成场次', language)}}</view><text>{{report.summary.taught}}</text></view></view>
        <view class="card scope-note"><view class="card-desc">{{i18n.t('收款按登记日期；核销按训练日期；排除已撤销记录。', language)}}</view><view class="card-desc">{{i18n.t('续费为同一客户、同一课种的后续付费派发，赠课不计入。', language)}}</view><view class="card-desc">{{i18n.t('授课时长按已结束且有到场的排课计算，独立人工训练不估算时长。', language)}}</view><view class="card-desc">{{i18n.t('金额为线下收款登记，不代表线上支付或自动退款。', language)}}</view><view wx:if="{{report.incompleteRecords}}" class="query-notice">{{i18n.f('{0} 条记录缺少日期信息，已从对应统计中排除。', [report.incompleteRecords], language)}}</view></view>
        <view class="card"><view class="section-title">{{i18n.t('每日经营数据', language)}}</view><view class="card-desc">{{i18n.t('左右滑动查看完整数据', language)}}</view><scroll-view scroll-x class="table-scroll"><view class="daily-table"><view class="table-row table-heading"><view>{{i18n.t('日期', language)}}</view><view>{{i18n.t('登记实收', language)}}</view><view>{{i18n.t('续费笔数', language)}}</view><view>{{i18n.t('到场人次', language)}}</view><view>{{i18n.t('缺席人次', language)}}</view><view>{{i18n.t('已完成场次', language)}}</view></view><view wx:for="{{report.daily}}" wx:key="date" class="table-row"><view>{{item.date}}</view><view>¥{{item.incomeText}}</view><view>{{item.renewals}}</view><view>{{item.checkins}}</view><view>{{item.absences}}</view><view>{{item.taught}}</view></view></view></scroll-view></view>
        <view class="card"><view class="section-title">{{i18n.t('教练上课情况', language)}}</view><view wx:if="{{!report.coaches.length}}" class="card-desc">{{i18n.t('该日期范围暂无教练训练记录', language)}}</view><view wx:for="{{report.coaches}}" wx:key="id" class="detail-row"><view class="section-title">{{item.name}}</view><view class="coach-grid"><view>{{i18n.t('排课场次', language)}} <text>{{item.scheduled}}</text></view><view>{{i18n.t('已完成场次', language)}} <text>{{item.taught}}</text></view><view>{{i18n.t('到场人次', language)}} <text>{{item.checkins}}</text></view><view>{{i18n.t('人工核销人次', language)}} <text>{{item.manualCheckins}}</text></view><view>{{i18n.t('取消场次', language)}} <text>{{item.cancelled}}</text></view><view>{{i18n.t('排课授课分钟', language)}} <text>{{item.minutes}}</text></view></view></view></view>
        <view class="card"><view class="section-title">{{i18n.t('收款明细', language)}}</view><view wx:if="{{!report.payments.length}}" class="card-desc">{{i18n.t('该日期范围暂无收款记录', language)}}</view><view wx:for="{{visiblePayments}}" wx:key="id" class="detail-row"><view class="row-between"><view class="section-title">{{item.userName}}</view><view class="payment-amount">¥{{item.amountText}}</view></view><view>{{item.packageName}}</view><view class="card-desc">{{item.date}} · {{i18n.t(item.payType, language)}} · {{i18n.t(item.purchaseLabel, language)}}</view><view class="card-desc">{{i18n.f('操作人：{0}', [item.operatorName], language)}}</view></view><button wx:if="{{visiblePayments.length < report.payments.length}}" class="secondary-button" bindtap="onMorePayments">{{i18n.t('加载更多收款记录', language)}}</button></view>
      </block>
    </block>
    <view class="export-bar"><button class="primary-button" loading="{{exporting}}" disabled="{{pageBusy || pageError || exporting || (mode === 'followup' ? !followup || followupDirty : !report || reportDirty)}}" bindtap="onExport">{{i18n.t('导出 CSV', language)}}</button><button class="secondary-button" disabled="{{pageBusy || pageError || exporting || (mode === 'followup' ? !followup || followupDirty : !report || reportDirty)}}" bindtap="onCopyTable">{{i18n.t('复制表格', language)}}</button></view>
  </block>
</view>
