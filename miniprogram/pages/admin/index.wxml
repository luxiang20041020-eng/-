<view class="page-shell">
  <page-feedback loading="{{pageBusy}}" error="{{pageError}}" bindretry="onRetry"></page-feedback>
  <view class="page-header">
    <view class="eyebrow">门店经营与训练数据</view>
    <view class="page-title">数据看板</view>
  </view>

  <view wx:if="{{!hasPermission}}" class="card">
    <view class="section-title">访问权限提示</view>
    <view class="card-desc">运营看板仅对管理员开放，请联系场馆确认账号权限。</view>
  </view>

  <block wx:else>
    <view class="card admin-toolbar-card">
      <view class="admin-toolbar-left">
        <view class="admin-tool-label">日期</view>
        <view class="admin-tool-value">{{pageData.dateLabel}}</view>
      </view>
      <view class="admin-toolbar-mid"> </view>
      <view class="admin-toolbar-left" bindtap="onOpenStorePicker">
        <view class="admin-tool-label">门店</view>
        <view class="admin-tool-value">{{pageData.currentStore.name}}</view>
      </view>
      <button class="secondary-button admin-mini-btn" loading="{{bootstrapLoading}}" bindtap="onBootstrap">检查数据库</button>
    </view>

    <view class="card">
      <view class="section-title">今日概览</view>
      <view class="metric-grid">
        <view class="metric-item">
          <view class="metric-label">线下实收</view>
          <view class="metric-value">{{pageData.auditOverview.incomeText}}</view>
          <view class="metric-note">今日线下实收</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">到场核销</view>
          <view class="metric-value">{{pageData.auditOverview.writeOffCount}}</view>
          <view class="metric-note">今日核销</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">团体训练</view>
          <view class="metric-value">{{pageData.auditOverview.addedGroupLessons}}<text class="metric-unit">节</text></view>
          <view class="metric-note">新增团课课时</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">专属训练</view>
          <view class="metric-value">{{pageData.auditOverview.addedPrivateLessons}}<text class="metric-unit">节</text></view>
          <view class="metric-note">新增私教课时</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="collapsible-header" bindtap="onToggleAuditLogs">
        <view class="collapsible-title">
          <view class="section-title">权益派发记录</view>
          <view class="collapsible-summary">{{pageData.auditLogs ? pageData.auditLogs.length : 0}} 条记录</view>
        </view>
        <view class="audit-header-actions">
          <button wx:if="{{auditLogsExpanded}}" class="secondary-button export-button" catchtap="onExport">复制记录</button>
          <view class="collapse-toggle">
            <view class="collapse-chevron {{auditLogsExpanded ? 'expanded' : ''}}"></view>
          </view>
        </view>
      </view>
      <block wx:if="{{auditLogsExpanded}}">
        <view wx:if="{{!pageData.auditLogs.length}}" class="empty-state"><view class="empty-state-title">暂无权益派发记录</view><view class="empty-state-desc">完成首次派发后，收款与操作记录会显示在这里。</view></view><view wx:for="{{pageData.auditLogs}}" wx:key="id" class="audit-item">
          <view class="audit-top-row">
            <view class="audit-time">{{item.time}}</view>
            <view class="audit-paytype">{{item.payType}}</view>
          </view>
          <view class="audit-main-text">操作人 {{item.operatorName}} 为学员 {{item.targetName}} 派发 {{item.packageName}}</view>
          <view class="audit-remark">备注：{{item.remark}}</view>
          <view class="audit-amount">￥{{item.amount}}</view>
        </view>
      </block>
    </view>

    <view class="card">
      <view class="section-title">管理门店</view>
      <view class="admin-tools-grid">
        <view class="admin-tool-card primary" bindtap="onOpenOperations">
          <view class="admin-card-title">训练运营</view>
          <view class="admin-card-desc">派发权益、排课与到场核销</view>
        </view>
        <view class="admin-tool-card" bindtap="onOpenUserManage">
          <view class="admin-card-title">人员权限管理</view>
          <view class="admin-card-desc">管理人员与账号权限</view>
        </view>
        <view class="admin-tool-card" bindtap="onOpenPackageManage">
          <view class="admin-card-title">套餐上下架</view>
          <view class="admin-card-desc">训练套餐与展示价格</view>
        </view>
        <view class="admin-tool-card" bindtap="onOpenStoreManage">
          <view class="admin-card-title">门店管理</view>
          <view class="admin-card-desc">门店资料 / 营业状态</view>
        </view>
      </view>
    </view>
  </block>

  <app-tabbar current="/pages/admin/index"></app-tabbar>
</view>
