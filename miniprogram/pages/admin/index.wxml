<view class="page-shell">
  <view class="page-header">
    <view class="eyebrow">AUDIT · 对账 · 全馆统计</view>
    <view class="page-title">数据看板</view>
  </view>

  <view wx:if="{{!hasPermission}}" class="card">
    <view class="section-title">ACCESS DENIED</view>
    <view class="card-desc">当前身份不是管理员，此页面仅 Role=3 可见。请去“我的”页切换角色后再验收。</view>
  </view>

  <block wx:else>
    <view class="card admin-toolbar-card">
      <view class="admin-toolbar-left">
        <view class="admin-tool-label">DATE</view>
        <view class="admin-tool-value">2026-04-24</view>
      </view>
      <view class="admin-toolbar-mid"> </view>
      <view class="admin-toolbar-left">
        <view class="admin-tool-label">STORE</view>
        <view class="admin-tool-value">{{pageData.currentStore.name}}</view>
      </view>
      <button class="secondary-button admin-mini-btn" loading="{{bootstrapLoading}}" bindtap="onBootstrap">初始化</button>
    </view>

    <view class="card">
      <view class="section-title">OVERVIEW · 今日概览</view>
      <view class="metric-grid">
        <view class="metric-item">
          <view class="metric-label">OFFLINE AMOUNT</view>
          <view class="metric-value">{{pageData.auditOverview.incomeText}}</view>
          <view class="metric-note">线下收款总额</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">CHECK-IN</view>
          <view class="metric-value">{{pageData.auditOverview.writeOffCount}}</view>
          <view class="metric-note">今日核销</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">GROUP</view>
          <view class="metric-value">{{pageData.auditOverview.addedGroupLessons}}<text class="metric-unit">节</text></view>
          <view class="metric-note">新增团课课时</view>
        </view>
        <view class="metric-item">
          <view class="metric-label">PRIVATE</view>
          <view class="metric-value">{{pageData.auditOverview.addedPrivateLessons}}<text class="metric-unit">节</text></view>
          <view class="metric-note">新增私教课时</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="headline-row">
        <view class="section-title">AUDIT LOG · 课时派发审计</view>
        <button class="secondary-button export-button" bindtap="onExport">导出</button>
      </view>
      <view wx:for="{{pageData.auditLogs}}" wx:key="id" class="audit-item">
        <view class="audit-top-row">
          <view class="audit-time">{{item.time}}</view>
          <view class="audit-paytype">{{item.payType}}</view>
        </view>
        <view class="audit-main-text">操作人 {{item.operatorName}} 为学员 {{item.targetName}} 派发 {{item.packageName}}</view>
        <view class="audit-remark">备注：{{item.remark}}</view>
        <view class="audit-amount">￥{{item.amount}}</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">TOOLS · 运营工具</view>
      <view class="admin-tools-grid">
        <view class="admin-tool-card primary" bindtap="onBootstrap">
          <view class="admin-card-title">发布系统公告</view>
          <view class="admin-card-desc">云端初始化与基础播报</view>
        </view>
        <view class="admin-tool-card" bindtap="onOpenUserManage">
          <view class="admin-card-title">人员权限管理</view>
          <view class="admin-card-desc">用户 / 角色矩阵</view>
        </view>
        <view class="admin-tool-card" bindtap="onOpenPackageManage">
          <view class="admin-card-title">套餐上下架</view>
          <view class="admin-card-desc">面向价目板配置</view>
        </view>
        <view class="admin-tool-card">
          <view class="admin-card-title">门店管理</view>
          <view class="admin-card-desc">班次 / 场地池</view>
        </view>
      </view>
    </view>
  </block>

  <app-tabbar current="/pages/admin/index"></app-tabbar>
</view>
