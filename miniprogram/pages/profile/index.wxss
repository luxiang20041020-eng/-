.profile-hero {
  display: flex;
  gap: 22rpx;
  align-items: flex-start;
  padding: 28rpx;
  border-color: #ecd8cf;
  background: #fbfaf6;
}

.profile-hero > .avatar-square {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  margin-top: 2rpx;
}

.profile-hero-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.profile-name {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  line-height: 1.25;
  color: #20251f;
  font-weight: 600;
  word-break: break-word;
}

.mini-role-tag {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #c7452d;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.profile-edit-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  min-height: 42rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #ecd8cf;
  border-radius: 999rpx;
  background: #fcf2ed;
  color: #c7452d;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.profile-edit-button::after {
  border: none;
}

.profile-facts {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0e6e9;
}

.profile-fact-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-fact-row:first-child {
  margin-top: 0;
}

.profile-fact-label {
  flex: 0 0 96rpx;
  width: 96rpx;
  color: #979b90;
}

.profile-fact-value {
  flex: 1;
  min-width: 0;
  color: #686f61;
  font-weight: 600;
  word-break: break-word;
}

.profile-level {
  margin-top: 12rpx;
  color: #7c8076;
  font-size: 21rpx;
  line-height: 1.45;
  font-weight: 700;
}

.nickname-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 230;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 28rpx;
  background: rgba(32, 37, 31, 0.45);
}

.nickname-panel {
  width: 100%;
  max-width: 660rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid #ecd8cf;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(32, 37, 31, 0.18);
}

.nickname-title {
  color: #20251f;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 600;
}

.nickname-input {
  width: 100%;
  height: 92rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 16rpx;
  background: #f7f7f2;
  color: #20251f;
  font-size: 28rpx;
  font-weight: 600;
}

.nickname-error {
  margin-top: 16rpx;
  color: #c7452d;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 600;
}

.nickname-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.nickname-cancel,
.nickname-confirm {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 600;
}

.nickname-cancel {
  border: 1rpx solid #e1e3d9;
  background: #f7f7f2;
  color: #20251f;
}

.nickname-confirm {
  background: #c7452d;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(199, 69, 45, 0.22);
}

.nickname-cancel::after,
.nickname-confirm::after {
  border: none;
}

.qr-frame {
  margin-top: 16rpx;
  border-radius: 16rpx;
  background: #f7f7f2;
  overflow: hidden;
}

.qr-inner {
  padding: 26rpx;
}

.qr-code-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  padding: 24rpx;
  border: 2rpx solid #c7452d;
  border-radius: 16rpx;
  background:
    linear-gradient(90deg, rgba(32, 37, 31, 0.04) 50%, transparent 50%),
    linear-gradient(rgba(32, 37, 31, 0.04) 50%, transparent 50%),
    #ffffff;
  background-size: 20rpx 20rpx;
}

.qr-code-image {
  width: 100%;
  height: 372rpx;
}

.qr-placeholder {
  padding: 0 24rpx;
  text-align: center;
  word-break: break-all;
  font-size: 24rpx;
  line-height: 1.8;
  color: #20251f;
  font-weight: 600;
}

.qr-code-text {
  margin-top: 18rpx;
  text-align: center;
  word-break: break-all;
  font-size: 20rpx;
  line-height: 1.7;
  color: #7c8076;
}

.qr-error-text {
  margin: 0 26rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #c7452d;
  font-weight: 600;
}

.booking-item {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #ffffff;
}

.booking-date-block {
  width: 88rpx;
  text-align: center;
}

.booking-date-day {
  font-size: 50rpx;
  line-height: 1;
  color: #20251f;
  font-weight: 600;
}

.booking-date-month {
  margin-top: 8rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #7c8076;
  font-weight: 600;
}

.booking-main-block {
  flex: 1;
  min-width: 0;
}

.booking-title-text {
  flex: 1;
  padding-right: 14rpx;
  font-size: 29rpx;
  line-height: 1.35;
  color: #20251f;
  font-weight: 600;
}

.booking-cancel-btn {
  margin-top: 14rpx;
}

.profile-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.profile-stats-grid .stats-item {
  min-height: 116rpx;
  text-align: center;
}

.metric-expiry {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #c7452d;
  font-weight: 600;
}

.metric-expiry-none {
  color: #7c8076;
}

.login-guide-card {
  margin-top: 32rpx;
}

.logout-card {
  margin-bottom: 48rpx;
}

.logout-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: 1rpx solid #ecd8cf;
  border-radius: 16rpx;
  background: #f9eae4;
  color: #c7452d;
  font-size: 28rpx;
  font-weight: 600;
}

.logout-button::after {
  border: none;
}

.profile-name-row { flex-wrap: wrap; }
.profile-edit-button { min-height: 56rpx; font-size: 22rpx; }
.qr-code-box { background: #ffffff; border: 1rpx solid #e1e3d9; }
.profile-stats-grid .stats-note { font-size: 21rpx; color: #73786e; line-height: 1.5; }
.nickname-mask { z-index: 230; }
.invite-form { padding-top: 20rpx; }
.invite-input { width: 100%; box-sizing: border-box; min-height: 84rpx; margin-top: 24rpx; background: #f5f5ef; border: 1rpx solid #dedfd5; border-radius: 14rpx; padding: 22rpx; font-size: 28rpx; }
.invite-card button.invite-submit { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 100%; margin: 22rpx 0 0; box-sizing: border-box; padding: 20rpx; font-size: 26rpx; line-height: 1.4; }
.invite-error { margin-top: 20rpx; font-size: 24rpx; color: #bd442e; line-height: 1.6; }
.invite-bound { margin-top: 20rpx; color: #55714b; font-size: 25rpx; line-height: 1.7; overflow-wrap: anywhere; }
.locale-page .profile-name-row { flex-wrap: wrap; }
.locale-page button.profile-edit-button { flex: 0 1 auto; width: auto; min-width: 72rpx; max-width: 180rpx; padding: 10rpx 14rpx; line-height: 1.4; letter-spacing: 0; }
