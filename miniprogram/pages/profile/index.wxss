.profile-hero {
  display: flex;
  gap: 20rpx;
  align-items: center;
  border-color: #ffe1e8;
  background: #fffafa;
}

.profile-hero-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.profile-name {
  font-size: 36rpx;
  color: #07142f;
  font-weight: 900;
  word-break: break-all;
}

.mini-role-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #ff1f4f;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
}

.profile-edit-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  min-height: 34rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 1rpx solid #ffd2dc;
  border-radius: 999rpx;
  background: #fff7f9;
  color: #ff1f4f;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.profile-edit-button::after {
  border: none;
}

.profile-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7d8798;
  font-weight: 700;
}

.nickname-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 28rpx;
  background: rgba(7, 20, 47, 0.45);
}

.nickname-panel {
  width: 100%;
  max-width: 660rpx;
  padding: 34rpx 32rpx 30rpx;
  border: 1rpx solid #ffe1e8;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(8, 20, 47, 0.18);
}

.nickname-title {
  color: #07142f;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
}

.nickname-input {
  width: 100%;
  height: 92rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e7ebf2;
  border-radius: 26rpx;
  background: #f8f9fc;
  color: #07142f;
  font-size: 28rpx;
  font-weight: 800;
}

.nickname-error {
  margin-top: 16rpx;
  color: #ff1f4f;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 800;
}

.nickname-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.nickname-cancel,
.nickname-confirm {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 900;
}

.nickname-cancel {
  border: 1rpx solid #e7ebf2;
  background: #f8f9fc;
  color: #07142f;
}

.nickname-confirm {
  background: #ff1f4f;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(255, 31, 79, 0.22);
}

.nickname-cancel::after,
.nickname-confirm::after {
  border: none;
}

.qr-frame {
  margin-top: 16rpx;
  border-radius: 32rpx;
  background: #f8f9fc;
  overflow: hidden;
}

.qr-inner {
  padding: 26rpx;
}

.qr-code-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  padding: 24rpx;
  border: 2rpx solid #ff1f4f;
  border-radius: 28rpx;
  background:
    linear-gradient(90deg, rgba(7, 20, 47, 0.04) 50%, transparent 50%),
    linear-gradient(rgba(7, 20, 47, 0.04) 50%, transparent 50%),
    #ffffff;
  background-size: 20rpx 20rpx;
}

.qr-code-image {
  width: 100%;
  height: 372rpx;
}

.qr-placeholder {
  padding: 0 24rpx;
  text-align: center;
  word-break: break-all;
  font-size: 24rpx;
  line-height: 1.8;
  color: #07142f;
  font-weight: 900;
}

.qr-code-text {
  margin-top: 18rpx;
  text-align: center;
  word-break: break-all;
  font-size: 20rpx;
  line-height: 1.7;
  color: #7d8798;
}

.qr-error-text {
  margin: 0 26rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #ff1f4f;
  font-weight: 800;
}

.booking-item {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
}

.booking-date-block {
  width: 88rpx;
  text-align: center;
}

.booking-date-day {
  font-size: 50rpx;
  line-height: 1;
  color: #07142f;
  font-weight: 900;
}

.booking-date-month {
  margin-top: 8rpx;
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7d8798;
  font-weight: 900;
}

.booking-main-block {
  flex: 1;
  min-width: 0;
}

.booking-title-text {
  flex: 1;
  padding-right: 14rpx;
  font-size: 29rpx;
  line-height: 1.35;
  color: #07142f;
  font-weight: 900;
}

.booking-cancel-btn {
  margin-top: 14rpx;
}

.profile-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.profile-stats-grid .stats-item {
  min-height: 116rpx;
  text-align: center;
}

.metric-expiry {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #ff1f4f;
  font-weight: 800;
}

.metric-expiry-none {
  color: #7d8798;
}

.login-guide-card {
  margin-top: 32rpx;
}

.logout-card {
  margin-bottom: 48rpx;
}

.logout-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: 1rpx solid #ffd2dc;
  border-radius: 28rpx;
  background: #fff1f5;
  color: #ff1f4f;
  font-size: 28rpx;
  font-weight: 900;
}

.logout-button::after {
  border: none;
}
