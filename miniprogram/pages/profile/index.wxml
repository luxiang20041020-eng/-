<view class="page-shell">
  <view class="page-header">
    <view class="eyebrow">PROFILE · 资产 · 身份码</view>
    <view class="page-title">我的</view>
  </view>

  <view wx:if="{{!runtime.isAuthenticated}}" class="card login-guide-card">
    <view class="section-title">登录后解锁全部功能</view>
    <view class="card-desc" style="margin-bottom:16px;">查看权益余额、我的预约记录、身份核验码，需要先完成手机号登录。</view>
    <button class="primary-button" bindtap="goLogin">前往登录</button>
  </view>

  <view wx:if="{{runtime.isAuthenticated}}" class="card profile-hero">
    <view class="avatar-square">{{avatarText}}</view>
    <view class="profile-hero-main">
      <view class="profile-name-row">
        <view class="profile-name">{{runtime.userProfile.nickname}}</view>
        <button class="profile-edit-button" bindtap="openNicknameEditor">编辑</button>
        <view class="mini-role-tag">{{runtime.roleLabel}}</view>
      </view>
      <view class="profile-meta">{{runtime.userProfile.phone}} · {{pageData.currentStore.name}}</view>
      <view class="profile-meta">{{runtime.userProfile.levelText}}</view>
    </view>
  </view>

  <view wx:if="{{showNicknameEditor}}" class="nickname-mask">
    <view class="nickname-panel">
      <view class="nickname-title">更改用户名</view>
      <input
        class="nickname-input"
        value="{{nicknameDraft}}"
        maxlength="20"
        placeholder="请输入新的用户名"
        focus="{{showNicknameEditor}}"
        confirm-type="done"
        bindinput="onNicknameInput"
        bindconfirm="submitNicknameChange"
      />
      <view wx:if="{{nicknameError}}" class="nickname-error">{{nicknameError}}</view>
      <view class="nickname-actions">
        <button class="nickname-cancel" bindtap="closeNicknameEditor" disabled="{{nicknameSubmitting}}">取消</button>
        <button
          class="nickname-confirm"
          bindtap="submitNicknameChange"
          loading="{{nicknameSubmitting}}"
          disabled="{{nicknameSubmitting}}"
        >
          {{nicknameSubmitting ? '保存中...' : '保存'}}
        </button>
      </view>
    </view>
  </view>

  <block wx:if="{{runtime.isAuthenticated}}">
  <view class="card">
    <view class="section-title">MY ASSETS · 我的权益</view>
    <view class="metric-grid">
      <view class="metric-item">
        <view class="metric-label">PRIVATE</view>
        <view class="metric-value">{{pageData.assets.privateCount}}<text class="metric-unit">次</text></view>
        <view class="metric-note">专属权益</view>
        <view class="metric-expiry {{pageData.assets.privateExpiry ? '' : 'metric-expiry-none'}}">
          {{pageData.assets.privateExpiry ? pageData.assets.privateExpiry + ' 到期' : '无到期限制'}}
        </view>
      </view>
      <view class="metric-item">
        <view class="metric-label">GROUP</view>
        <view class="metric-value">{{pageData.assets.groupCount}}<text class="metric-unit">次</text></view>
        <view class="metric-note">团体权益</view>
        <view class="metric-expiry {{pageData.assets.groupExpiry ? '' : 'metric-expiry-none'}}">
          {{pageData.assets.groupExpiry ? pageData.assets.groupExpiry + ' 到期' : '无到期限制'}}
        </view>
      </view>
    </view>
    <view class="card-desc">权益自购买日起 365 天内有效，跨门店通用。预约开始前 2 小时内不可取消。</view>
  </view>

  <view class="card">
    <view class="headline-row">
      <view class="section-title">IDENTITY QR</view>
      <view class="card-desc">AUTO 60S</view>
    </view>
    <view class="qr-frame">
      <view class="qr-inner">
        <view class="qr-code-box">
          <image wx:if="{{qrCodeImageSrc}}" class="qr-code-image" src="{{qrCodeImageSrc}}" mode="aspectFit" show-menu-by-longpress="true"></image>
          <view wx:elif="{{qrCodeLoading}}" class="qr-placeholder">二维码生成中...</view>
          <view wx:else class="qr-placeholder">{{qrCodeError || '二维码暂不可用'}}</view>
        </view>
        <view class="qr-code-text">{{dynamicCode}}</view>
      </view>
      <view wx:if="{{qrCodeError}}" class="qr-error-text">{{qrCodeError}}</view>
      <view class="card-desc">馆内核验演示态字段，校验后动态刷新。</view>
    </view>
  </view>

  <view class="card">
    <view class="headline-row">
      <view class="section-title">MY BOOKINGS · 我的预约</view>
      <view class="card-desc">近 30 天</view>
    </view>
    <view wx:for="{{pageData.myBookings}}" wx:key="id" class="booking-item">
      <view class="booking-date-block">
        <view class="booking-date-day">{{item.dateDay}}</view>
        <view class="booking-date-month">{{item.dateText}}</view>
      </view>
      <view class="booking-main-block">
        <view class="headline-row">
          <view class="booking-title-text">{{item.title}}</view>
          <view class="status-chip">{{item.status}}</view>
        </view>
        <view class="card-desc">{{item.timeRange}}</view>
        <button wx:if="{{item.status === '待到店'}}" class="secondary-button booking-cancel-btn" data-booking-id="{{item.id}}" bindtap="onCancelBooking">取消预约</button>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">STATS · 到店统计</view>
    <view class="profile-stats-grid">
      <view class="stats-item">
        <view class="stats-value">{{pageData.trainingStats.monthLessons}}</view>
        <view class="stats-note">本月场次</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{pageData.trainingStats.streakDays}}</view>
        <view class="stats-note">坚持天数</view>
      </view>
      <view class="stats-item">
        <view class="stats-value">{{pageData.trainingStats.monthLessons + pageData.trainingStats.streakDays}}</view>
        <view class="stats-note">累计活跃</view>
      </view>
    </view>
    <view class="menu-list">
      <view class="menu-item"><text>预约与核销规则</text><text class="menu-arrow">></text></view>
      <view class="menu-item"><text>我的到店趋势</text><text class="menu-arrow">></text></view>
      <view class="menu-item"><text>消息与公告</text><text class="menu-arrow">></text></view>
      <view class="menu-item"><text>帮助与客服</text><text class="menu-arrow">></text></view>
    </view>
  </view>

  <view class="card logout-card">
    <button class="logout-button" bindtap="onLogout">退出登录</button>
  </view>
  </block>

  <app-tabbar id="tabbar" current="/pages/profile/index"></app-tabbar>
</view>
