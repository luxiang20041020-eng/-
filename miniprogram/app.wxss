page {
  min-height: 100vh;
  background: #f5f4ef;
  color: #20251f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(166rpx + env(safe-area-inset-bottom));
  background:
    #f5f4ef;
}

.brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(32, 37, 31, 0.07);
}

.brand-left {
  display: flex;
  align-items: center;
}

.brand-logo,
.avatar-square {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #c7452d;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 28rpx rgba(199, 69, 45, 0.2);
}

.brand-logo {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  font-size: 18rpx;
}

.brand-text {
  display: flex;
  align-items: baseline;
  margin-left: 14rpx;
}

.brand-name {
  font-size: 26rpx;
  color: #20251f;
  font-weight: 600;
}

.brand-demo {
  margin-left: 10rpx;
  font-size: 18rpx;
  color: #7a8497;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.role-strip {
  display: flex;
  gap: 8rpx;
}

.role-chip,
.store-badge,
.status-chip,
.filter-chip,
.outline-chip,
.role-badge,
.info-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 999rpx;
  background: #ffffff;
  color: #73786e;
  font-size: 20rpx;
  font-weight: 600;
}

.filter-chip.active,
.outline-chip.active,
.role-chip.active,
.role-badge,
.info-chip.active,
.status-chip.active {
  border-color: #c7452d;
  background: #c7452d;
  color: #ffffff;
  box-shadow: none;
}

.page-header {
  position: relative;
  padding: 12rpx 4rpx 22rpx;
}

.page-header > .role-badge {
  position: absolute;
  top: 16rpx;
  right: 4rpx;
}

.page-header > view:first-child {
  padding-right: 124rpx;
}

.eyebrow,
.card-title,
.section-title {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: #73786e;
  font-weight: 600;
}

.page-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  line-height: 1.25;
  font-weight: 600;
  color: #20251f;
}

.page-subtitle,
.card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #73786e;
  line-height: 1.55;
}

.headline-row,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.headline-row > view:first-child,
.collapsible-title {
  min-width: 0;
}

.collapsible-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.collapsible-title {
  flex: 1;
}

.collapse-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 50%;
  background: #f7f7f2;
}

.collapse-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #73786e;
  border-bottom: 3rpx solid #73786e;
  transform: rotate(45deg) translate(-2rpx, -2rpx);
  transition: transform 180ms ease;
}

.collapse-chevron.expanded {
  transform: rotate(225deg) translate(-2rpx, -2rpx);
}

.collapsible-summary {
  margin-top: 8rpx;
  color: #7c8076;
  font-size: 21rpx;
  line-height: 1.45;
}

.card {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #e4e5dc;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: none;
}

.section-main-title {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 600;
  color: #20251f;
  line-height: 1.05;
}

.accent-text {
  color: #c7452d;
}

.metric-grid,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.metric-item,
.stats-item {
  min-height: 138rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  background: #f5f5ef;
}

.metric-label,
.stats-label {
  font-size: 23rpx;
  letter-spacing: 0;
  color: #7c8076;
  font-weight: 600;
}

.metric-value,
.stats-value {
  margin-top: 14rpx;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 600;
  color: #20251f;
}

.metric-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #7c8076;
}

.metric-note,
.stats-note {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #c7452d;
  font-weight: 600;
}

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-button {
  background: #c7452d;
  color: #ffffff;
  box-shadow: none;
}

.secondary-button {
  border: 1rpx solid #e1e3d9;
  background: #ffffff;
  color: #20251f;
}

.button-row {
  display: flex;
  gap: 14rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
}

.scroll-row {
  white-space: nowrap;
}

.scroll-chip {
  display: inline-flex;
  margin-right: 12rpx;
}

.empty-text {
  padding: 34rpx 0;
  text-align: center;
  color: #7c8076;
  font-size: 24rpx;
}

.divider-line {
  height: 1rpx;
  margin: 18rpx 0;
  background: #edf0f6;
}

.menu-list {
  margin-top: 18rpx;
  border: 1rpx solid #e9e9e1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid #e9e9e1;
  color: #20251f;
  font-size: 28rpx;
  font-weight: 600;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #979b90;
  font-size: 24rpx;
}

.page-loading {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #ffd9e2;
  border-radius: 24rpx;
  background: #fff5f7;
  color: #c7452d;
  font-size: 22rpx;
  font-weight: 600;
}

.form-input,
.form-textarea,
.readonly-value,
.store-picker {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e1e3d9;
  border-radius: 24rpx;
  background: #f7f7f2;
  color: #20251f;
  font-size: 26rpx;
}

.form-textarea {
  min-height: 160rpx;
}

.form-input {
  max-width: 100%;
  min-width: 0;
  height: 82rpx;
  min-height: 82rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 82rpx;
  overflow: hidden;
}

.input-placeholder,
.coach-search-placeholder {
  color: #979b90;
}

.field-block {
  margin-top: 24rpx;
}

.field-label,
.filter-label {
  font-size: 25rpx;
  line-height: 1.4;
  color: #20251f;
  font-weight: 600;
}

.schedule-title {
  font-size: 30rpx;
  line-height: 1.35;
  color: #20251f;
  font-weight: 600;
}

button[disabled] { opacity: 0.45; }
.primary-button[disabled] { background: #dedfd6; color: #7c8076; }
.tap-feedback { opacity: 0.72; }
.empty-state { padding: 42rpx 16rpx; text-align: center; }
.empty-state-title { color: #343a2e; font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.empty-state-desc { margin-top: 12rpx; color: #7c8076; font-size: 24rpx; line-height: 1.7; }
.empty-state .secondary-button { width: auto; display: inline-block; margin-top: 24rpx; padding: 0 32rpx; }
.inline-link { color: #c7452d; font-size: 24rpx; padding: 12rpx 0; }
.section-heading { color: #20251f; font-size: 32rpx; font-weight: 600; }
.page-caption { color: #7c8076; font-size: 24rpx; line-height: 1.7; margin-top: 12rpx; }
.status-chip { flex-shrink: 0; min-height: 42rpx; padding: 0 12rpx; font-size: 21rpx; box-shadow: none; }
.metric-value { font-variant-numeric: tabular-nums; letter-spacing: -1rpx; word-break: break-word; }
input, textarea { font-weight: 400; }

/* 多语言使用正常行高与弹性居中，较长标签可换行。 */
.locale-page button.primary-button,
.locale-page button.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  white-space: normal;
  overflow-wrap: anywhere;
}
.locale-page .button-row { flex-wrap: wrap; }
.locale-page .button-row button.primary-button,
.locale-page .button-row button.secondary-button { min-width: 0; }
.locale-page .menu-item { gap: 16rpx; }
.locale-page .menu-item > text:first-child { min-width: 0; }
.locale-page .menu-arrow { flex-shrink: 0; max-width: 48%; text-align: right; }
.locale-page .page-title { overflow-wrap: anywhere; }
.locale-page .role-badge { white-space: normal; text-align: center; }
