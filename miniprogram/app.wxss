page {
  background: #121212;
  color: #f5f5f5;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 170rpx;
  background: #121212;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #f8fafc;
}

.page-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a3a3a3;
  line-height: 1.6;
}

.role-badge,
.store-badge,
.status-chip,
.filter-chip,
.outline-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.role-badge,
.filter-chip.active,
.outline-chip.active {
  background: #facc15;
  color: #18181b;
  font-weight: 700;
}

.store-badge,
.status-chip,
.filter-chip,
.outline-chip {
  border: 1rpx solid #343434;
  background: #1b1b1b;
  color: #d4d4d4;
}

.card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #2f2f2f;
  border-radius: 16rpx;
  background: #1a1a1a;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f8fafc;
}

.card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.metric-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.metric-item {
  flex: 1;
  min-width: 180rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #101010;
  border: 1rpx solid #2a2a2a;
}

.metric-label {
  font-size: 24rpx;
  color: #9ca3af;
}

.metric-value {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #facc15;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #f8fafc;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.primary-button {
  width: 100%;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #facc15;
  color: #18181b;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.secondary-button {
  width: 100%;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  background: #202020;
  color: #f8fafc;
  border: 1rpx solid #313131;
  font-size: 28rpx;
  text-align: center;
}

.button-row {
  display: flex;
  gap: 16rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
}

.scroll-row {
  white-space: nowrap;
}

.scroll-chip {
  display: inline-flex;
  margin-right: 16rpx;
}

.empty-text {
  padding: 28rpx 0;
  text-align: center;
  color: #737373;
  font-size: 26rpx;
}
