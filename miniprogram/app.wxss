page {
  background: #030303;
  color: #f5f5f5;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 20rpx 22rpx 170rpx;
  background:
    linear-gradient(180deg, rgba(255, 48, 48, 0.05) 0%, rgba(3, 3, 3, 0) 220rpx),
    #030303;
}

.brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 18rpx 16rpx;
  border: 1rpx solid #232323;
  background: #0a0a0a;
}

.brand-left {
  display: flex;
  align-items: center;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  background: #ff2a2a;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.brand-text {
  display: flex;
  align-items: baseline;
  margin-left: 14rpx;
}

.brand-name {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #ffffff;
  font-weight: 700;
}

.brand-demo {
  margin-left: 10rpx;
  font-size: 18rpx;
  color: #777777;
  letter-spacing: 1rpx;
}

.role-strip {
  display: flex;
  gap: 8rpx;
}

.role-chip {
  min-width: 78rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid #2b2b2b;
  text-align: center;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #9f9f9f;
  background: #111111;
}

.role-chip.active {
  border-color: #ff3434;
  background: #ff3434;
  color: #ffffff;
  font-weight: 700;
}

.page-header {
  padding: 24rpx 0 20rpx;
  border-bottom: 1rpx solid #171717;
}

.eyebrow {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #ff4141;
}

.page-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #ffffff;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #707070;
  line-height: 1.5;
}

.headline-row,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-badge,
.status-chip,
.filter-chip,
.outline-chip,
.role-badge,
.info-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border: 1rpx solid #2f2f2f;
  background: #101010;
  color: #d0d0d0;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.filter-chip.active,
.outline-chip.active,
.role-badge,
.info-chip.active {
  border-color: #ff3434;
  background: #ff3434;
  color: #ffffff;
  font-weight: 700;
}

.card {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #232323;
  background: #070707;
}

.card-title {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #ff3d3d;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #ff3d3d;
}

.card-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8d8d8d;
}

.section-main-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.05;
}

.accent-text {
  color: #ff4040;
}

.metric-grid,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
  margin-top: 18rpx;
  border: 1rpx solid #242424;
}

.metric-item,
.stats-item {
  min-height: 138rpx;
  padding: 20rpx;
  border-right: 1rpx solid #242424;
  border-bottom: 1rpx solid #242424;
  background: linear-gradient(180deg, rgba(255, 41, 41, 0.08) 0%, rgba(8, 8, 8, 0.96) 100%);
}

.metric-item:nth-child(2n),
.stats-item:nth-child(2n) {
  border-right: none;
}

.metric-item:nth-last-child(-n + 2),
.stats-item:nth-last-child(-n + 2) {
  border-bottom: none;
}

.metric-label,
.stats-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7e7e7e;
}

.metric-value,
.stats-value {
  margin-top: 14rpx;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 700;
  color: #ffffff;
}

.metric-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #c4c4c4;
}

.metric-note,
.stats-note {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #ff4444;
}

.primary-button,
.secondary-button {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid #2a2a2a;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.primary-button {
  background: #ff3434;
  border-color: #ff3434;
  color: #ffffff;
  font-weight: 700;
}

.secondary-button {
  background: #111111;
  color: #f3f3f3;
}

.button-row {
  display: flex;
  gap: 14rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
}

.scroll-row {
  white-space: nowrap;
}

.scroll-chip {
  display: inline-flex;
  margin-right: 12rpx;
}

.empty-text {
  padding: 32rpx 0;
  text-align: center;
  color: #777777;
  font-size: 24rpx;
}

.divider-line {
  height: 1rpx;
  margin: 18rpx 0;
  background: #1e1e1e;
}

.avatar-square {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #ff3434;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.menu-list {
  margin-top: 18rpx;
  border: 1rpx solid #242424;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid #242424;
  color: #f4f4f4;
  font-size: 28rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #7a7a7a;
  font-size: 24rpx;
}

.page-loading {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #2a2a2a;
  background: #0b0b0b;
  color: #ff4a4a;
  font-size: 22rpx;
}
