page {
  min-height: 100vh;
  background: #f7f8fb;
  color: #07142f;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  background: none;
  border: none;
  padding: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx 176rpx;
  background:
    linear-gradient(180deg, #ffffff 0%, #f6f7fb 360rpx, #f1f3f8 100%),
    #f6f7fb;
}

.brand-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 42rpx rgba(8, 20, 47, 0.07);
}

.brand-left {
  display: flex;
  align-items: center;
}

.brand-logo,
.avatar-square {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 28rpx;
  background: #ff1f4f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 28rpx rgba(255, 31, 79, 0.2);
}

.brand-logo {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  font-size: 18rpx;
}

.brand-text {
  display: flex;
  align-items: baseline;
  margin-left: 14rpx;
}

.brand-name {
  font-size: 26rpx;
  color: #07142f;
  font-weight: 900;
}

.brand-demo {
  margin-left: 10rpx;
  font-size: 18rpx;
  color: #7a8497;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.role-strip {
  display: flex;
  gap: 8rpx;
}

.role-chip,
.store-badge,
.status-chip,
.filter-chip,
.outline-chip,
.role-badge,
.info-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e7ebf2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #677286;
  font-size: 20rpx;
  font-weight: 800;
}

.filter-chip.active,
.outline-chip.active,
.role-chip.active,
.role-badge,
.info-chip.active,
.status-chip.active {
  border-color: #ff1f4f;
  background: #ff1f4f;
  color: #ffffff;
  box-shadow: 0 14rpx 24rpx rgba(255, 31, 79, 0.18);
}

.page-header {
  position: relative;
  padding: 12rpx 4rpx 22rpx;
}

.page-header > .role-badge {
  position: absolute;
  top: 16rpx;
  right: 4rpx;
}

.page-header > view:first-child {
  padding-right: 124rpx;
}

.eyebrow,
.card-title,
.section-title {
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: #ff1f4f;
  font-weight: 900;
}

.page-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  line-height: 1.08;
  font-weight: 900;
  color: #07142f;
}

.page-subtitle,
.card-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #717b8f;
  line-height: 1.55;
}

.headline-row,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(225, 230, 239, 0.9);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 42rpx rgba(8, 20, 47, 0.06);
}

.section-main-title {
  margin-top: 10rpx;
  font-size: 52rpx;
  font-weight: 900;
  color: #07142f;
  line-height: 1.05;
}

.accent-text {
  color: #ff1f4f;
}

.metric-grid,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.metric-item,
.stats-item {
  min-height: 138rpx;
  padding: 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 26rpx;
  background:
    linear-gradient(135deg, rgba(255, 31, 79, 0.08) 0%, rgba(255, 255, 255, 0.96) 45%),
    #ffffff;
}

.metric-label,
.stats-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #7d8798;
  font-weight: 900;
}

.metric-value,
.stats-value {
  margin-top: 14rpx;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
  color: #07142f;
}

.metric-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #7d8798;
}

.metric-note,
.stats-note {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #ff1f4f;
  font-weight: 800;
}

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 88rpx;
}

.primary-button {
  background: #ff1f4f;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(255, 31, 79, 0.22);
}

.secondary-button {
  border: 1rpx solid #e7ebf2;
  background: #ffffff;
  color: #07142f;
}

.button-row {
  display: flex;
  gap: 14rpx;
}

.button-row .primary-button,
.button-row .secondary-button {
  flex: 1;
}

.scroll-row {
  white-space: nowrap;
}

.scroll-chip {
  display: inline-flex;
  margin-right: 12rpx;
}

.empty-text {
  padding: 34rpx 0;
  text-align: center;
  color: #7d8798;
  font-size: 24rpx;
}

.divider-line {
  height: 1rpx;
  margin: 18rpx 0;
  background: #edf0f6;
}

.menu-list {
  margin-top: 18rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 26rpx;
  overflow: hidden;
  background: #ffffff;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid #eef1f6;
  color: #07142f;
  font-size: 28rpx;
  font-weight: 800;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #a1a9b8;
  font-size: 24rpx;
}

.page-loading {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #ffd9e2;
  border-radius: 24rpx;
  background: #fff5f7;
  color: #ff1f4f;
  font-size: 22rpx;
  font-weight: 900;
}

.form-input,
.form-textarea,
.readonly-value,
.store-picker {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e6eaf2;
  border-radius: 24rpx;
  background: #f8f9fc;
  color: #07142f;
  font-size: 26rpx;
}

.form-textarea {
  min-height: 160rpx;
}

.input-placeholder,
.coach-search-placeholder {
  color: #9aa3b2;
}

.field-block {
  margin-top: 24rpx;
}

.field-label,
.filter-label {
  font-size: 25rpx;
  color: #07142f;
  font-weight: 900;
}

.schedule-title {
  font-size: 30rpx;
  line-height: 1.35;
  color: #07142f;
  font-weight: 900;
}
