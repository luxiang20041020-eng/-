.media-privacy-mask{position:fixed;inset:0;z-index:1000;background:rgba(25,30,24,.45);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.media-privacy-panel{width:100%;max-width:650rpx;border-radius:20rpx;background:#fff;padding:32rpx;box-sizing:border-box}.media-privacy-title{font-size:32rpx;font-weight:600;margin-bottom:20rpx}.media-privacy-text,.media-privacy-link{font-size:26rpx;line-height:1.8;overflow-wrap:anywhere}.media-privacy-link{color:#b3442a;margin:16rpx 0 28rpx}.media-privacy-actions{display:flex;gap:16rpx}.media-privacy-actions button{box-sizing:border-box;flex:1;min-width:0;padding:20rpx 12rpx;margin:0;border-radius:12rpx;border:1rpx solid #e3e4dc;background:#fff;font-size:26rpx;line-height:1.5;white-space:normal;display:flex;align-items:center;justify-content:center;text-align:center}.media-privacy-actions button::after{border:0}.media-privacy-actions .media-privacy-agree{color:#fff;background:#c7452d;border-color:#c7452d}
