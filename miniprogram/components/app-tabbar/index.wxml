<view class="tabbar-wrap">
  <view class="tabbar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{item.path === current ? 'is-active' : ''}}"
      data-path="{{item.path}}"
      bindtap="onTap"
      hover-class="tab-pressed"
      aria-label="{{item.label}}"
      aria-role="button"
    >
      <view class="tab-symbol tab-symbol-{{item.key}}"></view>
      <text class="tab-label">{{item.label}}</text>
    </view>
  </view>
</view>
