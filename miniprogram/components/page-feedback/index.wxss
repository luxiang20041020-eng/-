.feedback-error { display: flex; align-items: center; gap: 20rpx; padding: 24rpx; margin: 16rpx 0; border: 1rpx solid #edd0c9; border-radius: 16rpx; background: #fff5f1; }
.feedback-copy { flex: 1; min-width: 0; }
.feedback-title { color: #932f20; font-size: 25rpx; font-weight: 600; }
.feedback-description { color: #93685e; font-size: 22rpx; line-height: 1.6; margin-top: 6rpx; word-break: break-word; }
.feedback-retry { flex-shrink: 0; margin: 0; padding: 0 22rpx; background: #ffffff; border-radius: 10rpx; font-size: 24rpx; line-height: 70rpx; color: #932f20; }
.feedback-retry::after { border: 1rpx solid #edd0c9; border-radius: 10rpx; }
.feedback-loading { display: flex; gap: 12rpx; align-items: center; padding: 14rpx 0; color: #74776f; font-size: 22rpx; }
.feedback-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #c7452d; }
